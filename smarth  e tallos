(function () {
  'use strict';

  const url = location.href;

  /* =====================================================================================
     ============================== SMARTBUS – COPIAR =====================================
     ===================================================================================== */

  if (url.includes('smartbus.smarttravelit.com')) {

    function isReserva() {
      return document.querySelector('.page-title')?.textContent?.trim() === 'Reserva';
    }

    function normalizarDocumento(texto) {
      if (texto.includes('-')) {
        return texto.split('-').slice(1).join('-').trim();
      }
      return texto.trim();
    }

    function aplicarCliqueCopiar(el, tipo = 'normal') {
      if (!el || el.dataset.copiarAtivo) return;

      let texto = el.textContent?.trim();
      if (!texto) return;

      if (tipo === 'documento') {
        texto = normalizarDocumento(texto);
      }

      el.dataset.copiarAtivo = 'true';

      el.style.border = '1px dashed darkred';
      el.style.padding = '4px 10px';
      el.style.borderRadius = '6px';
      el.style.cursor = 'pointer';
      el.style.transition = 'border-color 0.2s ease, background-color 0.2s ease';
      el.title = 'Clique para copiar';

      el.addEventListener('click', (e) => {
        e.stopPropagation();
        navigator.clipboard.writeText(texto);

        el.style.borderColor = 'green';
        el.style.backgroundColor = '#e6f4ea';

        setTimeout(() => {
          el.style.borderColor = 'darkred';
          el.style.backgroundColor = 'transparent';
        }, 1200);
      });
    }

    function aplicar() {
      if (!isReserva()) return;

      // 🔹 CIDADES
      document
        .querySelectorAll('.col-coupon-service-title b')
        .forEach(el => aplicarCliqueCopiar(el));

      // 🔹 DATAS
      document
        .querySelectorAll('.col-coupon-service b')
        .forEach(b => {
          if (/\d{2}\/\d{2}\/\d{4}/.test(b.textContent)) {
            aplicarCliqueCopiar(b);
          }
        });

      // 🔹 PASSAGEIROS
      const tituloPassageiros = [...document.querySelectorAll('h3, h4')]
        .find(h => h.textContent.trim() === 'Passageiros');

      if (tituloPassageiros) {
        const blocoPassageiros = tituloPassageiros.closest('.card, .card-body, .card-coupon-area');

        blocoPassageiros?.querySelectorAll('tbody tr').forEach(tr => {
          const tds = tr.querySelectorAll('td');
          aplicarCliqueCopiar(tds[1]);               // Passageiro
          aplicarCliqueCopiar(tds[2], 'documento'); // Documento
          aplicarCliqueCopiar(tds[4]);               // Telefone
        });
      }

      // 🔹 EMAIL
      document
        .querySelectorAll('.card-coupon-actions')
        .forEach(card => {
          [...card.querySelectorAll('*')].forEach(el => {
            if (el.textContent?.trim() === 'E-mail') {
              const valorEmail = el.nextElementSibling;
              if (valorEmail) aplicarCliqueCopiar(valorEmail);
            }
          });
        });
    }

    const observerSmart = new MutationObserver(aplicar);
    observerSmart.observe(document.body, { childList: true, subtree: true });
    aplicar();
  }

