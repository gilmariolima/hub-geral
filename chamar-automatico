                data: data == null ? undefined : JSON.stringify(data),
                timeout,
                onload: resolve,
                onerror: err => reject(new Error(`Falha de conexão Tallos: ${err?.error || 'erro de rede'}`)),
                ontimeout: () => reject(new Error('Timeout na Tallos.'))
            });
        });
    }

