    async function enviarTemplate(customerId) {
        const response = await requestSessao({
            method: 'POST',
            url: `${TALLOS_API}/megasac-api/messages/customer/${encodeURIComponent(customerId)}/send`,
            data: templatePayload(),
            timeout: 10000
        });

        if (Number(response.status || 0) !== 201) {
