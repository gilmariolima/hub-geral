    function setEtapaPainel(step, state = 'busy') {
        etapaAtual = Number(step) || etapaAtual;
        const all = Array.from(document.querySelectorAll('#painel-tallos [data-flow-step]'));
        for (const el of all) {
            const n = Number(el.dataset.flowStep || 0);
            let status = 'idle';
            if (n < step) status = 'ok';
            else if (n === step) status = state;
            if (state === 'done' && n <= step) status = 'ok';

            el.dataset.state = status;
            const circle = el.querySelector('.sbv12-step-dot');
            if (circle) {
                circle.textContent =
                    status === 'ok' ? '✓' :
                    status === 'error' ? '!' :
                    String(n);
            }
        }
    }

    function marcarEtapaErro() {
        if (!etapaAtual) return;
        const el = document.querySelector(`#painel-tallos [data-flow-step="${etapaAtual}"]`);
        if (!el) return;
        el.dataset.state = 'error';
        const circle = el.querySelector('.sbv12-step-dot');
        if (circle) circle.textContent = '!';
    }

    function resetEtapasPainel() {
        etapaAtual = 0;
        document.querySelectorAll('#painel-tallos [data-flow-step]').forEach((el, index) => {
            el.dataset.state = 'idle';
            const circle = el.querySelector('.sbv12-step-dot');
            if (circle) circle.textContent = String(index + 1);
        });
    }

    function clamp(value, min, max) {
        return Math.min(Math.max(value, min), max);
    }

    function salvarPosicaoPainel(container) {
        try {
            const rect = container.getBoundingClientRect();
            GM_setValue(KEY_PANEL_POSITION, {
                left: Math.round(rect.left),
                top: Math.round(rect.top)
            });
        } catch {}
    }

    function restaurarPosicaoPainel(container) {
        try {
            const saved = GM_getValue(KEY_PANEL_POSITION, null);
            if (!saved || !Number.isFinite(Number(saved.left)) || !Number.isFinite(Number(saved.top))) return;
            const width = container.offsetWidth || 300;
            const height = container.offsetHeight || 180;
            const left = clamp(Number(saved.left), 6, Math.max(6, window.innerWidth - width - 6));
            const top = clamp(Number(saved.top), 6, Math.max(6, window.innerHeight - Math.min(height, window.innerHeight - 12) - 6));
            container.style.left = `${left}px`;
            container.style.top = `${top}px`;
            container.style.right = 'auto';
            container.style.bottom = 'auto';
        } catch {}
    }

    function instalarPainelMovivel(container, handle) {
        if (!container || !handle) return;

        let dragging = false;
        let pointerId = null;
        let offsetX = 0;
        let offsetY = 0;

        const move = event => {
            if (!dragging || (pointerId != null && event.pointerId !== pointerId)) return;
            const width = container.offsetWidth;
            const height = container.offsetHeight;
            const left = clamp(event.clientX - offsetX, 6, Math.max(6, window.innerWidth - width - 6));
            const top = clamp(event.clientY - offsetY, 6, Math.max(6, window.innerHeight - Math.min(height, window.innerHeight - 12) - 6));
            container.style.left = `${left}px`;
            container.style.top = `${top}px`;
            container.style.right = 'auto';
            container.style.bottom = 'auto';
        };

        const end = event => {
            if (!dragging || (pointerId != null && event.pointerId !== pointerId)) return;
            dragging = false;
            try { handle.releasePointerCapture(pointerId); } catch {}
            handle.style.cursor = 'grab';
            salvarPosicaoPainel(container);
            pointerId = null;
        };

        handle.addEventListener('pointerdown', event => {
            if (event.button !== 0) return;
            if (event.target.closest('button,select,input')) return;

            const rect = container.getBoundingClientRect();
            dragging = true;
            pointerId = event.pointerId;
            offsetX = event.clientX - rect.left;
            offsetY = event.clientY - rect.top;

            container.style.left = `${rect.left}px`;
            container.style.top = `${rect.top}px`;
            container.style.right = 'auto';
            container.style.bottom = 'auto';
            handle.style.cursor = 'grabbing';

            try { handle.setPointerCapture(pointerId); } catch {}
            event.preventDefault();
        });

        handle.addEventListener('pointermove', move);
        handle.addEventListener('pointerup', end);
        handle.addEventListener('pointercancel', end);

        window.addEventListener('resize', () => {
            const rect = container.getBoundingClientRect();
            const left = clamp(rect.left, 6, Math.max(6, window.innerWidth - container.offsetWidth - 6));
            const top = clamp(rect.top, 6, Math.max(6, window.innerHeight - 60));
            container.style.left = `${left}px`;
            container.style.top = `${top}px`;
            container.style.right = 'auto';
            container.style.bottom = 'auto';
            salvarPosicaoPainel(container);
        });
    }

    // Telefone colado pelo operador quando o bilhete não tem telefone.
    // Fica guardado para o envio manual do mesmo localizador.
    let telefoneManualPendente = null;

    // Erro na etapa 2 (/start) = cliente já está com alguém -> fecha a aba.
    // Exceção: erro de sessão da Tallos (login expirado/sem permissão), que precisa de atenção.
    function erroDeSessaoTallos(reason) {
        return /^SESSAO_TALLOS/.test(String(reason || ''));
    }

    // Se uma etapa der erro, tenta mais uma vez a MESMA etapa
    // (não recomeça do zero, para não cair no /start com o atendimento já aberto).
    const DELAY_SEGUNDA_TENTATIVA_MS = 1500;

    async function comSegundaTentativa(etapa, nome, fn, podeRepetir = () => true) {
        try {
            return await fn(false);
        } catch (error) {
            const reason = error?.message || String(error);
            if (erroDeSessaoTallos(reason) || !podeRepetir(reason)) throw error;

            console.warn(`[Tallos V12.7.0] Etapa ${etapa} falhou (${reason}). Segunda tentativa...`);
            setEtapaPainel(etapa, 'busy');
            setButton(`${etapa}/4 • ${nome} (2ª tentativa)...`, true);
            setStatus(`🔁 Erro na etapa ${etapa} (${reason}). Tentando de novo...`, 'busy');
            await sleep(DELAY_SEGUNDA_TENTATIVA_MS);

            return await fn(true);
        }
    }

    // opcoes.auto = true quando chamado pela automação (sem alerta de sucesso).
    // Retorna true se o fluxo terminou com sucesso.
    async function executarCadastroEEnvio(opcoes = {}) {
        const auto = opcoes?.auto === true;
        if (fluxoEmAndamento) return false;

        const selectAgente = document.getElementById('select-agente-tallos');
        const nomeSelecionado = selectAgente?.value || '';
        if (!nomeSelecionado) {
            if (!auto) alert('⚠️ Selecione o operador do turno antes de continuar.');
            return false;
        }

        if (!getSessaoTallos()) {
            if (!auto) alert('⚠️ A Tallos não está com uma sessão conectada.\n\nAbra app.tallos.com.br, faça login e deixe a aba carregada. Depois tente novamente.');
            return false;
        }

        const dados = capturarDados();
        if (!dados) {
            if (!auto) alert('⛔ Não foi possível capturar os dados desta reserva.');
            return false;
        }

        // Envio manual: avisa se não conseguiu ler nome/localizador da tela.
        if (!auto && dados.faltando?.length) {
            const seguir = confirm(
                `⚠️ Não consegui ler da tela: ${dados.faltando.join(' e ')}.\n\n` +
                `Confira se a reserva está aberta. Continuar mesmo assim?`
            );
            if (!seguir) return false;
        }

        if (!dados.telefone) {
            const loc = normalizarLocalizador(dados.localizador);
            if (telefoneManualPendente && telefoneManualPendente.loc === loc) {
                dados.telefone = telefoneManualPendente.telefone;
            } else {
                if (auto) return false;
                const manual = prompt('Telefone não encontrado. Cole abaixo o número do cliente:');
                if (!manual) return false;
                dados.telefone = normalizarTelefoneManual(manual);
            }
        }

        if (!telefoneValido(dados.telefone)) {
            alert('⛔ Telefone inválido. O fluxo foi cancelado antes de acessar a Tallos.');
            return false;
        }

        fluxoEmAndamento = true;
        resetEtapasPainel();
        const tag = gerarTag(nomeSelecionado);

        try {
            setButton('Verificando Tallos...', true);
            setStatus('Confirmando que a aba da Tallos está respondendo...', 'busy');

            if (!(await pingTallos())) {
                throw new Error('ABA_TALLOS_NAO_RESPONDEU (abra ou recarregue app.tallos.com.br)');
            }

            setEtapaPainel(1, 'busy');
            setButton('1/4 • Cadastrando...', true);
            setStatus('Localizando ou atualizando o contato na Tallos...', 'busy');

            const contact = await comSegundaTentativa(
                1, 'Cadastrando',
                () => garantirContato(dados, tag)
            );

            setEtapaPainel(2, 'busy');
            setButton('2/4 • Iniciando atendimento...', true);
            setStatus(`Contato confirmado • ${contact.action}. Iniciando atendimento...`, 'busy');

            await iniciarAtendimento(contact.customerId, contact.phone);

            setEtapaPainel(3, 'busy');
            setButton('3/4 • Enviando template...', true);
            setStatus(`Atendimento confirmado. Enviando template "${TEMPLATE.label}"...`, 'busy');

            // Não repete quando a Tallos já aceitou o envio (HTTP 201) e só a
            // conferência da resposta falhou — evita mandar o template 2x ao cliente.
            await comSegundaTentativa(
                3, 'Enviando template',
                () => enviarTemplate(contact.customerId),
                reason => reason !== 'TEMPLATE_RESPOSTA_NAO_CONFIRMADA'
            );

            setEtapaPainel(4, 'busy');
            setButton('4/4 • Enviando para fila...', true);
            setStatus(`Template confirmado. Transferindo para ${NOME_DEPARTAMENTO}...`, 'busy');

            // Na 2ª tentativa, primeiro confere se a 1ª já colocou na fila.
            const transfer = await comSegundaTentativa(
                4, 'Enviando para fila',
                async segunda => {
                    if (segunda) {
                        const jaNaFila = await confirmarTransferencia(contact.customerId, contact.phone);
                        if (jaNaFila.confirmed) return jaNaFila;
                    }
                    return transferirEConfirmar(contact.customerId, contact.phone);
                }
            );

            setEtapaPainel(4, 'done');
            setStatus(`✅ Fluxo concluído • ${NOME_DEPARTAMENTO} confirmado.`, 'ok');
            setButton('✅ Enviado para fila', false);

            try {
                await navigator.clipboard.writeText(digits(contact.phone).slice(-8));
            } catch {}

            telefoneManualPendente = null;

            if (!auto) {
                alert(
                    `✅ FLUXO CONCLUÍDO\n\n` +
                    `Cliente: ${dados.nome}\n` +
                    `Cadastro: ${contact.action}\n` +
                    `Atendimento: iniciado\n` +
                    `Template: ${TEMPLATE.label} enviado\n` +
                    `Fila: ${transfer.department || NOME_DEPARTAMENTO} confirmada`
                );
            }

            setTimeout(() => setButton('📲 Cadastrar + enviar + fila', false), 1800);
            return true;
        } catch (error) {
            const reason = error?.message || String(error);
            console.error('[Tallos V12.7] Fluxo interrompido:', error);
            marcarEtapaErro();

            // Parou no /start -> cliente já está com alguém -> só fecha a aba.
            if (etapaAtual === 2 && !erroDeSessaoTallos(reason)) {
                const loc = normalizarLocalizador(dados.localizador);
                if (loc) registrarEnvioAutomatico(loc);
                telefoneManualPendente = null;
                setStatus(`👤 Cliente já está com alguém (${reason}). Fechando a aba...`, 'ok');
                setButton('📲 Cadastrar + enviar + fila', false);
                await fecharAba();
                return false;
            }

            setStatus(`⚠️ Fluxo interrompido: ${reason}`, 'error');
            setButton('📲 Tentar novamente', false);

            alert(
                `⚠️ O fluxo foi interrompido com segurança.\n\n` +
                `${reason}\n\n` +
                `O script não avançou para a etapa seguinte sem confirmação.`
            );
            return false;
        } finally {
            fluxoEmAndamento = false;
        }
    }

    // =========================================================
    // STATUS DA ÚLTIMA RESERVA (TELA DE PESQUISA)
    // Lê a tabela de resultados (colunas VENDA e STATUS), escolhe
    // a reserva com a data de venda mais recente e mostra no painel
    // se ela está emitida ou não.
    // =========================================================
    function normalizarTexto(texto) {
        return String(texto || '')
            .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
            .toLowerCase().replace(/\s+/g, ' ').trim();
    }

    function parseDataBR(texto) {
        const m = String(texto || '').match(/(\d{2})\/(\d{2})\/(\d{4})(?:\s+(\d{2}):(\d{2}))?/);
        if (!m) return 0;
        return new Date(+m[3], +m[2] - 1, +m[1], +(m[4] || 0), +(m[5] || 0)).getTime();
    }

    // "Não emitido" e "Não emitido/Cancelado" -> NAO_EMITIDO (envia para a fila)
    // "Emitido"                                -> EMITIDO (só fecha a aba)
    // "Devolvido"                              -> DEVOLVIDO (só fecha a aba)
    // Qualquer outro status                    -> DESCONHECIDO (nenhuma ação automática)
    function classificarStatus(texto) {
        const s = normalizarTexto(texto);
        if (!s) return 'DESCONHECIDO';
        // "Não emitido/Cancelado" contém "emitido", por isso a negação vem primeiro.
        if (/nao emitid/.test(s)) return 'NAO_EMITIDO';
        if (/devolvid/.test(s)) return 'DEVOLVIDO';
        if (/emitid/.test(s)) return 'EMITIDO';
        return 'DESCONHECIDO';
    }

    // Status em que a automação apenas fecha a aba.
    function statusSoFecha(tipo) {
        return tipo === 'EMITIDO' || tipo === 'DEVOLVIDO';
    }

    function normalizarLocalizador(texto) {
        const s = String(texto || '').toUpperCase();
        return (s.match(/[A-Z0-9]{5,10}/) || [''])[0];
    }

    function encontrarTabelaReservas() {
        for (const table of document.querySelectorAll('table')) {
            if (table.closest('#painel-tallos')) continue;
            const headers = [...table.querySelectorAll('thead th, thead td')]
                .map(th => normalizarTexto(th.textContent));
            const idx = nome => headers.findIndex(h => h === nome || h.startsWith(nome));
            const iStatus = idx('status');
            const iVenda = idx('venda');
            const iLoc = idx('localizador');
            if (iStatus >= 0 && iVenda >= 0) return { table, iStatus, iVenda, iLoc };
        }
        return null;
    }

    function analisarUltimaReserva() {
        const info = encontrarTabelaReservas();
        if (!info) return null;

        const linhas = [...info.table.querySelectorAll('tbody tr')]
            .map(tr => ({ tr, tds: tr.querySelectorAll('td') }))
            .filter(({ tds }) => tds.length > Math.max(info.iStatus, info.iVenda));

        if (!linhas.length) return { vazia: true };

        const registros = linhas.map(({ tr, tds }) => ({
            tr,
            data: parseDataBR(tds[info.iVenda].textContent),
            statusTexto: tds[info.iStatus].textContent.replace(/\s+/g, ' ').trim(),
            localizador: info.iLoc >= 0 ? tds[info.iLoc].textContent.trim() : ''
        }));

        let ultima = null;
        for (const reg of registros) {
            if (!ultima || reg.data > ultima.data) ultima = { ...reg };
        }
        ultima.tipo = classificarStatus(ultima.statusTexto);
        ultima.total = linhas.length;
        ultima.registros = registros;
        return ultima;
    }

    // Salva o status da pesquisa para a aba do bilhete consultar depois.
    // Para cada localizador da pesquisa, guarda o status da ÚLTIMA reserva.
    function salvarStatusDaPesquisa(r) {
        if (!r || r.vazia || !Array.isArray(r.registros)) return;
        // Ignora outras telas parecidas (ex.: a de cancelados, com filtros preenchidos).
        if (!telaDePesquisaPadrao().ok) return;
        try {
            const agora = Date.now();
            const store = GM_getValue(KEY_STATUS_RESERVAS, {}) || {};
            for (const key of Object.keys(store)) {
                if (agora - Number(store[key]?.at || 0) > VALIDADE_STATUS_MS) delete store[key];
            }
            const ultimaLoc = normalizarLocalizador(r.localizador);
            for (const reg of r.registros) {
                const loc = normalizarLocalizador(reg.localizador);
                if (!loc) continue;
                store[loc] = {
                    statusProprio: reg.statusTexto,
                    ultimaLoc,
                    ultimaStatus: r.statusTexto,
                    at: agora
                };
            }
            GM_setValue(KEY_STATUS_RESERVAS, store);
        } catch (error) {
            console.error('[Tallos V12.7] Falha ao salvar status da pesquisa:', error);
        }
    }

    let ultimaReservaAssinatura = '';

    function atualizarIndicadorUltimaReserva() {
        const box = document.getElementById('ultima-reserva-tallos');
        if (!box) return;

        const r = analisarUltimaReserva();

        const cores = {
            EMITIDO:      { fg: '#067647', bg: '#ecfdf3', bd: '#abefc6' },
            DEVOLVIDO:    { fg: '#6941c6', bg: '#f4f3ff', bd: '#d9d6fe' },
            NAO_EMITIDO:  { fg: '#b42318', bg: '#fef3f2', bd: '#fecdca' },
            DESCONHECIDO: { fg: '#475467', bg: '#f8fafc', bd: '#eaecf0' }
        };

        // Destaque da linha (reaplicado sempre, caso a tabela seja redesenhada)
        document.querySelectorAll('tr[data-ultima-reserva]').forEach(tr => {
            if (r?.tr !== tr) {
                tr.removeAttribute('data-ultima-reserva');
                tr.style.outline = '';
                tr.style.outlineOffset = '';
            }
        });

        if (r && !r.vazia && r.tr) {
            r.tr.dataset.ultimaReserva = '1';
            r.tr.style.outline = `2px solid ${cores[r.tipo].fg}`;
            r.tr.style.outlineOffset = '-2px';
        }

        const assinatura = !r ? 'none'
            : r.vazia ? 'vazia'
            : `${r.localizador}|${r.statusTexto}|${r.data}|${r.total}`;
        if (assinatura === ultimaReservaAssinatura) return;
        ultimaReservaAssinatura = assinatura;

        salvarStatusDaPesquisa(r);

        if (!r) {
            box.style.display = 'none';
            box.replaceChildren();
            return;
        }

        const tom = r.vazia ? cores.DESCONHECIDO : cores[r.tipo];
        Object.assign(box.style, {
            display: 'block',
            padding: '8px 9px',
            borderRadius: '8px',
            border: `1px solid ${tom.bd}`,
            background: tom.bg,
            color: tom.fg,
            fontSize: '10px',
            lineHeight: '1.4',
            userSelect: 'text',
            overflowWrap: 'anywhere'
        });

        const titulo = document.createElement('b');
        titulo.style.cssText = 'display:block;font-size:12px;margin-bottom:2px';
        const detalhe = document.createElement('span');

        if (r.vazia) {
            titulo.textContent = 'Nenhuma reserva na pesquisa';
            detalhe.textContent = '';
        } else {
            titulo.textContent =
                r.tipo === 'EMITIDO' ? '✅ Última reserva: EMITIDA' :
                r.tipo === 'DEVOLVIDO' ? '↩️ Última reserva: DEVOLVIDA' :
                r.tipo === 'NAO_EMITIDO' ? '⚠️ Última reserva: NÃO EMITIDA' :
                `ℹ️ Última reserva: ${r.statusTexto || 'sem status'}`;

            const venda = r.data
                ? new Date(r.data).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' })
                : 'data não lida';

            detalhe.textContent =
                `${r.localizador || 'Sem localizador'} • venda ${venda} • ${r.statusTexto || 'sem status'}` +
                (r.total > 1 ? ` (mais recente de ${r.total})` : '');
        }

        box.replaceChildren(titulo, detalhe);
    }

    // =========================================================
    // AUTOMAÇÃO NA TELA DO BILHETE
    // Não emitido          -> espera 2s -> envia para a fila -> fecha a aba
    // Emitido / Devolvido  -> fecha a aba
    // Erro no /start       -> cliente já está com alguém -> fecha a aba
    // Sem telefone         -> pede o telefone até alguém colar; envio manual
    // =========================================================
    let autoLocProcessado = '';
    let autoEmExecucao = false;
    let autoBilhete = { loc: '', abertoEm: 0, pedidoId: '' };

    // Botão "ENVIAR E FECHAR": envia não emitidas e fecha a aba.
    function autoAtivo() {
        return GM_getValue(KEY_AUTO_ATIVO, true) !== false;
    }

    // Botão "PESQUISA AUTOMÁTICA": pesquisa o cliente na aba de pesquisa.
    function pesquisaAutoAtiva() {
        return GM_getValue(KEY_PESQUISA_AUTO_ATIVA, true) !== false;
    }

    // Só devolve o localizador quando o bilhete já carregou (nome do passageiro presente).
    function localizadorBilheteAtual() {
        const nome = document.querySelectorAll('.card-coupon-area')[1]
            ?.querySelectorAll('td')[1]?.textContent?.trim();
        if (!nome) return '';
        return normalizarLocalizador(
            document.querySelectorAll('.coupon-summary-value')[1]?.textContent
        );
    }

    // Usa o status da última reserva do cliente, vindo de uma pesquisa
    // feita depois (ou até 2 min antes) da abertura deste bilhete.
    function obterStatusParaBilhete(loc, desde) {
        const store = GM_getValue(KEY_STATUS_RESERVAS, {}) || {};
        const entry = store[loc];
        if (!entry || Number(entry.at || 0) < desde - PESQUISA_RECENTE_MS) return null;
        const statusTexto = entry.ultimaStatus || entry.statusProprio || '';
        return {
            tipo: classificarStatus(statusTexto),
            statusTexto,
            ultimaLoc: entry.ultimaLoc || loc
        };
    }

    // =========================================================
    // PESQUISA AUTOMÁTICA
    // =========================================================
    // Mesma regra do script CADASTRAR: tira acentos (mantém Ç, Ã, Õ)
    // e corta o nome antes do primeiro Ç.
    function termoPesquisaNome(nome) {
        const protegido = String(nome || '')
            .replace(/Ç/g, '\u0001').replace(/ç/g, '\u0002')
            .replace(/Ã/g, '\u0003').replace(/ã/g, '\u0004')
            .replace(/Õ/g, '\u0005').replace(/õ/g, '\u0006')
            .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
            .replace(/\u0001/g, 'Ç').replace(/\u0002/g, 'ç')
            .replace(/\u0003/g, 'Ã').replace(/\u0004/g, 'ã')
            .replace(/\u0005/g, 'Õ').replace(/\u0006/g, 'õ');
        const corte = protegido.search(/[Çç]/);
        return (corte !== -1 ? protegido.substring(0, corte) : protegido)
            .replace(/\s+/g, ' ').trim();
    }

    function lerPedidosPesquisa() {
        const agora = Date.now();
        const lista = GM_getValue(KEY_PESQUISA_PEDIDOS, []);
        return (Array.isArray(lista) ? lista : [])
            .filter(p => p?.id && agora - Number(p.at || 0) < PEDIDO_PESQUISA_VALIDADE_MS);
    }

    function salvarPedidosPesquisa(lista) {
        GM_setValue(KEY_PESQUISA_PEDIDOS, lista);
    }

    function atualizarPedidoPesquisa(id, patch) {
        salvarPedidosPesquisa(lerPedidosPesquisa().map(p => p.id === id ? { ...p, ...patch } : p));
    }

    function removerPedidoPesquisa(id) {
        salvarPedidosPesquisa(lerPedidosPesquisa().filter(p => p.id !== id));
    }

    function criarPedidoPesquisa(loc, nome) {
        const pedido = {
            id: criarIdPonteCadastro(),
            loc,
            termo: termoPesquisaNome(nome),
            at: Date.now(),
            state: 'PENDING'
        };
        const lista = lerPedidosPesquisa().filter(p => p.loc !== loc);
        lista.push(pedido);
        salvarPedidosPesquisa(lista);
        return pedido;
    }

    function botaoPesquisar() {
        return [...document.querySelectorAll('button.btn.btn-blue, .btn.btn-blue')]
            .find(b => !b.closest('#painel-tallos') && /pesquisar/i.test(b.textContent || ''));
    }

    // Área do formulário: menor bloco que contém o rótulo "Nome do passageiro" e o botão Pesquisar.
    function raizFormularioPesquisa() {
        const btn = botaoPesquisar();
        if (!btn) return null;
        const alvo = 'nome do passageiro';
        const label = [...document.querySelectorAll('label, span, div, p')]
            .find(el =>
                !el.closest('#painel-tallos') &&
                el.children.length <= 2 &&
                rotuloLimpo(el.textContent) === alvo
            );
        if (!label) return null;
        let node = label.parentElement;
        while (node && !node.contains(btn)) node = node.parentElement;
        return node;
    }

    function rotuloLimpo(texto) {
        return normalizarTexto(texto).replace(/\*/g, '').replace(/\s+/g, ' ').trim();
    }

    function encontrarCampoPorRotulo(raiz, rotulo) {
        const alvo = rotuloLimpo(rotulo);
        const rotulos = [...raiz.querySelectorAll('label, span, div, p')]
            .filter(el => el.children.length <= 2 && rotuloLimpo(el.textContent) === alvo);

        for (const label of rotulos) {
            const textoLabel = normalizarTexto(label.textContent);
            let node = label.parentElement;
            for (let i = 0; i < 4 && node && node !== raiz; i++, node = node.parentElement) {
                const total = normalizarTexto(node.textContent);
                if (node.querySelector('input, select') || total.length > textoLabel.length + 1) {
                    return { label, container: node };
                }
            }
        }
        return null;
    }

    function limparValor(texto) {
        return normalizarTexto(texto).replace(/[^a-z0-9\/ ]/g, ' ').replace(/\s+/g, ' ').trim();
    }

    function valorDoCampoSelecao(campo) {
        const c = campo.container;

        // <select> nativo: usa a opção selecionada (não o texto de todas as opções).
        const select = c.querySelector('select');
        if (select) return limparValor(select.options[select.selectedIndex]?.text || '');

        // ng-select / componentes parecidos: procura o elemento que mostra o valor.
        const candidatos = c.querySelectorAll(
            '.ng-value-label, .ng-value, .ng-placeholder, [class*="selected" i], [class*="single-value" i], [class*="value" i]'
        );
        for (const el of candidatos) {
            if (el.tagName === 'INPUT' || el.contains(campo.label)) continue;
            const v = limparValor(el.textContent);
            if (v && v.length < 40) return v;
        }

        // Último recurso: texto do bloco sem o rótulo.
        return limparValor(c.textContent).replace(limparValor(campo.label.textContent), '').trim();
    }

    function valorEhTodos(valor) {
        return /^tod[ao]s$/.test(String(valor || '').replace(/\s+/g, ''));
    }

    // Inputs da página (sem os do painel). Índices confirmados na tela de pesquisa:
    // 13 a 16 = datas (00/00/0000) • 17 = nome do passageiro
    const INDICES_DATAS_PESQUISA = [13, 14, 15, 16];
    const INDICE_NOME_PESQUISA = 17;

    function inputsDaPagina() {
        return [...document.querySelectorAll('input')].filter(el => !el.closest('#painel-tallos'));
    }

    function inputNomePassageiro() {
        return inputsDaPagina()[INDICE_NOME_PESQUISA] || null;
    }

    // Tela válida para a pesquisa automática:
    // título "Pesquisa de bilhetes", datas 13-16 em 00/00/0000 (ou vazias)
    // e nenhum filtro select2 com "Cancelado" (isso exclui a tela dos cancelados).
    function telaDePesquisaPadrao() {
        const titulo = normalizarTexto(document.querySelector('.page-title')?.textContent);
        if (!titulo.includes('pesquisa de bilhetes')) {
            return { ok: false, ehPesquisa: false, motivo: `Título: "${titulo || 'sem .page-title'}"` };
        }

        const inputs = inputsDaPagina();
        if (inputs.length <= INDICE_NOME_PESQUISA) {
            return { ok: false, ehPesquisa: true, motivo: `Só ${inputs.length} inputs na página (esperado 18+)` };
        }

        for (const i of INDICES_DATAS_PESQUISA) {
            const valor = String(inputs[i]?.value || '');
            if (/[1-9]/.test(valor)) {
                return { ok: false, ehPesquisa: true, motivo: `Data (input ${i}) preenchida: ${valor}` };
            }
        }

        const filtros = [...document.querySelectorAll('.select2-selection.select2-selection--single')]
            .filter(el => !el.closest('#painel-tallos'));
        const cancelado = filtros.find(el => /cancelad/.test(normalizarTexto(el.textContent)));
        if (cancelado) {
            return { ok: false, ehPesquisa: true, motivo: 'Filtro com CANCELADO (tela dos cancelados)' };
        }

        if (!botaoPesquisar()) {
            return { ok: false, ehPesquisa: true, motivo: 'Botão PESQUISAR (.btn.btn-blue) não encontrado' };
        }

        return { ok: true, ehPesquisa: true };
    }

    // Mostra no painel da aba de pesquisa por que ela está (ou não) pronta.
    function atualizarDiagnosticoPesquisa() {
        const box = document.getElementById('diag-pesquisa-tallos');
        if (!box) return;
        let tela;
        try { tela = telaDePesquisaPadrao(); }
        catch (error) { tela = { ok: false, ehPesquisa: true, motivo: `Erro: ${error?.message || error}` }; }

        if (!tela.ehPesquisa) {
            box.style.display = 'none';
            return;
        }
        box.style.display = 'block';
        box.textContent = tela.ok
            ? '🔎 Tela de pesquisa pronta para a pesquisa automática.'
            : `🔎 Tela de pesquisa NÃO reconhecida: ${tela.motivo}`;
        box.style.color = tela.ok ? '#067647' : '#b42318';
        box.style.background = tela.ok ? '#ecfdf3' : '#fef3f2';
        box.style.borderColor = tela.ok ? '#abefc6' : '#fecdca';
    }

    function preencherInput(input, valor) {
        input.focus();
        const setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value')?.set;
        if (setter) setter.call(input, valor);
        else input.value = valor;
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.dispatchEvent(new Event('change', { bubbles: true }));
        input.dispatchEvent(new Event('blur', { bubbles: true }));
    }

    let pesquisaEmAndamento = false;

    // Roda em todas as abas, mas só age na tela de pesquisa padrão.
    async function processarPedidosDePesquisa() {
        if (pesquisaEmAndamento || !pesquisaAutoAtiva()) return;

        const pedido = lerPedidosPesquisa().find(p => p.state === 'PENDING');
        if (!pedido) return;

        const tela = telaDePesquisaPadrao();
        if (!tela.ok) return;

        // Reserva o pedido para esta aba (evita duas abas pesquisando o mesmo).
        atualizarPedidoPesquisa(pedido.id, { state: 'SEARCHING', tab: ID_DESTA_ABA, claimedAt: Date.now() });
        await sleep(250);
        if (lerPedidosPesquisa().find(p => p.id === pedido.id)?.tab !== ID_DESTA_ABA) return;

        pesquisaEmAndamento = true;
        try {
            const input = inputNomePassageiro();
            const btn = botaoPesquisar();
            if (!input || !btn || !pedido.termo) {
                atualizarPedidoPesquisa(pedido.id, { state: 'FAILED', motivo: 'CAMPO_OU_BOTAO_NAO_ENCONTRADO' });
                return;
            }

            preencherInput(input, pedido.termo);
            await sleep(300);
            btn.click();

            const inicio = Date.now();
            await sleep(1500);

            while (Date.now() - inicio < TIMEOUT_RESULTADO_PESQUISA_MS) {
                const r = analisarUltimaReserva();
                const achou = r && !r.vazia && r.registros?.some(reg =>
                    normalizarLocalizador(reg.localizador) === pedido.loc
                );
                if (achou) {
                    salvarStatusDaPesquisa(r);
                    removerPedidoPesquisa(pedido.id);
                    return;
                }
                await sleep(500);
            }

            atualizarPedidoPesquisa(pedido.id, { state: 'FAILED', motivo: 'LOCALIZADOR_NAO_APARECEU_NA_PESQUISA' });
        } catch (error) {
            console.error('[Tallos V12.7] Pesquisa automática:', error);
            atualizarPedidoPesquisa(pedido.id, { state: 'FAILED', motivo: String(error?.message || error) });
        } finally {
            pesquisaEmAndamento = false;
        }
    }

    function jaEnviadoAutomaticamente(loc) {
        const store = GM_getValue(KEY_AUTO_PROCESSADOS, {}) || {};
        const item = store[loc];
        return Boolean(item && Date.now() - Number(item.at || 0) < VALIDADE_STATUS_MS);
    }

    function registrarEnvioAutomatico(loc) {
        const agora = Date.now();
        const store = GM_getValue(KEY_AUTO_PROCESSADOS, {}) || {};
        for (const key of Object.keys(store)) {
            if (agora - Number(store[key]?.at || 0) > VALIDADE_STATUS_MS) delete store[key];
        }
        store[loc] = { at: agora };
        GM_setValue(KEY_AUTO_PROCESSADOS, store);
    }

    async function fecharAba() {
        await sleep(700);
        try { window.close(); } catch {}
        await sleep(800);
        // Se chegou aqui, o navegador não deixou fechar.
        setStatus('Não consegui fechar a aba automaticamente. Feche com Ctrl+W.', 'error');
    }

    // Repete o pedido até alguém colar um telefone válido.
    async function pedirTelefoneAteColar() {
        while (true) {
            // Abas em segundo plano não mostram o prompt; espera a aba ficar visível.
            while (document.hidden) await sleep(500);

            const valor = prompt(
                '⚠️ Telefone não encontrado neste bilhete.\n\n' +
                'Cole o número do cliente. Depois clique em "Cadastrar + enviar + fila" para enviar manualmente.'
            );
            if (valor) {
                const numero = normalizarTelefoneManual(valor);
                if (telefoneValido(numero)) return numero;
                alert('⛔ Telefone inválido. Cole novamente.');
            }
            await sleep(400);
        }
    }

    async function verificarAutomacaoBilhete() {
        if ((!autoAtivo() && !pesquisaAutoAtiva()) || autoEmExecucao || fluxoEmAndamento) return;

        const loc = localizadorBilheteAtual();
        if (!loc || loc === autoLocProcessado) return;

        // Bilhete novo nesta aba: pede a pesquisa automática do cliente.
        if (autoBilhete.loc !== loc) {
            if (pesquisaAutoAtiva()) {
                const nome = capturarDados()?.nome || '';
                const pedido = criarPedidoPesquisa(loc, nome);
                autoBilhete = { loc, abertoEm: Date.now(), pedidoId: pedido.id };
                setStatus(`🔎 Pesquisando "${pedido.termo}" na tela de pesquisa...`, 'busy');
            } else {
                autoBilhete = { loc, abertoEm: Date.now(), pedidoId: '' };
                setStatus('Pesquisa automática desligada. Pesquise o cliente manualmente.', 'normal');
            }
        }

        const decisao = obterStatusParaBilhete(loc, autoBilhete.abertoEm);
        if (!decisao) {
            const pedido = lerPedidosPesquisa().find(p => p.id === autoBilhete.pedidoId);
            const esperando = Date.now() - autoBilhete.abertoEm;

            if (!pesquisaAutoAtiva()) {
                // Sem pesquisa automática: espera uma pesquisa manual.
            } else if (pedido?.state === 'FAILED') {
                setStatus(`⚠️ A pesquisa automática não encontrou este localizador (${pedido.motivo || 'sem motivo'}). Pesquise manualmente ou envie manualmente.`, 'error');
            } else if (!pedido && esperando < PEDIDO_PESQUISA_VALIDADE_MS) {
                // Pedido perdido (várias abas gravando ao mesmo tempo): recria.
                const novo = criarPedidoPesquisa(loc, capturarDados()?.nome || '');
                autoBilhete.pedidoId = novo.id;
            } else if (esperando > 15000) {
                setStatus('⏳ Aguardando a tela "Pesquisa de bilhetes" (aberta, sem filtro Cancelado e com datas 00/00/0000).', 'busy');
            }
            // Continua verificando: uma pesquisa manual também resolve.
            return;
        }

        // Modo teste: só mostra o resultado, sem enviar nem fechar.
        if (!autoAtivo()) {
            autoLocProcessado = loc;
            setStatus(
                `🧪 Última reserva (${decisao.ultimaLoc}): "${decisao.statusTexto || 'sem status'}" → ` +
                (decisao.tipo === 'NAO_EMITIDO' ? 'enviaria para a fila e fecharia a aba.'
                    : statusSoFecha(decisao.tipo) ? 'fecharia a aba.'
                    : 'nenhuma ação.') +
                ' (ENVIAR E FECHAR desligado)',
                'normal'
            );
            return;
        }

        autoEmExecucao = true;
        try {
            if (statusSoFecha(decisao.tipo)) {
                autoLocProcessado = loc;
                const rotulo = decisao.tipo === 'DEVOLVIDO' ? 'devolvida' : 'emitida';
                setStatus(`✅ Última reserva (${decisao.ultimaLoc}) ${rotulo}. Fechando a aba...`, 'ok');
                await fecharAba();
                return;
            }

            if (decisao.tipo !== 'NAO_EMITIDO') {
                autoLocProcessado = loc;
                setStatus(`ℹ️ Última reserva com status "${decisao.statusTexto || 'sem status'}". Nenhuma ação automática.`, 'normal');
                return;
            }

            if (jaEnviadoAutomaticamente(loc)) {
                autoLocProcessado = loc;
                setStatus('Este localizador já foi enviado para a fila automaticamente. Nada foi feito.', 'normal');
                return;
            }

            // Requisitos: tenta de novo a cada segundo até serem atendidos.
            if (!document.getElementById('select-agente-tallos')?.value) {
                setStatus('⚠️ Não emitida. Selecione o operador do turno para o envio automático.', 'error');
                return;
            }
            if (!tallosConectada()) {
                setStatus('⚠️ Não emitida. Abra a Tallos logada para o envio automático.', 'error');
                return;
            }

            const dados = capturarDados();
            if (!dados) return;

            autoLocProcessado = loc;

            if (!telefoneValido(dados.telefone)) {
                setStatus('⚠️ Não emitida, mas o bilhete está sem telefone. Cole o número e envie manualmente.', 'error');
                const telefone = await pedirTelefoneAteColar();
                telefoneManualPendente = { loc, telefone };
                setStatus(`Telefone ${telefone} recebido. Clique em "Cadastrar + enviar + fila" para enviar.`, 'busy');
                return;
            }

            setStatus('⚠️ Última reserva NÃO emitida. Enviando para a fila em 2 segundos...', 'busy');
            await sleep(DELAY_ANTES_DE_ENVIAR_MS);

            if (!autoAtivo() || localizadorBilheteAtual() !== loc) {
                setStatus('Envio automático cancelado (automático desligado ou a tela mudou).', 'normal');
                return;
            }

            // Se parar no /start, o próprio executarCadastroEEnvio fecha a aba.
            const ok = await executarCadastroEEnvio({ auto: true });
            if (ok) {
                registrarEnvioAutomatico(loc);
                setStatus('✅ Enviado para a fila. Fechando a aba...', 'ok');
                await fecharAba();
            }
        } catch (error) {
            console.error('[Tallos V12.7] Automação:', error);
            setStatus(`⚠️ Automação interrompida: ${error?.message || error}`, 'error');
        } finally {
            autoEmExecucao = false;
        }
    }

    // =========================================================
    // AGENTES — LISTA FIXA + PRÉ-SELEÇÃO DO OPERADOR LOGADO
    // =========================================================
    let preSelecaoFeita = false;
    let preSelecaoEmAndamento = false;

    function encontrarAgente(nome) {
        const alvo = normalizarTexto(nome);
        if (!alvo) return '';
        // Igual ao nome da lista, ou nome da Tallos começando por ele
        // (ex.: "Gilmário Lima Souza" -> "Gilmario Lima").
        return AGENTES.find(agente => {
            const a = normalizarTexto(agente);
            return alvo === a || alvo.startsWith(a + ' ');
        }) || '';
    }

    function preencherSelectAgentes(select) {
        const salvo = String(GM_getValue(KEY_AGENT_SELECTED, '') || '');

        select.innerHTML = '';

        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = 'Selecione o Agente...';
        select.appendChild(placeholder);

        for (const nome of AGENTES) {
            const option = document.createElement('option');
            option.value = nome;
            option.textContent = nome;
            select.appendChild(option);
        }

        // Seleção antiga que não está mais na lista é descartada.
        select.value = AGENTES.includes(salvo) ? salvo : '';
        if (!select.value && salvo) GM_setValue(KEY_AGENT_SELECTED, '');
    }

    async function preSelecionarOperadorLogado(select) {
        if (preSelecaoFeita || preSelecaoEmAndamento || !select || select.value) return;
        if (!tallosConectada()) return;

        preSelecaoEmAndamento = true;
        try {
            const nome = await obterNomeOperadorTallos();
            const agente = encontrarAgente(nome);
            if (agente && !select.value) {
                select.value = agente;
                GM_setValue(KEY_AGENT_SELECTED, agente);
            }
        } catch (error) {
            console.warn('[Tallos V12.7.0] Pré-seleção do operador:', error);
        } finally {
            preSelecaoFeita = true;
            preSelecaoEmAndamento = false;
        }
    }

