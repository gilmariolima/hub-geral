            <div class="sbv12-head">
                <div class="sbv12-brand">
                    <div class="sbv12-logo">T</div>
                    <div class="sbv12-title">
                        <b>SMART BUS → TALLOS</b>
                        <span>V12.7 • pesquisa + automático • fila</span>
                    </div>
                </div>
                <button class="sbv12-collapse" type="button" title="Minimizar painel">${container.dataset.collapsed === '1' ? '+' : '−'}</button>
            </div>
            <div class="sbv12-body">
                <div class="sbv12-connection" id="status-sessao-tallos-v11">
                    <span class="sbv12-dot"></span>
                    <span class="sbv12-connection-text">Verificando Tallos...</span>
                </div>

                <div id="ultima-reserva-tallos" style="display:none"></div>

                <div id="diag-pesquisa-tallos" style="display:none;padding:7px 9px;border:1px solid #eaecf0;border-radius:8px;font-size:10px;font-weight:700;line-height:1.35;user-select:text;overflow-wrap:anywhere"></div>

                <div class="sbv12-toggles">
                    <button type="button" class="sbv12-toggle" id="toggle-pesquisa-tallos"
                        title="Ao abrir o bilhete, pesquisa o cliente na aba Pesquisa de bilhetes"></button>
                    <button type="button" class="sbv12-toggle" id="toggle-auto-tallos"
                        title="Não emitida: envia para a fila e fecha a aba • Emitida/Devolvida: fecha a aba • Cliente já com alguém: fecha a aba"></button>
                </div>

                <div>
                    <label for="select-agente-tallos">Operador do turno</label>
                    <select id="select-agente-tallos"></select>
                </div>

                <div class="sbv12-steps" aria-label="Etapas do envio">
                    <div class="sbv12-step" data-flow-step="1" data-state="idle">
                        <span class="sbv12-step-dot">1</span><span class="sbv12-step-name">Cadastro</span>
                    </div>
                    <div class="sbv12-step" data-flow-step="2" data-state="idle">
                        <span class="sbv12-step-dot">2</span><span class="sbv12-step-name">/start</span>
                    </div>
                    <div class="sbv12-step" data-flow-step="3" data-state="idle">
                        <span class="sbv12-step-dot">3</span><span class="sbv12-step-name">Template</span>
                    </div>
                    <div class="sbv12-step" data-flow-step="4" data-state="idle">
                        <span class="sbv12-step-dot">4</span><span class="sbv12-step-name">Fila</span>
                    </div>
                </div>

                <div id="status-tallos-v11">Aguardando envio.</div>
                <button id="btn-tallos-integracao" type="button">📲 Cadastrar + enviar + fila</button>
                <div class="sbv12-foot">Arraste pelo cabeçalho para mover • posição salva automaticamente</div>
            </div>
        `;

        document.body.appendChild(container);

        const select = container.querySelector('#select-agente-tallos');
        preencherSelectAgentes(select);

        select.addEventListener('change', () => {
            GM_setValue(KEY_AGENT_SELECTED, select.value || '');
        });

        select.addEventListener('keydown', event => {
            if (event.key === 'Enter') {
                event.preventDefault();
                executarCadastroEEnvio();
            }
        });

        const btn = container.querySelector('#btn-tallos-integracao');
        btn.addEventListener('click', () => executarCadastroEEnvio());

        const togglePesquisa = container.querySelector('#toggle-pesquisa-tallos');
        const toggleAuto = container.querySelector('#toggle-auto-tallos');

        // Os botões valem para todas as abas (o estado fica salvo no Tampermonkey).
        const pintarToggles = () => {
            const pesquisa = pesquisaAutoAtiva();
            const auto = autoAtivo();
            togglePesquisa.dataset.on = pesquisa ? '1' : '0';
            togglePesquisa.textContent = `🔎 PESQUISA AUTO: ${pesquisa ? 'LIGADA' : 'DESLIGADA'}`;
            toggleAuto.dataset.on = auto ? '1' : '0';
            toggleAuto.textContent = `🚀 ENVIAR E FECHAR: ${auto ? 'LIGADO' : 'DESLIGADO'}`;
        };

        togglePesquisa.addEventListener('click', () => {
            const novo = !pesquisaAutoAtiva();
            GM_setValue(KEY_PESQUISA_AUTO_ATIVA, novo);
            pintarToggles();
            setStatus(novo ? 'Pesquisa automática ligada.' : 'Pesquisa automática desligada.', 'normal');
        });

        toggleAuto.addEventListener('click', () => {
            const novo = !autoAtivo();
            GM_setValue(KEY_AUTO_ATIVO, novo);
            pintarToggles();
            setStatus(novo ? 'Enviar e fechar ligado.' : 'Enviar e fechar desligado (modo teste: só mostra o resultado).', 'normal');
        });

        pintarToggles();
        setInterval(pintarToggles, 2000);

        const collapse = container.querySelector('.sbv12-collapse');
        collapse.addEventListener('click', event => {
            event.stopPropagation();
            const next = container.dataset.collapsed === '1' ? '0' : '1';
            container.dataset.collapsed = next;
            GM_setValue(KEY_PANEL_COLLAPSED, next === '1');
            collapse.textContent = next === '1' ? '+' : '−';
            collapse.title = next === '1' ? 'Expandir painel' : 'Minimizar painel';
            requestAnimationFrame(() => salvarPosicaoPainel(container));
        });

        instalarPainelMovivel(container, container.querySelector('.sbv12-head'));
        requestAnimationFrame(() => restaurarPosicaoPainel(container));

        const refresh = () => {
            const connection = container.querySelector('#status-sessao-tallos-v11');
            const textNode = connection.querySelector('.sbv12-connection-text');
            const ready = tallosConectada();
            connection.dataset.ready = ready ? '1' : '0';
            textNode.textContent = ready
                ? 'Tallos conectada e autenticada'
                : 'Abra a Tallos e mantenha a sessão ativa';

            // Se ninguém estiver selecionado, tenta marcar quem está logado na Tallos.
            if (ready) preSelecionarOperadorLogado(select);
        };

        resetEtapasPainel();
        refresh();
        setInterval(refresh, 2000);

        // Indicador de status da última reserva na tela de pesquisa.
        atualizarIndicadorUltimaReserva();
        setInterval(atualizarIndicadorUltimaReserva, 1000);

        // Automação na tela do bilhete.
        setInterval(verificarAutomacaoBilhete, 1000);

        // Pesquisa automática (só age na tela "Pesquisa de bilhetes" padrão).
        setInterval(processarPedidosDePesquisa, 700);

        atualizarDiagnosticoPesquisa();
        setInterval(atualizarDiagnosticoPesquisa, 2000);
    }

    // =========================================================
    // BOOT
    // =========================================================
    if (location.hostname === TALLOS_HOST) {
        iniciarPonteTallos();
        return;
    }

    if (location.hostname === SMARTBUS_HOST) {
        try { unsafeWindow.__tallosTestarTokenSessao = testarTokenSessaoContatos; } catch {}

        const boot = () => {
            if (document.body) criarInterface();
            else setTimeout(boot, 250);
        };
        setTimeout(boot, 1200);
    }
})();
