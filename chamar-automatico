    async function requestSessao(options) {
        const session = getSessaoTallos();
        if (!session) throw new Error('SESSAO_TALLOS_INDISPONIVEL');

        const response = await requestTallos({ ...options, token: session.token });
        const status = Number(response?.status || 0);

        if (status === 401) {
            // Sessão vencida: descarta para a aba da Tallos capturar uma nova.
            GM_setValue(KEY_TALLOS_SESSION, null);
            throw new Error('SESSAO_TALLOS_EXPIRADA_HTTP_401 (recarregue a aba da Tallos)');
        }
        if (status === 403) {
            throw new Error('SESSAO_TALLOS_SEM_PERMISSAO_HTTP_403');
        }
        return response;
    }

