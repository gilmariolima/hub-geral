        GM_addValueChangeListener(KEY_TALLOS_CREATE_REQUEST, (name, oldValue, newValue) => {
            if (newValue?.state === 'PENDING') processarPonteCadastroNovo();
        });
        GM_addValueChangeListener(KEY_TALLOS_PING, () => heartbeat());

        // Varredura de reserva, caso algum evento se perca.
        processarPonteCadastroNovo();
        setInterval(processarPonteCadastroNovo, 2000);

        console.info('[Tallos V12.6.1] Ponte de sessão + cadastro interno autenticado ativa.');
    }

