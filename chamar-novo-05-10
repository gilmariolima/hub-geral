    function gerarTag(nomeAgente) {
        const meses = ['janeiro','fevereiro','marco','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro'];
        const mesAtual = meses[new Date().getMonth()];
        return nomeAgente.normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .toLowerCase()
            .replace(/\s+/g, '_') + '.' + mesAtual;
    }

    function validarCPF(cpfStr) {
        let cpf = digits(cpfStr);
        if (cpf.length !== 11 || /^(\d)\1{10}$/.test(cpf)) return false;
        let sum = 0, rest;
        for (let i = 1; i <= 9; i++) sum += parseInt(cpf.substring(i-1, i)) * (11 - i);
        rest = (sum * 10) % 11;
        if (rest === 10 || rest === 11) rest = 0;
        if (rest !== parseInt(cpf.substring(9, 10))) return false;
        sum = 0;
        for (let i = 1; i <= 10; i++) sum += parseInt(cpf.substring(i-1, i)) * (12 - i);
        rest = (sum * 10) % 11;
        if (rest === 10 || rest === 11) rest = 0;
        return rest === parseInt(cpf.substring(10, 11));
    }

    // Procura o CPF só nos cartões do cupom (passageiro primeiro), nunca no
    // bloco do emissor. Prioriza o número rotulado como "CPF" e ignora o telefone.
    function capturarCPF(telefone) {
        const telNacional = digits(telefone).replace(/^55(?=\d{10,11}$)/, '');
        const areas = Array.from(document.querySelectorAll('.card-coupon-area'));
        const passageiro = areas[1];
        const ordem = passageiro ? [passageiro, ...areas.filter(a => a !== passageiro)] : areas;

        for (const area of ordem) {
            const rotulado = (area.innerText || '').match(/CPF[^\d]{0,20}(\d{3}\.?\d{3}\.?\d{3}-?\d{2})/i);
            if (rotulado && validarCPF(rotulado[1])) return digits(rotulado[1]);
        }

        for (const area of ordem) {
            const possiveis = (area.innerText || '').match(/\b\d{11}\b|\b\d{3}\.\d{3}\.\d{3}-\d{2}\b/g) || [];
            for (const candidato of possiveis) {
                const d = digits(candidato);
                if (d === telNacional) continue;
                if (validarCPF(d)) return d;
            }
        }

        return ''; // sem CPF é melhor do que CPF de outra pessoa
    }

    function capturarDados() {
        try {
            const nomeRaw = document.querySelectorAll('.card-coupon-area')[1]?.querySelectorAll('td')[1]?.textContent;
            const nome = nomeRaw
                ? nomeRaw.trim().toLowerCase().replace(/(?:^|\s)\S/g, a => a.toUpperCase())
                : 'Passageiro';

            const locRaw = document.querySelectorAll('.coupon-summary-value')[1]?.textContent;
            const localizador = locRaw ? locRaw.trim() : 'Desconhecido';

            let telBruto = document.querySelectorAll('.card-coupon-area')[1]?.querySelectorAll('td')[4]?.textContent;
            if (
                document.querySelectorAll('.coupon-issuer-info').length === 2 &&
                document.querySelectorAll('.coupon-issuer-info')[1].querySelectorAll('label')[4]?.textContent === 'Telefone'
            ) {
                telBruto = document.querySelectorAll('.coupon-issuer-info')[1].querySelectorAll('.lbl-value')[2]?.textContent || telBruto;
            }

            let telefone = digits(telBruto);
            if (telefone.length === 10 || telefone.length === 11) telefone = '55' + telefone;

            const cpf = capturarCPF(telefone);

            const faltando = [];
            if (!nomeRaw || !nomeRaw.trim()) faltando.push('nome');
            if (!locRaw || !locRaw.trim()) faltando.push('localizador');

            return { nome, telefone, cpf, localizador, faltando };
        } catch (error) {
            console.error('[Tallos V12] Captura:', error);
            return null;
        }
    }

    function normalizarTelefoneManual(value) {
        let number = digits(value);
        if (!number.startsWith('55') && (number.length === 10 || number.length === 11)) number = '55' + number;
        return number;
    }

    function telefoneValido(value) {
        const d = digits(value);
        return d.length >= 10 && d.length <= 13;
    }

    function variantesTelefone(phone) {
        const number = digits(phone);
        if (!telefoneValido(number)) return [];
        const variants = [number];
        let national = number;

        if (number.startsWith('55') && (number.length === 12 || number.length === 13)) {
            national = number.slice(2);
        }
        if (national.length === 10 || national.length === 11) {
            variants.push(national, '55' + national);
            if (national.length === 11 && national[2] === '9') {
                const semNove = national.slice(0, 2) + national.slice(3);
                variants.push(semNove, '55' + semNove);
            } else if (national.length === 10) {
                const comNove = national.slice(0, 2) + '9' + national.slice(2);
                variants.push(comNove, '55' + comNove);
            }
        }
        return [...new Set(variants.filter(telefoneValido))];
    }

    // =========================================================
    // CONTATO: LOCALIZAR / CRIAR / ATUALIZAR
    // =========================================================
    function contactFromJSON(json) {
        return json?.data || json?.contact || json?.customer || json;
    }

    function customerIdFrom(contact, json = null) {
        return String(
            contact?._id || contact?.id || contact?.customerId || contact?.customer_id ||
            json?.customerId || json?.data?.customerId || ''
        );
    }

    async function lookupExato(phone) {
        const number = digits(phone);
        const response = await requestPublico({
            method: 'GET',
            url: `${TALLOS_API}/v2/contacts/${encodeURIComponent(number)}/exists`,
            timeout: 7000
        });

        const json = parseJSON(response.responseText);
        if (
            response.status === 404 ||
            response.status === 204 ||
            (response.status === 200 && (json?.exists === false || json?.data?.exists === false))
        ) {
            return { exists: false, id: '', contact: null, matchedPhone: number };
        }
        if (response.status !== 200) throw new Error(`LOOKUP_HTTP_${response.status}`);

        const contact = contactFromJSON(json);
        const id = customerIdFrom(contact, json);
        if (!id) throw new Error('CONTATO_EXISTE_SEM_CUSTOMER_ID');

        return {
            exists: true,
            id,
            contact,
            matchedPhone: digits(contact?.cel_phone || contact?.phone || number)
        };
    }

    async function localizarContato(phone) {
        const variants = variantesTelefone(phone);
        const results = await Promise.all(
            variants.map(number =>
                lookupExato(number).catch(error => ({ error, exists: false, requestedPhone: number }))
            )
        );

        const hardError = results.find(item => item.error);
        if (hardError) throw hardError.error;

        const encontrados = results.filter(item => item.exists && item.id);
        const porId = new Map(encontrados.map(item => [String(item.id), item]));
        if (porId.size > 1) throw new Error('VARIANTES_DO_TELEFONE_APONTAM_PARA_CONTATOS_DIFERENTES');

        return [...porId.values()][0] || { exists: false, id: '', contact: null, matchedPhone: digits(phone) };
    }

    function tagsExistentes(contact) {
        if (!Array.isArray(contact?.tags)) return [];
        return contact.tags
            .map(tag => typeof tag === 'string' ? tag : tag?.name)
            .filter(tag => typeof tag === 'string' && tag.trim());
    }

    function payloadContato(dados, phone, tag, novo, existingContact = null) {
        const tags = novo
            ? [tag]
            : [...new Set([...tagsExistentes(existingContact), tag])];

        const payload = {
            full_name: dados.nome,
            cel_phone: digits(phone),
            integration: ID_INTEGRACAO,
            description: `Passageiro exportado. Localizador: ${dados.localizador}`,
            code: dados.localizador,
            tags
        };
        if (novo) payload.department_name = ID_DEPARTAMENTO;
        if (dados.cpf) payload.cpf = dados.cpf;
        return payload;
    }

    async function atualizarContato(dados, phone, tag, contact) {
        const response = await requestPublico({
            method: 'PUT',
            url: `${TALLOS_API}/v2/contacts/whatsapp-business-by-brokers`,
            data: payloadContato(dados, phone, tag, false, contact),
            timeout: 10000
        });
        if (![200, 204].includes(Number(response.status))) {
            throw new Error(`ATUALIZAR_CONTATO_HTTP_${response.status}`);
        }
        return response;
    }

    function criarIdPonteCadastro() {
        return (
            `${Date.now()}-` +
            `${Math.random().toString(36).slice(2, 10)}`
        );
    }

    async function criarContato(dados, tag) {
        const session = getSessaoTallos();

        if (!session?.employeeId || !session?.companyId) {
            throw new Error('SESSAO_TALLOS_SEM_OPERADOR_OU_EMPRESA');
        }

        const requestId =
            criarIdPonteCadastro();

        // Limpa somente uma resposta antiga antes de publicar a nova solicitação.
        GM_setValue(KEY_TALLOS_CREATE_RESPONSE, null);

        GM_setValue(KEY_TALLOS_CREATE_REQUEST, {
            id: requestId,
            state: 'PENDING',
            createdAt: Date.now(),
            dados: {
                nome: String(dados?.nome || '').trim(),
                telefone: digits(dados?.telefone || '')
            }
        });

        const deadline =
            Date.now() + 12000;

        while (Date.now() < deadline) {
            await sleep(100);

            const response =
                GM_getValue(
                    KEY_TALLOS_CREATE_RESPONSE,
                    null
                );

            if (
                !response ||
                String(response.id || '') !== requestId
            ) {
                continue;
            }

            GM_setValue(
                KEY_TALLOS_CREATE_RESPONSE,
                null
            );

            if (!response.ok) {
                if (Number(response.status || 0)) {
                    throw new Error(
                        `CRIAR_CONTATO_INTERNO_HTTP_${response.status}`
                    );
                }

                throw new Error(
                    String(
                        response.error ||
                        'CRIAR_CONTATO_INTERNO_FALHOU'
                    )
                );
            }

            return {
                status: Number(response.status || 0),
                responseText: String(response.responseText || '')
            };
        }

        // Não repete automaticamente: o próximo clique começa fazendo lookup.
        // Se a criação tiver concluído na Tallos mas a resposta se perdeu,
        // o contato será encontrado e reconciliado na próxima tentativa.
        throw new Error('CRIAR_CONTATO_INTERNO_SEM_CONFIRMACAO');
    }

    async function garantirContato(dados, tag) {
        let lookup = await localizarContato(dados.telefone);

        if (lookup.exists) {
            const phone = digits(lookup.matchedPhone || dados.telefone);
            await atualizarContato(dados, phone, tag, lookup.contact);
            return {
                customerId: String(lookup.id),
                phone,
                action: 'CONTATO_EXISTENTE_ATUALIZADO'
            };
        }

        const created = await criarContato(dados, tag);
        const status = Number(created.status || 0);

        if ([200, 201].includes(status)) {
            const json = parseJSON(created.responseText);
            const createdContact = contactFromJSON(json);
            let customerId = customerIdFrom(createdContact, json);

            // A rota interna normalmente devolve o contato criado completo.
            // Se não devolver ID, confirma pelo lookup já existente.
            if (!customerId) {
                lookup = await localizarContato(dados.telefone);
                customerId = String(lookup.id || '');
            }

            if (!customerId) {
                throw new Error('CONTATO_CRIADO_SEM_CUSTOMER_ID');
            }

            // A criação manual da Tallos não leva nossas tags/localizador/CPF.
            // Reutiliza o PUT que já funcionava para contatos existentes,
            // agora apenas para complementar o contato recém-criado.
            const phone = digits(
                lookup?.matchedPhone ||
                createdContact?.cel_phone ||
                createdContact?.celPhone ||
                dados.telefone
            );

            await atualizarContato(
                dados,
                phone,
                tag,
                lookup?.contact || createdContact
            );

            return {
                customerId,
                phone,
                action: 'CONTATO_NOVO_CRIADO_VIA_TALLOS'
            };
        }

        if ([400, 409].includes(status)) {
            // Pode ter sido criado por outra ação entre o lookup e o POST.
            lookup = await localizarContato(dados.telefone);
            if (!lookup.exists || !lookup.id) throw new Error(`CONFLITO_CRIACAO_HTTP_${status}_SEM_CONTATO`);

            const phone = digits(lookup.matchedPhone || dados.telefone);
            await atualizarContato(dados, phone, tag, lookup.contact);
            return {
                customerId: String(lookup.id),
                phone,
                action: 'CONTATO_EXISTENTE_RECONCILIADO'
            };
        }

        throw new Error(`CRIAR_CONTATO_HTTP_${status}`);
    }

    // =========================================================
    // ATENDIMENTO /START
    // =========================================================
    function queueCustomerId(item) {
        const customer = item?.customer || item?.contact || item?.client || item?.cliente;
        if (typeof customer === 'string') return customer;
        if (customer && typeof customer === 'object') {
            return String(customer._id || customer.id || customer.customerId || customer.customer_id || '');
        }
        return String(item?.customer_id || item?.customerId || '');
    }

    function queuePhone(item) {
        const customer = item?.customer && typeof item.customer === 'object'
            ? item.customer
            : (item?.contact && typeof item.contact === 'object' ? item.contact : item);
        return digits(customer?.cel_phone || customer?.phone || customer?.telefone || item?.cel_phone || item?.phone || '');
    }

    function queueDocs(json) {
        const candidates = [
            json, json?.data, json?.docs, json?.items, json?.results,
            json?.data?.docs, json?.data?.items, json?.data?.results
        ];
        const docs = candidates.find(Array.isArray) || [];
        const rawPages = json?.pages ?? json?.totalPages ?? json?.data?.pages ?? json?.data?.totalPages;
        const pages = Math.max(1, Number(rawPages == null ? 1 : rawPages) || 1);
        return { docs, pages };
    }

    function queueMatch(item, customerId, phone) {
        const itemId = queueCustomerId(item);
        if (customerId && itemId) return String(customerId) === String(itemId);
        const itemPhone = queuePhone(item);
        return Boolean(digits(phone) && itemPhone && digits(phone) === itemPhone);
    }

    async function consultarFila(queueName, customerId, phone, deadline = Date.now() + 5000) {
        let pages = 1;
        for (let page = 1; page <= Math.min(pages, 2); page++) {
            if (Date.now() >= deadline) return { ok: false, found: false, reason: 'TIMEOUT_FILA' };

            const channels = JSON.stringify({ channel: 'all', integration: 'all' });
            const params = new URLSearchParams({
                department: '',
                search: '',
                onlyUnreadMessages: 'false',
                channels,
                sortLast: 'desc',
                page: String(page),
                limit: '100'
            });

            const response = await requestSessao({
                method: 'GET',
                url: `${TALLOS_API}/chat/calls/queues/${encodeURIComponent(queueName)}?${params.toString()}`,
                timeout: Math.max(1, deadline - Date.now())
            });

            if (response.status !== 200) return { ok: false, found: false, reason: `FILA_HTTP_${response.status}` };

            const parsed = queueDocs(parseJSON(response.responseText));
            pages = Math.max(pages, parsed.pages);
            const found = parsed.docs.find(item => queueMatch(item, customerId, phone));
            if (found) return { ok: true, found: true, item: found };
        }
        return { ok: true, found: false };
    }

    function activeEvidence(item) {
        return {
            callId: String(item?.current_call?._id || item?.current_call?.id || item?.current_call || ''),
            employeeId: String(item?.on_call_by?._id || item?.on_call_by?.id || item?.on_call_by || '')
        };
    }

    async function confirmarActive(customerId, phone) {
        const deadline = Date.now() + 5000;
        const session = getSessaoTallos();

        for (let attempt = 1; attempt <= 4; attempt++) {
            const active = await consultarFila('queue_calls', customerId, phone, deadline);
            if (!active.ok) return { confirmed: false, reason: active.reason };
            if (active.found) {
                const evidence = activeEvidence(active.item);
                if (evidence.callId && evidence.employeeId === String(session?.employeeId || '')) {
                    return { confirmed: true, ...evidence };
                }
                return { confirmed: false, reason: 'ATENDIMENTO_DE_OUTRO_OPERADOR' };
            }
            if (attempt < 4) await sleep(250);
        }
        return { confirmed: false, reason: 'ACTIVE_NAO_CONFIRMADO' };
    }

    function startEvidence(response, customerId) {
        const status = Number(response?.status || 0);
        if (status < 200 || status >= 300) return { valid: false };

        const json = parseJSON(response.responseText);
        const call = json?.data?.call || json?.call || json?.data || json;
        const callId = String(call?._id || call?.id || '');
        const responseCustomerId = String(
            call?.customer?._id || call?.customer?.id || call?.customer ||
            json?.customer?._id || json?.customer?.id || json?.customer || ''
        );
        const owner = String(call?.employee?._id || call?.employee?.id || call?.employee || '');
        const sameOwner = !owner || owner === String(getSessaoTallos()?.employeeId || '');

        return {
            valid: Boolean(callId && responseCustomerId === String(customerId) && sameOwner && call?.closed === false),
            callId
        };
    }

    async function iniciarAtendimento(customerId, phone) {
        const session = getSessaoTallos();
        if (!session?.employeeId) throw new Error('SESSAO_TALLOS_SEM_OPERADOR');

        // Não interfere em cliente que já está esperando ou já possui atendimento.
        const waiting = await consultarFila('queue_await', customerId, phone, Date.now() + 4000);
        if (!waiting.ok) throw new Error(waiting.reason);
        if (waiting.found) throw new Error('CLIENTE_JA_ESTA_NA_FILA_TALLOS');

        const activeBefore = await consultarFila('queue_calls', customerId, phone, Date.now() + 4000);
        if (!activeBefore.ok) throw new Error(activeBefore.reason);
        if (activeBefore.found) throw new Error('CLIENTE_JA_POSSUI_ATENDIMENTO_ATIVO');

        const params = new URLSearchParams({
            employee: String(session.employeeId),
            timezone: TIMEZONE,
            department: ID_DEPARTAMENTO
        });

        const response = await requestSessao({
            method: 'GET',
            url: `${TALLOS_API}/calls/from/customer/${encodeURIComponent(customerId)}/start?${params.toString()}`,
            timeout: 10000
        });

        const status = Number(response.status || 0);
        if (status === 401 || status === 403) {
            GM_setValue(KEY_TALLOS_SESSION, null);
            throw new Error(`SESSAO_TALLOS_EXPIRADA_HTTP_${status}`);
        }
        if (status < 200 || status >= 300) {
            throw new Error(`START_HTTP_${status}`);
        }

        const evidence = startEvidence(response, customerId);
        if (evidence.valid) return { confirmed: true, callId: evidence.callId };

        const active = await confirmarActive(customerId, phone);
        if (!active.confirmed) throw new Error(active.reason || 'START_NAO_CONFIRMADO');
        return active;
    }

    // =========================================================
    // TEMPLATE (Falha de transação — nameSync "1")
