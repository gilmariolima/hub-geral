    function requestTallos({ method = 'GET', url, token, data = null, timeout = 15000 }) {
        return new Promise((resolve, reject) => {
            GM_xmlhttpRequest({
                method,
                url,
                headers: {
                    'Accept': 'application/json, text/plain, */*',
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${token}`
                },
                data: data == null ? undefined : JSON.stringify(data),
                timeout,
                onload: resolve,
                onerror: err => reject(new Error(`Falha de conexão Tallos: ${err?.error || 'erro de rede'}`)),
                ontimeout: () => reject(new Error('Timeout na Tallos.'))
            });
        });
    }

