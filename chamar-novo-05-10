    function decodeJWT(token) {
        try {
            const parts = String(token || '').split('.');
            if (parts.length !== 3) return null;
            let base64 = parts[1].replace(/-/g, '+').replace(/_/g, '/');
            while (base64.length % 4) base64 += '=';
            const binary = atob(base64);
            const bytes = Uint8Array.from(binary, c => c.charCodeAt(0));
            return JSON.parse(new TextDecoder('utf-8').decode(bytes));
        } catch {
            return null;
        }
    }

    function extrairBearer(value) {
        return String(value || '').trim().replace(/^Bearer\s+/i, '').trim();
    }

    function salvarSessaoTallos(authorization, source = 'request') {
        const token = extrairBearer(authorization);
        const payload = decodeJWT(token);
        if (!payload) return false;

        const employeeId = payload.employeeId || payload.employee_id || payload.employee;
        const companyId = payload.companyId || payload.company_id || payload.company;
        if (!employeeId || !companyId) return false;
        if (payload.exp && Number(payload.exp) * 1000 <= Date.now()) return false;

        GM_setValue(KEY_TALLOS_SESSION, {
            token,
            employeeId: String(employeeId),
            companyId: String(companyId),
            email: String(payload.employeeEmail || payload.employee_email || payload.email || ''),
            exp: payload.exp || null,
            capturedAt: Date.now(),
            source
        });
        return true;
    }

    function getSessaoTallos() {
        const session = GM_getValue(KEY_TALLOS_SESSION, null);
        if (!session?.token || !session?.employeeId) return null;
        const payload = decodeJWT(session.token);
        const exp = Number(session.exp || payload?.exp || 0);
        if (exp && exp * 1000 <= Date.now() + 60000) return null;
        return session;
    }

    function extrairAuthorization(headers) {
        if (!headers) return '';
        try {
            if (typeof headers.get === 'function') {
                return headers.get('Authorization') || headers.get('authorization') || '';
            }
            if (Array.isArray(headers)) {
                const found = headers.find(([name]) => String(name).toLowerCase() === 'authorization');
                return found?.[1] || '';
            }
            if (typeof headers === 'object') {
                const key = Object.keys(headers).find(name => name.toLowerCase() === 'authorization');
                return key ? headers[key] : '';
            }
        } catch {}
        return '';
    }

    function procurarJWTs(text) {
        return typeof text === 'string'
            ? (text.match(/eyJ[A-Za-z0-9_-]*\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+/g) || [])
            : [];
    }

    function scanStorage(storage, source) {
        try {
            for (let i = 0; i < storage.length; i++) {
                const key = storage.key(i);
                const value = storage.getItem(key);
                for (const token of procurarJWTs(value)) {
                    if (salvarSessaoTallos(token, `${source}:${key}`)) return true;
                }
            }
        } catch {}
        return false;
    }

    function instalarCapturaFetchTallos() {
        try {
            const w = unsafeWindow;
            if (!w?.fetch || w.fetch.__cadastroTallosV11) return;
            const original = w.fetch;
            const wrapped = async function(...args) {
                try {
                    const input = args[0];
                    const init = args[1] || {};
                    let auth = extrairAuthorization(init.headers);
                    if (!auth && input?.headers) auth = extrairAuthorization(input.headers);
                    if (auth) salvarSessaoTallos(auth, 'fetch');
                } catch {}
                return original.apply(this, args);
            };
            wrapped.__cadastroTallosV11 = true;
            w.fetch = wrapped;
        } catch {}
    }

    function instalarCapturaXHRTallos() {
        try {
            const proto = unsafeWindow?.XMLHttpRequest?.prototype;
            if (!proto || proto.__cadastroTallosV11) return;
            const originalSet = proto.setRequestHeader;
            proto.setRequestHeader = function(name, value) {
                try {
