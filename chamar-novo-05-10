    // Confirma na hora que existe uma aba da Tallos respondendo
    // (a aba responde ao ping por evento, mesmo em segundo plano).
    async function pingTallos(timeout = 3000) {
        const sentAt = Date.now();
        GM_setValue(KEY_TALLOS_PING, sentAt);
        const deadline = sentAt + timeout;
        while (Date.now() < deadline) {
            if (Number(GM_getValue(KEY_TALLOS_HEARTBEAT, 0)) >= sentAt) return true;
            await sleep(100);
        }
        return false;
    }

