    function setEtapaPainel(step, state = 'busy') {
        etapaAtual = Number(step) || etapaAtual;
        const all = Array.from(document.querySelectorAll('#painel-tallos [data-flow-step]'));
        for (const el of all) {
            const n = Number(el.dataset.flowStep || 0);
            let status = 'idle';
            if (n < step) status = 'ok';
            else if (n === step) status = state;
            if (state === 'done' && n <= step) status = 'ok';

            el.dataset.state = status;
            const circle = el.querySelector('.sbv12-step-dot');
            if (circle) {
                circle.textContent =
                    status === 'ok' ? '✓' :
                    status === 'error' ? '!' :
                    String(n);
            }
        }
    }

    function marcarEtapaErro() {
        if (!etapaAtual) return;
        const el = document.querySelector(`#painel-tallos [data-flow-step="${etapaAtual}"]`);
        if (!el) return;
        el.dataset.state = 'error';
        const circle = el.querySelector('.sbv12-step-dot');
        if (circle) circle.textContent = '!';
    }

    function resetEtapasPainel() {
        etapaAtual = 0;
        document.querySelectorAll('#painel-tallos [data-flow-step]').forEach((el, index) => {
            el.dataset.state = 'idle';
            const circle = el.querySelector('.sbv12-step-dot');
            if (circle) circle.textContent = String(index + 1);
        });
    }

    function clamp(value, min, max) {
        return Math.min(Math.max(value, min), max);
    }

    function salvarPosicaoPainel(container) {
        try {
            const rect = container.getBoundingClientRect();
            GM_setValue(KEY_PANEL_POSITION, {
                left: Math.round(rect.left),
                top: Math.round(rect.top)
            });
        } catch {}
    }

    function restaurarPosicaoPainel(container) {
        try {
            const saved = GM_getValue(KEY_PANEL_POSITION, null);
            if (!saved || !Number.isFinite(Number(saved.left)) || !Number.isFinite(Number(saved.top))) return;
            const width = container.offsetWidth || 300;
            const height = container.offsetHeight || 180;
            const left = clamp(Number(saved.left), 6, Math.max(6, window.innerWidth - width - 6));
            const top = clamp(Number(saved.top), 6, Math.max(6, window.innerHeight - Math.min(height, window.innerHeight - 12) - 6));
            container.style.left = `${left}px`;
            container.style.top = `${top}px`;
            container.style.right = 'auto';
            container.style.bottom = 'auto';
        } catch {}
    }

    function instalarPainelMovivel(container, handle) {
        if (!container || !handle) return;

        let dragging = false;
        let pointerId = null;
        let offsetX = 0;
        let offsetY = 0;

        const move = event => {
            if (!dragging || (pointerId != null && event.pointerId !== pointerId)) return;
            const width = container.offsetWidth;
            const height = container.offsetHeight;
            const left = clamp(event.clientX - offsetX, 6, Math.max(6, window.innerWidth - width - 6));
            const top = clamp(event.clientY - offsetY, 6, Math.max(6, window.innerHeight - Math.min(height, window.innerHeight - 12) - 6));
            container.style.left = `${left}px`;
            container.style.top = `${top}px`;
            container.style.right = 'auto';
            container.style.bottom = 'auto';
        };

        const end = event => {
            if (!dragging || (pointerId != null && event.pointerId !== pointerId)) return;
            dragging = false;
            try { handle.releasePointerCapture(pointerId); } catch {}
            handle.style.cursor = 'grab';
            salvarPosicaoPainel(container);
            pointerId = null;
        };

        handle.addEventListener('pointerdown', event => {
            if (event.button !== 0) return;
            if (event.target.closest('button,select,input')) return;

            const rect = container.getBoundingClientRect();
            dragging = true;
            pointerId = event.pointerId;
            offsetX = event.clientX - rect.left;
            offsetY = event.clientY - rect.top;

            container.style.left = `${rect.left}px`;
            container.style.top = `${rect.top}px`;
            container.style.right = 'auto';
            container.style.bottom = 'auto';
            handle.style.cursor = 'grabbing';

            try { handle.setPointerCapture(pointerId); } catch {}
            event.preventDefault();
        });

        handle.addEventListener('pointermove', move);
        handle.addEventListener('pointerup', end);
        handle.addEventListener('pointercancel', end);

        window.addEventListener('resize', () => {
            const rect = container.getBoundingClientRect();
            const left = clamp(rect.left, 6, Math.max(6, window.innerWidth - container.offsetWidth - 6));
            const top = clamp(rect.top, 6, Math.max(6, window.innerHeight - 60));
            container.style.left = `${left}px`;
            container.style.top = `${top}px`;
            container.style.right = 'auto';
            container.style.bottom = 'auto';
            salvarPosicaoPainel(container);
        });
    }

    // =========================================================
    // PROGRESSO (RETOMAR DE ONDE PAROU)
    // =========================================================
    const NOMES_ETAPAS = ['', 'Cadastro', 'Atendimento (/start)', 'Template', 'Fila'];

    function chaveFluxo(dados) {
        return `${dados.localizador}|${digits(dados.telefone)}`;
    }

    function lerProgressos() {
        const all = GM_getValue(KEY_FLOW_PROGRESS, {}) || {};
        const agora = Date.now();
        const validos = {};
        for (const [key, value] of Object.entries(all)) {
            if (value?.at && agora - value.at < PROGRESSO_VALIDADE_MS) validos[key] = value;
        }
        return validos;
    }

    function getProgresso(dados) {
        const progresso = lerProgressos()[chaveFluxo(dados)];
        return progresso && progresso.etapa >= 1 && progresso.etapa < 4 ? progresso : null;
    }

    function salvarProgresso(dados, info) {
        const all = lerProgressos();
        all[chaveFluxo(dados)] = { ...info, at: Date.now() };
        GM_setValue(KEY_FLOW_PROGRESS, all);
    }

    function limparProgresso(dados) {
        const all = lerProgressos();
        delete all[chaveFluxo(dados)];
        GM_setValue(KEY_FLOW_PROGRESS, all);
    }

    function horaCurta(ts) {
        return new Date(ts).toLocaleString('pt-BR', {
            day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit'
        });
    }

    async function executarCadastroEEnvio() {
        if (fluxoEmAndamento) return;

        const selectAgente = document.getElementById('select-agente-tallos');
        const nomeSelecionado = selectAgente?.value || '';
        if (!nomeSelecionado) {
            alert('⚠️ Selecione o operador do turno antes de continuar.');
            return;
        }

        if (!getSessaoTallos()) {
            alert('⚠️ A Tallos não está com uma sessão conectada.\n\nAbra app.tallos.com.br, faça login e deixe a aba carregada. Depois tente novamente.');
            return;
        }

        const dados = capturarDados();
        if (!dados) {
            alert('⛔ Não foi possível capturar os dados desta reserva.');
            return;
        }

        if (dados.faltando?.length) {
            const seguir = confirm(
                `⚠️ Não consegui ler da tela: ${dados.faltando.join(' e ')}.\n\n` +
                `Confira se a reserva está aberta. Continuar mesmo assim?`
            );
            if (!seguir) return;
        }

        if (!dados.telefone) {
            const manual = prompt('Telefone não encontrado. Cole abaixo o número do cliente:');
            if (!manual) return;
            dados.telefone = normalizarTelefoneManual(manual);
        }

        if (!telefoneValido(dados.telefone)) {
            alert('⛔ Telefone inválido. O fluxo foi cancelado antes de acessar a Tallos.');
            return;
        }

        let progresso = getProgresso(dados);
        if (progresso) {
            const retomar = confirm(
                `↩️ O último envio para este cliente parou depois da etapa ` +
                `"${NOMES_ETAPAS[progresso.etapa]}" (${horaCurta(progresso.at)}).\n\n` +
                `OK = continuar de onde parou\n` +
                `Cancelar = começar do zero`
            );
            if (!retomar) {
                limparProgresso(dados);
                progresso = null;
            }
        }

        fluxoEmAndamento = true;
        resetEtapasPainel();
        const tag = gerarTag(nomeSelecionado);

        let feitas = progresso?.etapa || 0;
        let contact = progresso
            ? {
                customerId: progresso.customerId,
                phone: progresso.phone,
                action: `RETOMADO_APOS_${NOMES_ETAPAS[progresso.etapa].toUpperCase()}`
            }
            : null;

        try {
            setButton('Verificando Tallos...', true);
            setStatus('Confirmando que a aba da Tallos está respondendo...', 'busy');

            if (!(await pingTallos())) {
                throw new Error('ABA_TALLOS_NAO_RESPONDEU (abra ou recarregue app.tallos.com.br)');
            }

            if (feitas < 1) {
                setEtapaPainel(1, 'busy');
                setButton('1/4 • Cadastrando...', true);
                setStatus('Localizando ou atualizando o contato na Tallos...', 'busy');

                contact = await garantirContato(dados, tag);
                feitas = 1;
                salvarProgresso(dados, { etapa: 1, customerId: contact.customerId, phone: contact.phone });
            }

            if (feitas < 2) {
                setEtapaPainel(2, 'busy');
                setButton('2/4 • Iniciando atendimento...', true);
                setStatus(`Contato confirmado • ${contact.action}. Iniciando atendimento...`, 'busy');

                await iniciarAtendimento(contact.customerId, contact.phone);
                feitas = 2;
                salvarProgresso(dados, { etapa: 2, customerId: contact.customerId, phone: contact.phone });
            }

            if (feitas < 3) {
                setEtapaPainel(3, 'busy');
                setButton('3/4 • Enviando template...', true);
                setStatus(`Atendimento confirmado. Enviando template "${TEMPLATE.label}"...`, 'busy');

                await enviarTemplate(contact.customerId);
                feitas = 3;
                salvarProgresso(dados, { etapa: 3, customerId: contact.customerId, phone: contact.phone });
            }

            setEtapaPainel(4, 'busy');
            setButton('4/4 • Enviando para fila...', true);
            setStatus(`Template confirmado. Transferindo para ${NOME_DEPARTAMENTO}...`, 'busy');

            const transfer = await transferirEConfirmar(contact.customerId, contact.phone);
            feitas = 4;
            limparProgresso(dados);

            setEtapaPainel(4, 'done');
            setStatus(`✅ Fluxo concluído • ${NOME_DEPARTAMENTO} confirmado.`, 'ok');
            setButton('✅ Enviado para fila', false);

            try {
                await navigator.clipboard.writeText(digits(contact.phone).slice(-8));
            } catch {}

            alert(
                `✅ FLUXO CONCLUÍDO\n\n` +
                `Cliente: ${dados.nome}\n` +
                `Cadastro: ${contact.action}\n` +
                `Atendimento: iniciado\n` +
                `Template: ${TEMPLATE.label} enviado\n` +
                `Fila: ${transfer.department || NOME_DEPARTAMENTO} confirmada`
            );

            setTimeout(() => setButton('📲 Cadastrar + enviar + fila', false), 1800);
        } catch (error) {
            const reason = error?.message || String(error);
            const etapaFalha = NOMES_ETAPAS[feitas + 1] || 'Verificação';
            console.error('[Tallos V12.6] Fluxo interrompido:', error);
            marcarEtapaErro();
            setStatus(`⚠️ Parou em ${etapaFalha}: ${reason}`, 'error');
            setButton(feitas ? '↩️ Continuar de onde parou' : '📲 Tentar novamente', false);

            alert(
                `⚠️ O fluxo foi interrompido com segurança na etapa "${etapaFalha}".\n\n` +
                `${reason}\n\n` +
                `O script não avançou para a etapa seguinte sem confirmação.` +
                (feitas
                    ? `\n\nAs etapas já concluídas foram salvas: no próximo clique dá para continuar de onde parou.`
                    : '')
            );
        } finally {
            fluxoEmAndamento = false;
        }
    }

    // =========================================================
    // AGENTES — LISTA FIXA + PRÉ-SELEÇÃO DO OPERADOR LOGADO
    // =========================================================
    let preSelecaoFeita = false;
    let preSelecaoEmAndamento = false;

    function normalizarNome(nome) {
        return String(nome || '')
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .toLowerCase()
            .replace(/\s+/g, ' ')
            .trim();
    }

    function encontrarAgente(nome) {
        const alvo = normalizarNome(nome);
        if (!alvo) return '';
        // Igual ao nome da lista, ou nome da Tallos começando por ele
        // (ex.: "Gilmário Lima Souza" -> "Gilmario Lima").
        return AGENTES.find(agente => {
            const a = normalizarNome(agente);
            return alvo === a || alvo.startsWith(a + ' ');
        }) || '';
    }

    function preencherSelectAgentes(select) {
        const salvo = String(GM_getValue(KEY_AGENT_SELECTED, '') || '');

        select.innerHTML = '';

        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = 'Selecione o Agente...';
        select.appendChild(placeholder);

        for (const nome of AGENTES) {
            const option = document.createElement('option');
            option.value = nome;
            option.textContent = nome;
            select.appendChild(option);
        }

        // Seleção antiga que não está mais na lista é descartada.
        select.value = AGENTES.includes(salvo) ? salvo : '';
        if (!select.value && salvo) GM_setValue(KEY_AGENT_SELECTED, '');
    }

    async function preSelecionarOperadorLogado(select) {
        if (preSelecaoFeita || preSelecaoEmAndamento || !select || select.value) return;
        if (!tallosConectada()) return;

        preSelecaoEmAndamento = true;
        try {
            const nome = await obterNomeOperadorTallos();
            const agente = encontrarAgente(nome);
            if (agente && !select.value) {
                select.value = agente;
                GM_setValue(KEY_AGENT_SELECTED, agente);
            }
        } catch (error) {
            console.warn('[Tallos V12.6.1] Pré-seleção do operador:', error);
        } finally {
            preSelecaoFeita = true;
            preSelecaoEmAndamento = false;
        }
    }

