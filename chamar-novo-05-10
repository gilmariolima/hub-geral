    // =========================================================
    // TRANSFERÊNCIA PARA O SETOR DE VENDAS
    // =========================================================
    function nomeFuncionario(item) {
        return String(item?.name || item?.full_name || item?.fullName || '').trim();
    }

    function idFuncionario(item) {
        return String(item?._id || item?.id || '');
    }

    async function listarFuncionariosTallos() {
        const response = await requestSessao({
            method: 'GET',
            url: `${TALLOS_API}/megasac-api/employees/all/?inactive=0`,
            timeout: 8000
        });

        const status = Number(response.status || 0);
        if (status === 401 || status === 403) {
            GM_setValue(KEY_TALLOS_SESSION, null);
            throw new Error(`SESSAO_TALLOS_EXPIRADA_HTTP_${status}`);
        }
        if (status !== 200) {
            throw new Error(`OPERADOR_HTTP_${status}`);
        }

        const json = parseJSON(response.responseText);
        const list = Array.isArray(json) ? json : (json?.data || json?.docs || []);
        return Array.isArray(list) ? list : [];
    }

    async function obterNomeOperadorTallos() {
        const session = getSessaoTallos();
        if (!session?.employeeId) throw new Error('SESSAO_TALLOS_SEM_OPERADOR');
        if (session.employeeName) return session.employeeName;

        const list = await listarFuncionariosTallos();
        const employee = list.find(item => idFuncionario(item) === String(session.employeeId));
        const name = nomeFuncionario(employee);

        if (!name) throw new Error('NOME_OPERADOR_NAO_ENCONTRADO');

        session.employeeName = name;
        GM_setValue(KEY_TALLOS_SESSION, session);
        return name;
    }

    async function transferirParaSetor(customerId) {
        const actionBy = await obterNomeOperadorTallos();

        const response = await requestSessao({
            method: 'POST',
            url: `${TALLOS_API}/customers/transfer-to-department`,
            data: {
                action_by: actionBy,
                customer: String(customerId),
                department_label: ID_DEPARTAMENTO,
                department_name: NOME_DEPARTAMENTO,
                transfer_ticket_link: false,
                ticket_id: null
            },
            timeout: 10000
        });

        const status = Number(response.status || 0);
        if (status < 200 || status >= 300) {
            throw new Error(`TRANSFERENCIA_HTTP_${status || 0}`);
        }
        return response;
    }

    function nomeDepartamentoDaFila(item) {
        return String(
            item?.listView?.departmentInfo?.name ||
            item?.departmentInfo?.name ||
            item?.department?.name ||
            item?.department_name ||
            ''
        ).trim();
    }

    async function confirmarTransferencia(customerId, phone) {
        const deadline = Date.now() + 6000;

        for (let attempt = 1; attempt <= 5; attempt++) {
            const waiting = await consultarFila('queue_await', customerId, phone, deadline);

            if (!waiting.ok) {
                return { confirmed: false, reason: waiting.reason || 'FILA_NAO_CONFIRMADA' };
            }

            if (waiting.found) {
                const department = nomeDepartamentoDaFila(waiting.item);
                if (department === NOME_DEPARTAMENTO) {
                    return {
                        confirmed: true,
                        state: 'WAITING',
                        department,
                        attempts: attempt
                    };
                }
                return {
                    confirmed: false,
                    reason: `DEPARTAMENTO_DIVERGENTE_${department || 'SEM_NOME'}`
                };
            }

            if (attempt < 5) await sleep(300);
        }

        return { confirmed: false, reason: 'WAITING_NAO_CONFIRMADO' };
    }

    async function transferirEConfirmar(customerId, phone) {
        await transferirParaSetor(customerId);

        const confirmed = await confirmarTransferencia(customerId, phone);
        if (!confirmed.confirmed) {
            throw new Error(confirmed.reason || 'TRANSFERENCIA_NAO_CONFIRMADA');
        }
        return confirmed;
    }

