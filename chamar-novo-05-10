    async function tallosFetchInternoCadastro(url, payload, token, timeout = 10000) {
        const controller =
            typeof AbortController !== 'undefined'
                ? new AbortController()
                : null;

        const timer = controller
            ? setTimeout(() => controller.abort(), timeout)
            : null;

        try {
            const response = await unsafeWindow.fetch(url, {
                method: 'POST',
                credentials: 'include',
                headers: {
                    'Accept': 'application/json, text/plain, */*',
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${token}`
                },
                body: JSON.stringify(payload),
                signal: controller?.signal
            });

            const responseText = await response.text();

            return {
                status: Number(response.status || 0),
                responseText
            };
        } finally {
            if (timer) clearTimeout(timer);
        }
    }

    let tallosCreateBridgeBusy = false;
    let tallosCreateBridgeLastId = '';

    async function processarPonteCadastroNovo() {
        if (tallosCreateBridgeBusy) return;

        const request = GM_getValue(KEY_TALLOS_CREATE_REQUEST, null);

        if (
            !request?.id ||
            request.state !== 'PENDING' ||
            String(request.id) === String(tallosCreateBridgeLastId)
        ) {
            return;
        }

        // Não executa pedidos muito antigos depois de reload/reabertura.
        const createdAt = Number(request.createdAt || 0);
        if (!createdAt || Date.now() - createdAt > 30000) {
            GM_setValue(KEY_TALLOS_CREATE_RESPONSE, {
                id: String(request.id),
                ok: false,
                status: 0,
                error: 'PEDIDO_DE_CADASTRO_EXPIRADO',
                respondedAt: Date.now()
            });
            GM_setValue(KEY_TALLOS_CREATE_REQUEST, null);
            return;
        }

        const session = getSessaoTallos();
        if (!session?.employeeId || !session?.companyId) {
            GM_setValue(KEY_TALLOS_CREATE_RESPONSE, {
                id: String(request.id),
                ok: false,
                status: 0,
                error: 'SESSAO_TALLOS_SEM_OPERADOR_OU_EMPRESA',
                respondedAt: Date.now()
            });
            GM_setValue(KEY_TALLOS_CREATE_REQUEST, null);
            return;
        }

        const dados = {
            nome: String(request?.dados?.nome || '').trim(),
            telefone: digits(request?.dados?.telefone || '')
        };

        if (!dados.nome || !telefoneValido(dados.telefone)) {
            GM_setValue(KEY_TALLOS_CREATE_RESPONSE, {
                id: String(request.id),
                ok: false,
                status: 0,
                error: 'DADOS_INVALIDOS_PARA_CADASTRO_INTERNO',
                respondedAt: Date.now()
            });
            GM_setValue(KEY_TALLOS_CREATE_REQUEST, null);
            return;
        }

        tallosCreateBridgeBusy = true;
        tallosCreateBridgeLastId = String(request.id);

        // Trava entre abas: cada aba da Tallos tenta assumir o pedido e só
        // segue quem continuar como dona depois de um pequeno intervalo.
        GM_setValue(KEY_TALLOS_CREATE_REQUEST, {
            ...request,
            state: 'CLAIMED',
            owner: TAB_ID,
            claimedAt: Date.now()
        });

        await sleep(200);

        const claimed = GM_getValue(KEY_TALLOS_CREATE_REQUEST, null);
        if (!claimed || String(claimed.id) !== String(request.id) || claimed.owner !== TAB_ID) {
            tallosCreateBridgeBusy = false;
            return; // outra aba da Tallos assumiu este pedido
        }

        // Marca como SENDING antes da escrita. Se a aba recarregar depois daqui,
        // não há reenvio automático da mesma ocorrência.
        GM_setValue(KEY_TALLOS_CREATE_REQUEST, {
            ...claimed,
            state: 'SENDING',
            sendingAt: Date.now()
        });

        try {
            const url =
                `${TALLOS_API}/megasac-api/whatsapp-official/create/` +
                `${encodeURIComponent(session.companyId)}`;

            const payload =
                payloadCadastroInternoTallos(dados, session);

            const result =
                await tallosFetchInternoCadastro(
                    url,
                    payload,
                    session.token,
                    10000
                );

            GM_setValue(KEY_TALLOS_CREATE_RESPONSE, {
                id: String(request.id),
                ok:
                    result.status >= 200 &&
                    result.status < 300,
                status: result.status,
                responseText: String(result.responseText || ''),
                respondedAt: Date.now()
            });
        } catch (error) {
            GM_setValue(KEY_TALLOS_CREATE_RESPONSE, {
                id: String(request.id),
                ok: false,
                status: 0,
                error:
                    error?.name === 'AbortError'
                        ? 'TIMEOUT_CADASTRO_INTERNO_TALLOS'
                        : String(error?.message || error || 'ERRO_CADASTRO_INTERNO_TALLOS'),
                respondedAt: Date.now()
            });
        } finally {
            GM_setValue(KEY_TALLOS_CREATE_REQUEST, null);
            tallosCreateBridgeBusy = false;
        }
    }

    function iniciarPonteTallos() {
