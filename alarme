// ==UserScript==
// @name         Alarme
// @namespace    http://tampermonkey.net/
// @version      4.2.0
// @description  Cartões flutuantes arrastáveis com anel de progresso e cronômetro persistente
// @author       ChatGPT
// @match        https://app.tallos.com.br/*
// @grant        none
// @run-at       document-idle
// ==/UserScript==

(function () {
    'use strict';

    const STORAGE_KEY = 'tm_floating_minute_alarms_v340';

    // --- Geometria dos anéis de progresso -----------------------------------
    const FLOAT_RING_RADIUS = 21;
    const FLOAT_RING_CIRC = 2 * Math.PI * FLOAT_RING_RADIUS;

    // --- Ícones (SVG inline, sem dependências externas) ---------------------
    const ICON_BELL = `
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 3.5c-3.2 0-5.2 2.3-5.2 5.6v2.3c0 1-.4 2-1.1 2.8l-.9 1c-.6.6-.2 1.7.7 1.7h13.9c.9 0 1.3-1.1.7-1.7l-.9-1c-.7-.8-1.1-1.8-1.1-2.8V9.1c0-3.3-2-5.6-5.1-5.6Z"
                stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
            <path d="M9.8 19.5a2.4 2.4 0 0 0 4.4 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>`;

    const ICON_TRASH = `
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M5 7h14M9.5 7V5.2c0-.7.5-1.2 1.2-1.2h2.6c.7 0 1.2.5 1.2 1.2V7M7 7l.7 11.2c0 .9.8 1.6 1.7 1.6h5.2c.9 0 1.7-.7 1.7-1.6L17 7"
                stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M10.2 10.5v5M13.8 10.5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>`;

    const ICON_CLOSE = `
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>`;

    const ICON_CHECK = `
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M5 12.5l4.2 4.2L19 6.8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>`;

    let alarms = loadAlarms();
    let dragState = null;
    let zIndexCounter = 2147483600;

    injectStyles();
    createUI();
    normalizeLoadedAlarms();
    renderFloatingAlarmBalloons();
    startWatcher();

    function loadAlarms() {
        try {
            const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
            return Array.isArray(parsed) ? parsed : [];
        } catch {
            return [];
        }
    }

    function saveAlarms() {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(alarms));
    }

    function normalizeLoadedAlarms() {
        let changed = false;

        alarms.forEach((alarm, index) => {
            if (!alarm.id) {
                alarm.id = 'alarm_' + Date.now() + '_' + index;
                changed = true;
            }

            if (!Number.isFinite(alarm.createdAt)) {
                alarm.createdAt = Date.now();
                changed = true;
            }

            if (!Number.isFinite(alarm.endAt)) {
                const minutes = Number(alarm.minutes) || 1;
                alarm.endAt = alarm.createdAt + (minutes * 60 * 1000);
                changed = true;
            }

            if (!Number.isFinite(alarm.left) || !Number.isFinite(alarm.top)) {
                const pos = getDefaultPosition(index);
                alarm.left = pos.left;
                alarm.top = pos.top;
                changed = true;
            }

            if (typeof alarm.finished !== 'boolean') {
                alarm.finished = Date.now() >= alarm.endAt;
                changed = true;
            }
        });

        if (changed) {
            saveAlarms();
        }
    }

    function injectStyles() {
        const style = document.createElement('style');
        style.textContent = `
            @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=JetBrains+Mono:wght@500;700&display=swap');

            #tm-alarm-root {
                --tm-cream: #1c1a1e;
                --tm-surface: #232025;
                --tm-peach: #ff9c5c;
                --tm-peach-strong: #ff6a1f;
                --tm-peach-line: rgba(255, 106, 31, 0.4);
                --tm-ink: #f3ece6;
                --tm-ink-soft: #a89d94;
                --tm-mint: #7ed9ab;
                --tm-mint-strong: #45c48a;
                --tm-mint-line: rgba(126, 217, 171, 0.35);
                --tm-coral: #ff8f80;
                font-family: 'Sora', Arial, sans-serif;
            }

            #tm-alarm-fab {
                position: fixed;
                right: 410px;
                top: 8px;
                z-index: 2147483647;
                width: 45px;
                height: 45px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                border: none;
                cursor: pointer;
                background: linear-gradient(150deg, #ff8a3d, var(--tm-peach-strong));
                color: #1c1a1e;
            }

            #tm-alarm-fab:hover {
                transform: translateY(-2px) scale(1.05);
            }

            #tm-alarm-fab svg {
                width: 22px;
                height: 22px;
            }

            .tm-fab-dot {
                position: absolute;
                top: 6px;
                right: 6px;
                width: 11px;
                height: 11px;
                border-radius: 50%;
                background: var(--tm-mint);
                border: 2px solid #1c1a1e;
                display: none;
                animation: tm-dot-pulse 1.8s ease-in-out infinite;
            }

            #tm-alarm-panel {
                position: fixed;
                right: 410px;
                top: 68px;
                width: 300px;
                max-height: 72vh;
                overflow: auto;
                background: var(--tm-cream);
                border: 1px solid var(--tm-peach-line);
                border-radius: 24px;
                z-index: 2147483646;
                padding: 18px;
                opacity: 0;
                transform: translateY(-10px) scale(.98);
                pointer-events: none;
                visibility: hidden;
                transition: opacity .18s ease, transform .18s ease;
            }

            #tm-alarm-panel.tm-show {
                opacity: 1;
                transform: translateY(0) scale(1);
                pointer-events: auto;
                visibility: visible;
            }

            .tm-panel-header {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                margin-bottom: 14px;
            }

            .tm-panel-title {
                font-size: 17px;
                font-weight: 700;
                color: var(--tm-ink);
                line-height: 1.3;
            }

            .tm-panel-subtitle {
                font-size: 11.5px;
                color: var(--tm-ink-soft);
                margin-top: 2px;
                font-weight: 400;
            }

            .tm-panel-close {
                border: none;
                background: rgba(255, 106, 31, 0.16);
                color: var(--tm-ink-soft);
                width: 26px;
                height: 26px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                flex-shrink: 0;
                transition: background .15s ease, color .15s ease;
            }

            .tm-panel-close:hover {
                background: rgba(255, 111, 97, 0.22);
                color: var(--tm-coral);
            }

            .tm-panel-close svg {
                width: 13px;
                height: 13px;
            }

            .tm-field-label {
                font-size: 11px;
                font-weight: 600;
                color: var(--tm-ink-soft);
                text-transform: uppercase;
                letter-spacing: .04em;
                margin: 0 2px 5px;
                display: block;
            }

            .tm-input {
                width: 100%;
                box-sizing: border-box;
                padding: 10px 12px;
                border: 1.5px solid rgba(255, 106, 31, 0.32);
                border-radius: 12px;
                font-size: 14px;
                font-family: 'Sora', Arial, sans-serif;
                outline: none;
                margin-bottom: 10px;
                background: var(--tm-surface);
                color: var(--tm-ink);
                transition: border-color .15s ease;
            }

            .tm-input:focus {
                border-color: var(--tm-peach-strong);
            }

            .tm-input::placeholder {
                color: #6f665e;
            }

            .tm-btn-save {
                width: 100%;
                border: none;
                border-radius: 12px;
                padding: 11px 14px;
                cursor: pointer;
                font-size: 13.5px;
                font-weight: 700;
                font-family: 'Sora', Arial, sans-serif;
                background: linear-gradient(135deg, #ff8a3d, var(--tm-peach-strong));
                color: #1c1a1e;
                margin: 4px 0 4px;
            }

            .tm-btn-save:hover {
                transform: translateY(-1px);
            }

            #tm-floating-alarms {
                position: fixed;
                inset: 0;
                z-index: 2147483645;
                pointer-events: none;
            }

            .tm-floating-alarm {
                position: fixed;
                width: 188px;
                border-radius: 20px;
                background: linear-gradient(90deg, #1c1a1e 0%, #1c1a1e 20%, var(--tm-peach-strong) 100%);
                border: 1px solid var(--tm-peach-line);
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 8px 10px;
                pointer-events: auto;
                user-select: none;
                cursor: grab;
                animation: tm-pop-in .22s cubic-bezier(.2, .9, .3, 1.2);
            }

            .tm-floating-alarm.tm-dragging {
                cursor: grabbing;
            }

            .tm-floating-alarm.tm-finished {
                background: linear-gradient(90deg, #1c1a1e 0%, #1c1a1e 20%, var(--tm-mint-strong) 100%);
                border-color: var(--tm-mint-line);
            }

            .tm-ring-wrap {
                position: relative;
                width: 48px;
                height: 48px;
                flex-shrink: 0;
            }

            .tm-ring {
                width: 48px;
                height: 48px;
                transform: rotate(-90deg);
            }

            .tm-ring-track {
                fill: none;
                stroke: rgba(255, 106, 31, 0.22);
                stroke-width: 4.5;
            }

            .tm-ring-progress {
                fill: none;
                stroke: var(--tm-peach-strong);
                stroke-width: 4.5;
                stroke-linecap: round;
                transition: stroke-dashoffset .3s linear, stroke .3s ease;
            }

            .tm-floating-alarm.tm-finished .tm-ring-progress {
                stroke: var(--tm-mint-strong);
            }

            .tm-ring-label {
                position: absolute;
                inset: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: 'JetBrains Mono', monospace;
                font-size: 9.5px;
                font-weight: 700;
                color: var(--tm-ink);
                letter-spacing: -.2px;
            }

            .tm-floating-alarm.tm-finished .tm-ring-label {
                color: var(--tm-mint);
            }

            .tm-ring-label svg {
                width: 15px;
                height: 15px;
                animation: tm-finish-pop .3s ease;
            }

            .tm-floating-body {
                flex: 1;
                min-width: 0;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            .tm-floating-title {
                font-size: 13px;
                font-weight: 700;
                color: var(--tm-ink);
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                line-height: 1.25;
            }

            .tm-floating-delete {
                border: none;
                border-radius: 50%;
                width: 24px;
                height: 24px;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                background: rgba(255, 255, 255, 0.15);
                color: #ffffff;
                flex-shrink: 0;
                opacity: 0;
                transition: opacity .15s ease, background .15s ease, color .15s ease;
            }

            .tm-floating-alarm:hover .tm-floating-delete {
                opacity: 1;
            }

            .tm-floating-delete:hover {
                background: rgba(255, 111, 97, 0.2);
                color: var(--tm-coral);
            }

            .tm-floating-delete svg {
                width: 12px;
                height: 12px;
            }

            @keyframes tm-pop-in {
                from { opacity: 0; transform: scale(.85) translateY(6px); }
                to { opacity: 1; transform: scale(1) translateY(0); }
            }

            @keyframes tm-finish-pop {
                0% { transform: scale(.4); opacity: 0; }
                60% { transform: scale(1.15); opacity: 1; }
                100% { transform: scale(1); }
            }

            @keyframes tm-dot-pulse {
                0%, 100% { transform: scale(1); opacity: 1; }
                50% { transform: scale(1.35); opacity: .6; }
            }

            @media (prefers-reduced-motion: reduce) {
                .tm-floating-alarm,
                .tm-ring-wrap,
                .tm-fab-dot,
                .tm-ring-label svg {
                    animation: none !important;
                }
            }
        `;
        document.head.appendChild(style);
    }

    function createUI() {
        if (document.getElementById('tm-alarm-root')) return;

        const root = document.createElement('div');
        root.id = 'tm-alarm-root';

        const fab = document.createElement('button');
        fab.id = 'tm-alarm-fab';
        fab.title = 'Novo alarme';
        fab.setAttribute('aria-label', 'Novo alarme');
        fab.innerHTML = `${ICON_BELL}<span class="tm-fab-dot" id="tm-fab-dot"></span>`;

        const panel = document.createElement('div');
        panel.id = 'tm-alarm-panel';
        panel.innerHTML = `
            <div class="tm-panel-header">
                <div>
                    <div class="tm-panel-title">Alarmes</div>
                </div>
                <button class="tm-panel-close" id="tm-close-panel" title="Fechar" aria-label="Fechar">${ICON_CLOSE}</button>
            </div>
            <label class="tm-field-label">Nome do cliente</label>
            <input id="tm-alarm-name" class="tm-input" type="text" placeholder="Nome:">
            <label class="tm-field-label">Duração</label>
            <input id="tm-alarm-minutes" class="tm-input" type="number" min="1" step="1" placeholder="Minutos:">
            <button id="tm-save-alarm" class="tm-btn-save">Criar alarme</button>
        `;

        const floatingWrap = document.createElement('div');
        floatingWrap.id = 'tm-floating-alarms';

        root.appendChild(floatingWrap);
        root.appendChild(panel);
        root.appendChild(fab);
        document.body.appendChild(root);

        fab.addEventListener('click', () => {
            panel.classList.toggle('tm-show');
        });

        panel.querySelector('#tm-close-panel').addEventListener('click', () => {
            panel.classList.remove('tm-show');
        });

        panel.querySelector('#tm-save-alarm').addEventListener('click', () => {
            const nameEl = panel.querySelector('#tm-alarm-name');
            const minutesEl = panel.querySelector('#tm-alarm-minutes');

            const title = (nameEl.value || '').trim();
            const minutesValue = Number(minutesEl.value);

            if (!title) {
                alert('Preencha o nome do cliente.');
                return;
            }

            if (!Number.isFinite(minutesValue) || minutesValue <= 0) {
                alert('Digite uma quantidade de minutos válida.');
                return;
            }

            const now = Date.now();
            const durationMs = Math.floor(minutesValue * 60 * 1000);
            const id = 'alarm_' + now + '_' + Math.random().toString(36).slice(2, 8);
            const defaultPos = getDefaultPosition(alarms.length);

            alarms.push({
                id,
                title,
                minutes: minutesValue,
                createdAt: now,
                endAt: now + durationMs,
                finished: false,
                left: defaultPos.left,
                top: defaultPos.top
            });

            saveAlarms();
            renderFloatingAlarmBalloons();
            updateFabDot();

            nameEl.value = '';
            minutesEl.value = '';

            panel.classList.remove('tm-show');
        });

        updateFabDot();
    }

    function getDefaultPosition(index = 0) {
        return {
            left: Math.max(20, window.innerWidth - 240),
            top: Math.max(20, window.innerHeight - 160 - (index * 74))
        };
    }

    function updateFabDot() {
        const dot = document.getElementById('tm-fab-dot');
        if (!dot) return;
        const anyFinished = alarms.some(a => a.finished);
        dot.style.display = anyFinished ? 'block' : 'none';
    }

    function renderFloatingAlarmBalloons() {
        const wrap = document.getElementById('tm-floating-alarms');
        if (!wrap) return;

        wrap.innerHTML = '';

        alarms.forEach(alarm => {
            const box = document.createElement('div');
            box.className = 'tm-floating-alarm';
            box.dataset.id = alarm.id;
            box.style.left = (Number.isFinite(alarm.left) ? alarm.left : 20) + 'px';
            box.style.top = (Number.isFinite(alarm.top) ? alarm.top : 20) + 'px';
            box.style.zIndex = String(++zIndexCounter);

            box.innerHTML = `
                <div class="tm-ring-wrap">
                    <svg class="tm-ring" viewBox="0 0 48 48">
                        <circle class="tm-ring-track" cx="24" cy="24" r="${FLOAT_RING_RADIUS}"></circle>
                        <circle class="tm-ring-progress" cx="24" cy="24" r="${FLOAT_RING_RADIUS}"
                            stroke-dasharray="${FLOAT_RING_CIRC}" stroke-dashoffset="0"></circle>
                    </svg>
                    <div class="tm-ring-label">00:00</div>
                </div>
                <div class="tm-floating-body">
                    <div class="tm-floating-title">${escapeHtml(alarm.title)}</div>
                </div>
                <button class="tm-floating-delete" title="Excluir" aria-label="Excluir alarme">${ICON_CLOSE}</button>
            `;

            setupDrag(box, alarm.id);

            box.addEventListener('mousedown', () => {
                box.style.zIndex = String(++zIndexCounter);
            });

            box.querySelector('.tm-floating-delete').addEventListener('click', (e) => {
                e.stopPropagation();
                removeAlarm(alarm.id);
            });

            wrap.appendChild(box);
        });

        updateCountdowns();
    }

    function setupDrag(box, alarmId) {
        box.addEventListener('mousedown', (e) => {
            if (e.target.closest('.tm-floating-delete')) return;

            const rect = box.getBoundingClientRect();

            dragState = {
                alarmId,
                box,
                offsetX: e.clientX - rect.left,
                offsetY: e.clientY - rect.top
            };

            box.classList.add('tm-dragging');
            e.preventDefault();
        });
    }

    document.addEventListener('mousemove', (e) => {
        if (!dragState) return;

        const box = dragState.box;
        const width = box.offsetWidth;
        const height = box.offsetHeight;

        let left = e.clientX - dragState.offsetX;
        let top = e.clientY - dragState.offsetY;

        left = Math.max(0, Math.min(left, window.innerWidth - width));
        top = Math.max(0, Math.min(top, window.innerHeight - height));

        box.style.left = left + 'px';
        box.style.top = top + 'px';
    });

    document.addEventListener('mouseup', () => {
        if (!dragState) return;

        const { alarmId, box } = dragState;
        box.classList.remove('tm-dragging');

        const alarm = alarms.find(a => a.id === alarmId);
        if (alarm) {
            alarm.left = parseInt(box.style.left, 10) || 0;
            alarm.top = parseInt(box.style.top, 10) || 0;
            saveAlarms();
        }

        dragState = null;
    });

    function removeAlarm(alarmId) {
        alarms = alarms.filter(a => a.id !== alarmId);
        saveAlarms();
        renderFloatingAlarmBalloons();
        updateFabDot();
    }

    function startWatcher() {
        updateCountdowns();

        setInterval(() => {
            updateCountdowns();
        }, 1000);

        window.addEventListener('resize', keepBalloonsInsideScreen);
    }

    function keepBalloonsInsideScreen() {
        let changed = false;

        alarms.forEach(alarm => {
            const width = 188;
            const height = 66;

            if (!Number.isFinite(alarm.left)) {
                alarm.left = 20;
                changed = true;
            }

            if (!Number.isFinite(alarm.top)) {
                alarm.top = 20;
                changed = true;
            }

            const maxLeft = Math.max(0, window.innerWidth - width);
            const maxTop = Math.max(0, window.innerHeight - height);

            const newLeft = Math.min(Math.max(0, alarm.left), maxLeft);
            const newTop = Math.min(Math.max(0, alarm.top), maxTop);

            if (newLeft !== alarm.left || newTop !== alarm.top) {
                alarm.left = newLeft;
                alarm.top = newTop;
                changed = true;
            }
        });

        if (changed) {
            saveAlarms();
            renderFloatingAlarmBalloons();
        }
    }

    function updateCountdowns() {
        let changed = false;
        const now = Date.now();

        alarms.forEach(alarm => {
            const box = document.querySelector(`.tm-floating-alarm[data-id="${cssEscape(alarm.id)}"]`);
            if (!box) return;

            const labelEl = box.querySelector('.tm-ring-label');
            const progressEl = box.querySelector('.tm-ring-progress');

            const totalMs = Math.max(1, alarm.endAt - alarm.createdAt);
            const remainingMs = alarm.endAt - now;
            const fraction = Math.min(1, Math.max(0, remainingMs / totalMs));

            if (remainingMs <= 0) {
                progressEl.style.strokeDashoffset = '0';
                labelEl.innerHTML = ICON_CHECK;
                box.classList.add('tm-finished');

                if (!alarm.finished) {
                    alarm.finished = true;
                    changed = true;
                }
            } else {
                progressEl.style.strokeDashoffset = String(FLOAT_RING_CIRC * (1 - fraction));
                labelEl.textContent = formatRemaining(remainingMs);
                box.classList.remove('tm-finished');

                if (alarm.finished) {
                    alarm.finished = false;
                    changed = true;
                }
            }
        });

        if (changed) {
            saveAlarms();
            updateFabDot();
        }
    }

    function formatRemaining(ms) {
        const totalSeconds = Math.max(0, Math.floor(ms / 1000));
        const minutes = Math.floor(totalSeconds / 60);
        const seconds = totalSeconds % 60;

        return (
            String(minutes).padStart(2, '0') +
            ':' +
            String(seconds).padStart(2, '0')
        );
    }

    function escapeHtml(text) {
        return String(text || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function cssEscape(value) {
        if (window.CSS && typeof window.CSS.escape === 'function') {
            return window.CSS.escape(value);
        }
        return String(value).replace(/"/g, '\\"');
    }
})();
