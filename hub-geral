        `;
        document.head.appendChild(style);
    }

    const ICON_GEAR = `
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z" stroke="currentColor" stroke-width="1.6"/>
            <path d="M19.4 13.5a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1.04 1.56V19.5a2 2 0 1 1-4 0v-.09a1.7 1.7 0 0 0-1.04-1.56 1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.7 1.7 0 0 0 .34-1.87 1.7 1.7 0 0 0-1.56-1.04H4.5a2 2 0 1 1 0-4h.09a1.7 1.7 0 0 0 1.56-1.04 1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.7 1.7 0 0 0 1.87.34H10.5a1.7 1.7 0 0 0 1.04-1.56V4.5a2 2 0 1 1 4 0v.09a1.7 1.7 0 0 0 1.04 1.56 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.7 1.7 0 0 0-.34 1.87V10.5a1.7 1.7 0 0 0 1.56 1.04h.09a2 2 0 1 1 0 4h-.09a1.7 1.7 0 0 0-1.56 1.04Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
        </svg>`;

    function criarPainelMaster() {
        injetarEstilosPainel();

        const fab = document.createElement('button');
        fab.id = 'tmm-fab';
        fab.title = 'Meus scripts';
        fab.setAttribute('aria-label', 'Meus scripts');
        fab.innerHTML = ICON_GEAR;
        document.body.appendChild(fab);

        const overlay = document.createElement('div');
        overlay.id = 'tmm-overlay';
        overlay.innerHTML = `
            <div id="tmm-modal">
                <div id="tmm-modal-header">
                    <div id="tmm-modal-title">Meus scripts</div>
                    <button id="tmm-modal-close" title="Fechar" aria-label="Fechar">✕</button>
                </div>
                <div id="tmm-lista"></div>

                <button id="tmm-add-btn">+ Adicionar novo script</button>

                <div id="tmm-add-form">
                    <label for="tmm-form-nome">Nome do script</label>
                    <input type="text" id="tmm-form-nome" placeholder="Ex: Ocultar banners">

                    <label for="tmm-form-codigo">Código (deve retornar um objeto com init() e destroy())</label>
                    <textarea id="tmm-form-codigo" spellcheck="false" placeholder="{
    init() {
        // código que liga o script
    },
    destroy() {
        // código que desfaz o que o init() fez
    }
}"></textarea>

                    <div class="tmm-checkbox-linha">
                        <input type="checkbox" id="tmm-form-auto">
                        <label for="tmm-form-auto" style="cursor:pointer;">Ativar automaticamente ao carregar a página</label>
                    </div>

                    <div id="tmm-form-erro"></div>

                    <div class="tmm-form-botoes">
                        <button id="tmm-form-salvar">Salvar</button>
                        <button id="tmm-form-cancelar">Cancelar</button>
                    </div>
                </div>
            </div>
        `;
        document.body.appendChild(overlay);

        const lista = overlay.querySelector('#tmm-lista');

        function criarLinhaModulo(mod) {
            const estado = carregarEstado();
            const ligado = (estado[mod.id] !== undefined) ? estado[mod.id] : mod.defaultOn;

            const item = document.createElement('div');
            item.className = 'tmm-item';
            item.dataset.id = mod.id;

            const checkboxId = 'tmm-check-' + mod.id;

            item.innerHTML = `
                <input type="checkbox" id="${checkboxId}" ${ligado ? 'checked' : ''}>
                <label for="${checkboxId}">${mod.name}</label>
                ${mod.fixo ? '' : '<button class="tmm-item-del" title="Excluir">✕</button>'}
            `;

            item.querySelector('input').addEventListener('change', (e) => {
                alternarModulo(mod.id, e.target.checked);
            });

            if (!mod.fixo) {
                item.querySelector('.tmm-item-del').addEventListener('click', () => {
                    excluirModuloCustom(mod.id);
                });
            }

            return item;
        }

        function renderizarLista() {
            lista.innerHTML = '';
            modulos.forEach(mod => {
                lista.appendChild(criarLinhaModulo(mod));
            });
        }

        function excluirModuloCustom(id) {
            const mod = modulos.find(m => m.id === id);
            if (!mod || mod.fixo) return;

            desligarModulo(mod);
            removerModuloDoRegistro(id);

            const estado = carregarEstado();
            delete estado[id];
            salvarEstado(estado);

            const listaCustom = carregarScriptsCustom().filter(s => s.id !== id);
            salvarScriptsCustom(listaCustom);

            renderizarLista();
        }

        renderizarLista();

        // ---- botão "+" e formulário de adição ----
        const btnAdd = overlay.querySelector('#tmm-add-btn');
        const form = overlay.querySelector('#tmm-add-form');
        const campoNome = overlay.querySelector('#tmm-form-nome');
        const campoCodigo = overlay.querySelector('#tmm-form-codigo');
        const campoAuto = overlay.querySelector('#tmm-form-auto');
        const campoErro = overlay.querySelector('#tmm-form-erro');
        const btnSalvar = overlay.querySelector('#tmm-form-salvar');
        const btnCancelar = overlay.querySelector('#tmm-form-cancelar');

        function limparFormulario() {
            campoNome.value = '';
            campoCodigo.value = '';
            campoAuto.checked = false;
            campoErro.style.display = 'none';
            campoErro.textContent = '';
        }

        btnAdd.addEventListener('click', () => {
            form.classList.toggle('tmm-show-form');
        });

        btnCancelar.addEventListener('click', () => {
            limparFormulario();
            form.classList.remove('tmm-show-form');
        });

        btnSalvar.addEventListener('click', () => {
            const nome = campoNome.value.trim();
            const codigo = campoCodigo.value.trim();

            if (!nome) {
                campoErro.textContent = 'Dê um nome para o script.';
                campoErro.style.display = 'block';
                return;
            }
            if (!codigo) {
                campoErro.textContent = 'Cole o código do script.';
                campoErro.style.display = 'block';
                return;
            }

            // Testa se o código é válido e retorna um objeto com init()
            // antes de salvar, para evitar guardar algo quebrado.
            try {
                const fabrica = new Function('"use strict"; return (' + codigo + ');');
                const teste = fabrica();
                if (!teste || typeof teste.init !== 'function') {
                    throw new Error('O código precisa retornar um objeto com um método init().');
                }
            } catch (erro) {
                campoErro.textContent = 'Código inválido: ' + erro.message;
                campoErro.style.display = 'block';
                return;
            }

            const novoItem = {
                id: 'custom_' + Date.now(),
                name: nome,
                code: codigo,
                ativarAuto: campoAuto.checked
            };

            const listaCustom = carregarScriptsCustom();
            listaCustom.push(novoItem);
            salvarScriptsCustom(listaCustom);

            const novoModulo = criarModuloCustom(novoItem);
            registrarModulo(novoModulo);

            if (novoItem.ativarAuto) {
                alternarModulo(novoModulo.id, true);
            }

            limparFormulario();
            form.classList.remove('tmm-show-form');
            renderizarLista();
        });

        fab.addEventListener('click', () => {
            overlay.classList.add('tmm-show');
        });

        overlay.addEventListener('click', (e) => {
            if (e.target === overlay) {
                overlay.classList.remove('tmm-show');
            }
        });

        overlay.querySelector('#tmm-modal-close').addEventListener('click', () => {
            overlay.classList.remove('tmm-show');
        });
    }

    // =========================================================================
    // INICIALIZAÇÃO
    // =========================================================================
    criarPainelMaster();
    aplicarEstadoInicial();

})();
