            });
            botao.addEventListener('mouseleave', () => {
                botao.style.transform = 'none';
                botao.style.boxShadow = '0 6px 16px rgba(16, 185, 129, 0.35)';
            });

            botao.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();

                const textoBruto = div.innerText;
                const dados = formatarTrechos(textoBruto);

                // Copia para a área de transferência
                if (typeof GM_setClipboard !== 'undefined') {
                    GM_setClipboard(dados, 'text');
                } else {
                    navigator.clipboard.writeText(dados);
                }

                const textoOriginal = botao.textContent;
                botao.textContent = 'Copiado!';
                setTimeout(() => {
                    botao.textContent = textoOriginal;
                }, 1500);
            });

            // Siglas válidas de UF brasileiras, usadas para achar com segurança o ponto onde a UF
            // da origem termina e a próxima cidade começa (quando estão coladas sem espaço).
            const UFS = ['AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB',
                'PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO'];
            const UF_ALT = UFS.join('|');

            // Acha o ponto de corte entre origem e destino dentro de uma linha "Trecho ..." em que
            // os dois nomes vêm colados, sem separador (ex: "...- CESOBRAL - CE" ou
            // "...Olímpica)BELO HORIZONTE - MG"). Existem dois padrões possíveis de colagem:
            //  1) UF válida colada direto na cidade seguinte, ex: "- CE" + "SOBRAL"
            //  2) Parênteses fechando colado direto na cidade seguinte, ex: "Olímpica)" + "BELO"
            // Usa o que aparecer primeiro no texto (nem toda origem tem UF própria, como no caso
            // de "Rio de Janeiro (RIO2 - Barra Olímpica)", que não tem "- UF" antes do destino).
            function dividirOrigemDestino(texto) {
                const regexUFGrudada = new RegExp(`\\s-\\s(?:${UF_ALT})(?=[A-Za-zÀ-ÿ])`);
                const matchUF = texto.match(regexUFGrudada);

                const regexParenGrudado = /\)(?=[A-ZÀ-Ü])/;
                const matchParen = texto.match(regexParenGrudado);

                const corteUF = matchUF ? matchUF.index + matchUF[0].length : -1;
                const corteParen = matchParen ? matchParen.index + 1 : -1;

                let corte = -1;
                if (corteUF !== -1 && corteParen !== -1) {
                    corte = Math.min(corteUF, corteParen);
                } else if (corteUF !== -1) {
                    corte = corteUF;
                } else if (corteParen !== -1) {
                    corte = corteParen;
                }

                if (corte === -1) return null;

                return {
                    origemTexto: texto.slice(0, corte).trim(),
                    destinoTexto: texto.slice(corte).trim()
                };
            }

            // Normaliza um texto de local para comparação (maiúsculas, sem espaços duplicados)
            function normalizarLocal(texto) {
                return String(texto || '').trim().toUpperCase().replace(/\s+/g, ' ');
            }

            // Extrai os trechos (origem/destino) e as datas de IDA/VOLTA do texto bruto
            function formatarTrechos(texto) {
                const linhas = texto.split('\n').map(l => l.trim()).filter(Boolean);

                const blocos = [];
                let atual = null;

                linhas.forEach(linha => {
                    if (linha.startsWith('Trecho ')) {
                        if (atual) blocos.push(atual);
                        // Remove o prefixo "Trecho " para não atrapalhar a divisão origem/destino
                        atual = { linha: linha.replace(/^Trecho\s+/, '').trim(), data: null };
                    } else if (atual && !atual.data && /^\d{2}\/\d{2}\/\d{4}$/.test(linha)) {
                        atual.data = linha;
                    }
                });
                if (atual) blocos.push(atual);

                const trechos = blocos.map(bloco => {
                    const divisao = dividirOrigemDestino(bloco.linha);
                    if (!divisao) return null;
                    return { origem: divisao.origemTexto, destino: divisao.destinoTexto, data: bloco.data };
                }).filter(t => t && t.origem && t.destino);

                if (trechos.length === 0) {
                    return texto.trim(); // fallback: se não conseguir identificar, copia o texto bruto
                }

                const primeiro = trechos[0];
                const ultimo = trechos[trechos.length - 1];

                // É ida e volta de verdade só se o destino do último trecho voltar pra origem do
                // primeiro (fecha o ciclo). Se não fechar, é uma conexão: junta origem do 1º com
                // destino do último e usa só a data de IDA.
                const ehIdaEVolta = trechos.length === 2 &&
                    normalizarLocal(ultimo.destino) === normalizarLocal(primeiro.origem);

                let resultado;

                if (ehIdaEVolta) {
                    resultado = `TRECHO: ${primeiro.origem} para ${primeiro.destino}\n\n`;
                    resultado += `IDA: ${primeiro.data || '-'}`;
                    resultado += `\nVOLTA: ${trechos[1].data || '-'}`;
                } else {
                    resultado = `TRECHO: ${primeiro.origem} para ${ultimo.destino}\n\n`;
                    resultado += `IDA: ${primeiro.data || '-'}`;
                }

                return resultado;
            }

            div.appendChild(botao);
            return true;
        }

        function criarTextareaEBotaoPreencher() {
            const div = document.querySelectorAll('.col-button-only')[2];

            if (!div) {
                return false;
            }

            if (div.querySelector('.tm-preencher-area')) {
