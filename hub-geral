// ==UserScript==
// @name         Painel de Scripts (Unificado)
// @namespace    http://tampermonkey.net/
// @version      1.1.0
// @description  Painel central com botão + modal para ativar/desativar cada script individualmente, e agora com opção de adicionar novos scripts pela própria interface, sem recarregar a página
// @author       Você
// @match        *://*/*
// @grant        GM_setClipboard
// @run-at       document-idle
// ==/UserScript==

(function () {
    'use strict';

    // =========================================================================
    // ARMAZENAMENTO DO ESTADO (quais módulos estão ligados/desligados)
    // =========================================================================
    const STORAGE_KEY_STATE = 'tmm_painel_scripts_state_v1';
    // Armazenamento dos scripts customizados adicionados pelo próprio painel
    const STORAGE_KEY_CUSTOM = 'tmm_painel_scripts_custom_v1';

    function carregarEstado() {
        try {
            const dados = JSON.parse(localStorage.getItem(STORAGE_KEY_STATE) || '{}');
            return (dados && typeof dados === 'object') ? dados : {};
        } catch {
            return {};
        }
    }

    function salvarEstado(estado) {
        localStorage.setItem(STORAGE_KEY_STATE, JSON.stringify(estado));
    }

    function carregarScriptsCustom() {
        try {
            const dados = JSON.parse(localStorage.getItem(STORAGE_KEY_CUSTOM) || '[]');
            return Array.isArray(dados) ? dados : [];
        } catch {
            return [];
        }
    }

    function salvarScriptsCustom(lista) {
        localStorage.setItem(STORAGE_KEY_CUSTOM, JSON.stringify(lista));
    }

    // =========================================================================
    // REGISTRO DE MÓDULOS
    // =========================================================================
    // Cada módulo é um objeto: { id, name, defaultOn, init(), destroy() }
    // init()    -> liga o script (cria elementos, observers, intervals etc.)
    // destroy() -> desliga o script (remove tudo que o init() criou)
    const modulos = [];

    function registrarModulo(mod) {
        mod._ativo = false;
        modulos.push(mod);
    }

    function removerModuloDoRegistro(id) {
        const idx = modulos.findIndex(m => m.id === id);
        if (idx !== -1) modulos.splice(idx, 1);
    }

    function ligarModulo(mod) {
        if (mod._ativo) return;
        try {
            mod.init();
            mod._ativo = true;
        } catch (erro) {
            console.error('[Painel de Scripts] Erro ao ligar "' + mod.name + '":', erro);
            alert('Erro ao ligar "' + mod.name + '":\n' + erro.message);
        }
    }

    function desligarModulo(mod) {
        if (!mod._ativo) return;
        try {
            mod.destroy();
        } catch (erro) {
            console.error('[Painel de Scripts] Erro ao desligar "' + mod.name + '":', erro);
        }
        mod._ativo = false;
    }

    function alternarModulo(id, ligado) {
        const mod = modulos.find(m => m.id === id);
        if (!mod) return;

        const estado = carregarEstado();
        estado[id] = ligado;
        salvarEstado(estado);

        if (ligado) {
            ligarModulo(mod);
        } else {
            desligarModulo(mod);
        }
    }

    function aplicarEstadoInicial() {
        const estado = carregarEstado();

        modulos.forEach(mod => {
            const ligado = (estado[mod.id] !== undefined) ? estado[mod.id] : mod.defaultOn;
            if (ligado) ligarModulo(mod);
        });
    }

    // =========================================================================
    // MÓDULO 1 — Botão Aplicar Desconto Dinâmico
    // =========================================================================
    function criarModuloDesconto() {
        const BOTAO_ID = 'btn-aplicar-desconto-custom';
        const TITULO_MODAL = 'Incluir códigos promocionais';
        const CODIGO = 'idaevolta10';

        let observer = null;

        function preencherCodigos() {
            let total = 0;

            document.querySelectorAll('label').forEach(label => {
                if (!label.textContent.toLowerCase().includes('código promocional')) return;

                // Procura o input dentro do mesmo bloco do label
                let bloco = label.parentElement;
                while (bloco && !bloco.querySelector('input')) {
                    bloco = bloco.parentElement;
                }
                if (!bloco) return;

                const input = bloco.querySelector('input');
                if (!input) return;

                try {
                    const setter = Object.getOwnPropertyDescriptor(
                        HTMLInputElement.prototype,
                        'value'
                    ).set;
                    setter.call(input, CODIGO);
                } catch {
                    input.value = CODIGO;
                }

                input.dispatchEvent(new Event('input', { bubbles: true }));
                input.dispatchEvent(new Event('change', { bubbles: true }));
                input.dispatchEvent(new KeyboardEvent('keyup', { bubbles: true }));
                total++;
            });

            console.log(`[Desconto] Preenchidos ${total} códigos promocionais.`);
        }

        function criarBotaoDesconto(container) {
            if (document.getElementById(BOTAO_ID)) return;

            const btn = document.createElement('button');
            btn.id = BOTAO_ID;
            btn.textContent = 'Aplicar Desconto';
            btn.style.marginTop = '10px';
            btn.style.padding = '8px 18px';
            btn.style.background = '#28a745';
            btn.style.color = '#fff';
            btn.style.border = 'none';
            btn.style.borderRadius = '5px';
            btn.style.cursor = 'pointer';
            btn.style.fontWeight = 'bold';
            btn.style.fontSize = '14px';
            btn.addEventListener('click', preencherCodigos);
            container.appendChild(btn);
        }

        function verificarEAtualizar() {
            const titulo = [...document.querySelectorAll('.h3-lightbox-title')]
                .find(el => el.textContent.trim().includes(TITULO_MODAL));

            if (titulo) {
                criarBotaoDesconto(titulo.parentElement);
            } else {
                document.getElementById(BOTAO_ID)?.remove();
            }
        }

        return {
            id: 'desconto',
            name: 'Botão Aplicar Desconto Dinâmico',
            defaultOn: true,
            fixo: true, // módulo embutido no código-fonte, não pode ser excluído pelo painel

            init() {
                observer = new MutationObserver(verificarEAtualizar);
                observer.observe(document.body, { childList: true, subtree: true });
                verificarEAtualizar();
            },

            destroy() {
                if (observer) {
                    observer.disconnect();
                    observer = null;
                }
                document.getElementById(BOTAO_ID)?.remove();
            }
        };
    }

    registrarModulo(criarModuloDesconto());

    // =========================================================================
    // MÓDULO 2 — Alerta de Atraso na Fila (30 min / Tallos)
    // =========================================================================
    function criarModuloTallos() {
        // ⚙️ CONFIGURAÇÕES (EDITÁVEL PELO USUÁRIO)
        const CONFIG = {
            TEMPO_LIMITE_MINUTOS: 30, // Tempo em minutos para o alerta

            // Se quiser usar imagens próprias, cole o link abaixo (ex: "https://site.com/foto.png").
            // Deixado em branco: o script usa apenas a cor da bolinha (verde = ok, vermelho = atraso).
            URL_IMAGEM_NORMAL: "",
            URL_IMAGEM_ALERTA: ""
        };

        const TEMPO_LIMITE_MS = CONFIG.TEMPO_LIMITE_MINUTOS * 60 * 1000;

        let quantidadeAtrasadosAnterior = 0;
        let styleEl = null;
        let wrapperUI = null;
        let bubbleUI = null;
        let popupUI = null;
        let listaUI = null;
        let badgeUI = null;
        let intervalId = null;
        let timeoutId = null;
        let handleBubbleClick = null;
        let handleDocumentClick = null;

        function varrerFilaLateral() {
            const todosElementos = document.querySelectorAll('*');
            const horariosEncontrados = [];
            const clientesAtrasados = [];
            const agora = Date.now();

            for (let el of todosElementos) {
                if (el.children.length === 0 && el.offsetParent) {
                    const rect = el.getBoundingClientRect();

                    if (rect.left >= 230 && rect.left < 400 && rect.top > 80 && rect.width > 0) {
                        const txt = el.textContent.trim();
                        if (txt.length > 10) continue;
                        const match = txt.match(/^([0-2]?[0-9]):([0-5][0-9])\s*(AM|PM)?$/i);

                        if (match) {
                            horariosEncontrados.push({ el, txt, match, rect });
                        }
                    }
                }
            }

            horariosEncontrados.forEach(item => {
                let hora = parseInt(item.match[1], 10);
                const min = parseInt(item.match[2], 10);
                const ampm = item.match[3] ? item.match[3].toUpperCase() : null;

                if (ampm) {
                    if (ampm === 'PM' && hora < 12) hora += 12;
                    if (ampm === 'AM' && hora === 12) hora = 0;
                }

                const dataReal = new Date();
                dataReal.setHours(hora, min, 0, 0);

                if (dataReal.getTime() > agora) {
                    dataReal.setDate(dataReal.getDate() - 1);
                }

                const tempoDecorrido = agora - dataReal.getTime();

                if (tempoDecorrido >= TEMPO_LIMITE_MS) {
                    let nomeDoCliente = "Cliente Oculto";
                    let elementoFisicoOriginal = null;
                    let menorDistanciaX = 999;

                    for (let elNome of todosElementos) {
                        if (elNome === item.el || elNome.children.length > 0 || !elNome.offsetParent) continue;
                        const rectNome = elNome.getBoundingClientRect();

                        if (rectNome.left > 75 && rectNome.left < 260 && Math.abs(rectNome.top - item.rect.top) < 25) {
                            const txtNome = elNome.textContent.trim();
                            const txtNomeUpper = txtNome.toUpperCase();

                            const ignorar = [
                                'DASHBOARD', 'CONTATOS', 'RELATÓRIOS', 'CONFIGURAÇÕES', 'MENSAGENS',
                                'SETOR', 'SETORES', 'CANAIS', 'MEUS ATENDIMENTOS', 'MAIS RECENTE',
                                'BUSCAR', 'TRANSFERIR', 'ENCERRAR', 'PERFIL', 'ETIQUETAS', 'ATIVIDADES',
                                'FUNIL', 'FUNIS', 'CARTEIRAS', 'HISTÓRICO', 'BUSCAR POR CONTATO',
                                'INÍCIO', 'CHAT', 'AUTOMAÇÃO', 'ANALISAR', 'INVISÍVEL',
                                'OPERADORES', 'FILA DE ESPERA', 'CHATBOT', 'TODOS', 'NÃO LIDAS'
                            ];

                            const isTermoProibido = ignorar.some(termo => txtNomeUpper === termo || txtNomeUpper.includes(termo));

                            if (txtNome.length > 2 && !txtNome.match(/\d{2}:\d{2}/) && !isTermoProibido) {
                                if (rectNome.left < menorDistanciaX) {
                                    menorDistanciaX = rectNome.left;
                                    nomeDoCliente = txtNome;
                                    elementoFisicoOriginal = elNome;
                                }
                            }
                        }
                    }

                    const tempoAbsoluto = Math.abs(tempoDecorrido);
                    const horas = Math.floor(tempoAbsoluto / 3600000);
                    const minutos = Math.floor((tempoAbsoluto % 3600000) / 60000);
                    let tempoTexto = horas > 0 ? `${horas}h ${minutos}m` : `${minutos} min`;

                    if (nomeDoCliente !== "Cliente Oculto") {
                        clientesAtrasados.push({
                            nome: nomeDoCliente,
                            atraso: tempoTexto,
                            elementoAlvo: elementoFisicoOriginal
                        });
                    }
                }
            });

            listaUI.innerHTML = '';

            if (clientesAtrasados.length > 0) {
                const clientesUnicos = [...new Map(clientesAtrasados.map(c => [c.nome, c])).values()];
                const quantidadeAtual = clientesUnicos.length;

                quantidadeAtrasadosAnterior = quantidadeAtual;

                clientesUnicos.forEach(cliente => {
                    const li = document.createElement('li');
                    li.className = 'tallos-client-item';
                    li.innerHTML = `
                        <span class="tallos-client-name" title="${cliente.nome}">${cliente.nome}</span>
                        <span class="tallos-client-time">${cliente.atraso}</span>
                    `;

                    li.addEventListener('click', () => {
                        if (cliente.elementoAlvo) {
                            cliente.elementoAlvo.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            cliente.elementoAlvo.click();
                            popupUI.classList.remove('show');
                        }
                    });

                    listaUI.appendChild(li);
                });

                bubbleUI.classList.add('has-alerts');
                badgeUI.innerText = quantidadeAtual;

            } else {
                bubbleUI.classList.remove('has-alerts');
                popupUI.classList.remove('show');
                quantidadeAtrasadosAnterior = 0;
            }
        }

        return {
            id: 'tallos_30min',
            name: '30 min — Alerta de Atraso na Fila (Tallos)',
            defaultOn: true,
            fixo: true, // módulo embutido no código-fonte, não pode ser excluído pelo painel

            init() {
                // este widget só faz sentido dentro do Tallos — em qualquer outro
                // site o toggle liga "no papel", mas não desenha nada na tela
                if (!location.hostname.includes('tallos.com.br')) return;

                styleEl = document.createElement('style');
                styleEl.innerHTML = `
                    #tallos-widget-wrapper {
                        position: fixed;
                        right: 464px;
                        top: 8px;
                        z-index: 999999;
                        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                    }

                    .tallos-bubble {
                        width: 45px;
                        height: 45px;
                        background: linear-gradient(150deg, #2ee69a, #10b981);
                        border-radius: 50%;
                        display: flex;
                        justify-content: center;
                        align-items: center;
                        color: #14211b;
                        cursor: pointer;
                        user-select: none;
                        position: relative;
                    }
                    .tallos-bubble:hover {
                        transform: translateY(-2px) scale(1.05);
                    }
                    .tallos-bubble:active { transform: scale(0.95); }

                    .tallos-bubble.has-alerts {
                        background: linear-gradient(150deg, #ff6b6b, #ef4444);
                        color: #241414;
                        animation: tallosPulseBubble 2s infinite;
                    }

                    @keyframes tallosPulseBubble {
                        0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.5); }
                        70% { box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
                        100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
                    }

                    .tallos-custom-img {
                        width: 100%;
                        height: 100%;
                        object-fit: cover;
                        border-radius: 50%;
                        pointer-events: none;
                    }

                    .tallos-badge {
                        position: absolute;
                        top: -2px;
                        right: -2px;
                        background: #232025;
                        color: #ff6a1f;
                        font-size: 12px;
                        font-weight: 800;
                        width: 22px;
                        height: 22px;
                        border-radius: 50%;
                        display: flex;
                        justify-content: center;
                        align-items: center;
                        border: 1.5px solid rgba(255, 106, 31, 0.4);
                        opacity: 0;
                        transform: scale(0);
                        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                        z-index: 2;
                    }
                    .tallos-bubble.has-alerts .tallos-badge {
                        opacity: 1;
                        transform: scale(1);
                    }

                    .tallos-popup-menu {
                        position: absolute;
                        top: 60px;
                        right: 0;
                        width: 240px;
                        background: #1c1a1e;
                        border-radius: 16px;
                        border: 1px solid rgba(255, 106, 31, 0.3);
                        overflow: hidden;

                        opacity: 0;
                        visibility: hidden;
                        transform: translateY(-15px) scale(0.95);
                        transform-origin: top right;
                        transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                    }
                    .tallos-popup-menu.show {
                        opacity: 1;
                        visibility: visible;
                        transform: translateY(0) scale(1);
                    }

                    .tallos-popup-header {
                        background: #232025;
                        border-bottom: 1px solid rgba(255, 106, 31, 0.25);
                        padding: 10px 14px;
                        color: #a89d94;
                        font-size: 12px;
                        font-weight: 700;
                        text-transform: uppercase;
                        letter-spacing: 0.5px;
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                    }

                    .tallos-client-list {
                        list-style: none;
                        margin: 0;
                        padding: 6px;
                        max-height: 220px;
                        overflow-y: auto;
                    }
                    .tallos-client-list::-webkit-scrollbar { width: 4px; }
                    .tallos-client-list::-webkit-scrollbar-thumb { background: #3a3640; border-radius: 10px; }

                    .tallos-client-item {
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                        padding: 8px 10px;
                        border-radius: 8px;
                        margin-bottom: 2px;
                        transition: all 0.2s ease;
                        cursor: pointer;
                        border: 1px solid transparent;
                    }
                    .tallos-client-item:hover {
                        background: rgba(255, 106, 31, 0.12);
                        border-color: rgba(255, 106, 31, 0.3);
                    }

                    .tallos-client-name {
                        font-size: 12px;
                        color: #f3ece6;
                        font-weight: 600;
                        white-space: nowrap;
                        overflow: hidden;
                        text-overflow: ellipsis;
                        max-width: 140px;
                    }

                    .tallos-client-time { font-size: 10px; color: #ff6a1f; font-weight: 700; }

                    .icon-ok { display: block; }
                    .icon-alert { display: none; }
                    .tallos-bubble.has-alerts .icon-ok { display: none; }
                    .tallos-bubble.has-alerts .icon-alert { display: block; }
                `;
                document.head.appendChild(styleEl);

                const iconeNormalHTML = CONFIG.URL_IMAGEM_NORMAL !== ""
                    ? `<img src="${CONFIG.URL_IMAGEM_NORMAL}" class="icon-ok tallos-custom-img">`
                    : `<svg class="icon-ok" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`;

                const iconeAlertaHTML = CONFIG.URL_IMAGEM_ALERTA !== ""
                    ? `<img src="${CONFIG.URL_IMAGEM_ALERTA}" class="icon-alert tallos-custom-img">`
                    : `<svg class="icon-alert" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18"/></svg>`;

                wrapperUI = document.createElement('div');
                wrapperUI.id = 'tallos-widget-wrapper';
                wrapperUI.innerHTML = `
                    <div class="tallos-popup-menu" id="tallos-popup">
                        <div class="tallos-popup-header">
                            Atrasos na Fila
                            <span style="color: #ef4444; font-size: 14px;">⚠️</span>
                        </div>
                        <ul class="tallos-client-list" id="tallos-lista-clientes"></ul>
                    </div>

                    <div class="tallos-bubble" id="tallos-bubble">
                        ${iconeNormalHTML}
                        ${iconeAlertaHTML}
                        <div class="tallos-badge" id="tallos-badge">0</div>
                    </div>
                `;
                document.body.appendChild(wrapperUI);

                bubbleUI = wrapperUI.querySelector('#tallos-bubble');
                popupUI = wrapperUI.querySelector('#tallos-popup');
                listaUI = wrapperUI.querySelector('#tallos-lista-clientes');
                badgeUI = wrapperUI.querySelector('#tallos-badge');

                handleBubbleClick = function () {
                    if (bubbleUI.classList.contains('has-alerts')) {
                        popupUI.classList.toggle('show');
                    }
                };
                bubbleUI.addEventListener('click', handleBubbleClick);

                handleDocumentClick = function (e) {
                    if (!wrapperUI.contains(e.target)) {
                        popupUI.classList.remove('show');
                    }
                };
                document.addEventListener('click', handleDocumentClick);

                quantidadeAtrasadosAnterior = 0;
                timeoutId = setTimeout(varrerFilaLateral, 1000);
                intervalId = setInterval(varrerFilaLateral, 5000);
            },

            destroy() {
                if (intervalId) clearInterval(intervalId);
                if (timeoutId) clearTimeout(timeoutId);
                intervalId = null;
                timeoutId = null;

                if (handleDocumentClick) document.removeEventListener('click', handleDocumentClick);
                handleDocumentClick = null;
                handleBubbleClick = null;

                wrapperUI?.remove();
                styleEl?.remove();
                wrapperUI = null;
                styleEl = null;
                bubbleUI = null;
                popupUI = null;
                listaUI = null;
                badgeUI = null;
            }
        };
    }

    registrarModulo(criarModuloTallos());

    // =========================================================================
    // MÓDULO 3 — Alarme (cartões flutuantes arrastáveis com cronômetro)
    // =========================================================================
    function criarModuloAlarme() {
        const STORAGE_KEY = 'tm_floating_minute_alarms_v340';

        // --- Geometria dos anéis de progresso -----------------------------------
        const FLOAT_RING_RADIUS = 21;
        const FLOAT_RING_CIRC = 2 * Math.PI * FLOAT_RING_RADIUS;

        // --- Ícones (SVG inline, sem dependências externas) ---------------------
        const ICON_BELL = `
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 3.5c-3.2 0-5.2 2.3-5.2 5.6v2.3c0 1-.4 2-1.1 2.8l-.9 1c-.6.6-.2 1.7.7 1.7h13.9c.9 0 1.3-1.1.7-1.7l-.9-1c-.7-.8-1.1-1.8-1.1-2.8V9.1c0-3.3-2-5.6-5.1-5.6Z"
                    stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                <path d="M9.8 19.5a2.4 2.4 0 0 0 4.4 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>`;

        const ICON_CLOSE = `
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>`;

        const ICON_CHECK = `
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5 12.5l4.2 4.2L19 6.8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>`;

        let alarms = [];
        let dragState = null;
        let zIndexCounter = 2147483600;
        let styleEl = null;
        let rootEl = null;
        let intervalId = null;
        let handleMouseMove = null;
        let handleMouseUp = null;
        let handleResize = null;

        function loadAlarms() {
            try {
                const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
                return Array.isArray(parsed) ? parsed : [];
            } catch {
                return [];
            }
        }

        function saveAlarms() {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(alarms));
        }

        function normalizeLoadedAlarms() {
            let changed = false;

            alarms.forEach((alarm, index) => {
                if (!alarm.id) {
                    alarm.id = 'alarm_' + Date.now() + '_' + index;
                    changed = true;
                }

                if (!Number.isFinite(alarm.createdAt)) {
                    alarm.createdAt = Date.now();
                    changed = true;
                }

                if (!Number.isFinite(alarm.endAt)) {
                    const minutes = Number(alarm.minutes) || 1;
                    alarm.endAt = alarm.createdAt + (minutes * 60 * 1000);
                    changed = true;
                }

                if (!Number.isFinite(alarm.left) || !Number.isFinite(alarm.top)) {
                    const pos = getDefaultPosition(index);
                    alarm.left = pos.left;
                    alarm.top = pos.top;
                    changed = true;
                }

                if (typeof alarm.finished !== 'boolean') {
                    alarm.finished = Date.now() >= alarm.endAt;
                    changed = true;
                }
            });

            if (changed) {
                saveAlarms();
            }
        }

        function injectStyles() {
            styleEl = document.createElement('style');
            styleEl.textContent = `
                @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=JetBrains+Mono:wght@500;700&display=swap');

                #tm-alarm-root {
