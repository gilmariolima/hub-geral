        overlay.innerHTML = `
            <div id="tmm-modal">
                <div id="tmm-modal-header">
                    <div id="tmm-modal-title">Meus scripts</div>
                    <button id="tmm-modal-close" title="Fechar" aria-label="Fechar">✕</button>
                </div>
                <div id="tmm-lista"></div>
            </div>
        `;
        document.body.appendChild(overlay);

        const lista = overlay.querySelector('#tmm-lista');

        function criarLinhaModulo(mod, nomeExibido) {
            const estado = carregarEstado();
            const ligado = (estado[mod.id] !== undefined) ? estado[mod.id] : mod.defaultOn;

            const item = document.createElement('div');
            item.className = 'tmm-item';
            item.dataset.id = mod.id;

            const checkboxId = 'tmm-check-' + mod.id;

            item.innerHTML = `
                <input type="checkbox" id="${checkboxId}" ${ligado ? 'checked' : ''}>
                <label for="${checkboxId}">${nomeExibido}</label>
            `;

            item.querySelector('input').addEventListener('change', (e) => {
                alternarModulo(mod.id, e.target.checked);
            });

            return item;
        }

        function criarCabecalhoSecao(titulo) {
            const header = document.createElement('div');
            header.className = 'tmm-section-header';
            header.textContent = titulo;
            return header;
        }

        // Agrupa os módulos por plataforma (SmartBus / Tallos) com base no prefixo do
        // nome. Módulos que não seguem esse padrão caem na seção "Outros".
        function agruparModulos() {
            const grupos = { 'SmartBus': [], 'Tallos': [], 'Outros': [] };

            modulos.forEach(mod => {
                const nomeUpper = mod.name.toUpperCase();

                if (nomeUpper.startsWith('SMART BUS')) {
                    const nomeCurto = mod.name.replace(/^SMART BUS\s*[-—]\s*/i, '');
                    grupos['SmartBus'].push({ mod, nomeCurto });
                } else if (nomeUpper.startsWith('TALLOS')) {
                    const nomeCurto = mod.name.replace(/^TALLOS\s*[-—]\s*/i, '');
                    grupos['Tallos'].push({ mod, nomeCurto });
                } else {
                    grupos['Outros'].push({ mod, nomeCurto: mod.name });
                }
            });

            return grupos;
        }

        function renderizarLista() {
            lista.innerHTML = '';

            const grupos = agruparModulos();

            ['SmartBus', 'Tallos', 'Outros'].forEach(secao => {
                const itens = grupos[secao];
                if (itens.length === 0) return;

                lista.appendChild(criarCabecalhoSecao(secao));
                itens.forEach(({ mod, nomeCurto }) => {
                    lista.appendChild(criarLinhaModulo(mod, nomeCurto));
                });
            });
        }

        renderizarLista();
        atualizarCheckboxesDoPainel = renderizarLista;

        fab.addEventListener('click', () => {
            overlay.classList.add('tmm-show');
        });

        overlay.addEventListener('click', (e) => {
            if (e.target === overlay) {
                overlay.classList.remove('tmm-show');
            }
        });

        overlay.querySelector('#tmm-modal-close').addEventListener('click', () => {
            overlay.classList.remove('tmm-show');
        });
    }

    // =========================================================================
    // INICIALIZAÇÃO
    // =========================================================================
    criarPainelMaster();
    aplicarEstadoInicial();

})();console.log("Hello, World!");
