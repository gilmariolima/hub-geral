        function adicionarDrag(btn, acaoClique) {
            let isDragging = false;
            let dragStartX, dragStartY;
            let shiftX, shiftY;

            function onMouseMove(e) {
                if (Math.abs(e.clientX - dragStartX) > 10 || Math.abs(e.clientY - dragStartY) > 10) {
                    isDragging = true;
                    btn.style.bottom = 'auto';
                    btn.style.right = 'auto';
                    btn.style.left = (e.clientX - shiftX) + 'px';
                    btn.style.top = (e.clientY - shiftY) + 'px';
                }
            }

            function onMouseUp(e) {
                document.removeEventListener('mousemove', onMouseMove);
                document.removeEventListener('mouseup', onMouseUp);
                btn.style.cursor = 'grab';
            }

            btn.onmousedown = function(e) {
                isDragging = false;
                dragStartX = e.clientX;
                dragStartY = e.clientY;
                shiftX = e.clientX - btn.getBoundingClientRect().left;
                shiftY = e.clientY - btn.getBoundingClientRect().top;
                btn.style.cursor = 'grabbing';
                document.addEventListener('mousemove', onMouseMove);
                document.addEventListener('mouseup', onMouseUp);
            };

            btn.onclick = function(e) {
                if (isDragging) return;

                const txtOriginal = btn.innerHTML;
                btn.innerHTML = "⌛ Copiando...";
                btn.style.pointerEvents = 'none';

                try {
                    acaoClique();
                } catch(erro) {
                    console.error(erro);
                    btn.innerHTML = txtOriginal;
                    btn.style.pointerEvents = 'auto';
                }
            };
        }

