                    }

                    .tallos-popup-header {
                        background: #232025;
                        border-bottom: 1px solid rgba(255, 106, 31, 0.25);
                        padding: 10px 14px;
                        color: #a89d94;
                        font-size: 12px;
                        font-weight: 700;
                        text-transform: uppercase;
                        letter-spacing: 0.5px;
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                    }

                    .tallos-client-list {
                        list-style: none;
                        margin: 0;
                        padding: 6px;
                        max-height: 220px;
                        overflow-y: auto;
                    }
                    .tallos-client-list::-webkit-scrollbar { width: 4px; }
                    .tallos-client-list::-webkit-scrollbar-thumb { background: #3a3640; border-radius: 10px; }

                    .tallos-client-item {
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                        padding: 8px 10px;
                        border-radius: 8px;
                        margin-bottom: 2px;
                        transition: all 0.2s ease;
                        cursor: pointer;
                        border: 1px solid transparent;
                    }
                    .tallos-client-item:hover {
                        background: rgba(255, 106, 31, 0.12);
                        border-color: rgba(255, 106, 31, 0.3);
                    }

                    .tallos-client-name {
                        font-size: 12px;
                        color: #f3ece6;
                        font-weight: 600;
                        white-space: nowrap;
                        overflow: hidden;
                        text-overflow: ellipsis;
                        max-width: 140px;
                    }

                    .tallos-client-time { font-size: 10px; color: #ff6a1f; font-weight: 700; }

                    .icon-ok { display: block; }
