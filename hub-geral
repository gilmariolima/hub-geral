                `;
                document.head.appendChild(styleEl);

                const iconeNormalHTML = CONFIG.URL_IMAGEM_NORMAL !== ""
                    ? `<img src="${CONFIG.URL_IMAGEM_NORMAL}" class="icon-ok tallos-custom-img">`
                    : `<svg class="icon-ok" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`;

                const iconeAlertaHTML = CONFIG.URL_IMAGEM_ALERTA !== ""
                    ? `<img src="${CONFIG.URL_IMAGEM_ALERTA}" class="icon-alert tallos-custom-img">`
                    : `<svg class="icon-alert" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18"/></svg>`;

                wrapperUI = document.createElement('div');
                wrapperUI.id = 'tallos-widget-wrapper';
                wrapperUI.innerHTML = `
                    <div class="tallos-popup-menu" id="tallos-popup">
                        <div class="tallos-popup-header">
                            Atrasos na Fila
                            <span style="color: #ef4444; font-size: 14px;">⚠️</span>
                        </div>
                        <ul class="tallos-client-list" id="tallos-lista-clientes"></ul>
                    </div>

                    <div class="tallos-bubble" id="tallos-bubble">
                        ${iconeNormalHTML}
                        ${iconeAlertaHTML}
                        <div class="tallos-badge" id="tallos-badge">0</div>
                    </div>
                `;
                document.body.appendChild(wrapperUI);

                bubbleUI = wrapperUI.querySelector('#tallos-bubble');
                popupUI = wrapperUI.querySelector('#tallos-popup');
                listaUI = wrapperUI.querySelector('#tallos-lista-clientes');
                badgeUI = wrapperUI.querySelector('#tallos-badge');

                handleBubbleClick = function () {
                    if (bubbleUI.classList.contains('has-alerts')) {
                        popupUI.classList.toggle('show');
