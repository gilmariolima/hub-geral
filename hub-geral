        // Extrai origem (com UF) e destino (só cidade) do texto "TRECHO: NATAL - RN para FORTALEZA"
        function extrairOrigemDestino(texto) {
            const match = texto.match(/TRECHO:\s*(.+?)\s+para\s+(.+)/i);
            if (!match) return null;
            return {
                origem: match[1].trim(),
                destino: match[2].trim()
            };
        }

        // Extrai as datas "IDA: dd/mm/aaaa" e "VOLTA: dd/mm/aaaa" (volta é opcional)
        function extrairDatas(texto) {
            const idaMatch = texto.match(/IDA:\s*(\d{2}\/\d{2}\/\d{4})/i);
            const voltaMatch = texto.match(/VOLTA:\s*(\d{2}\/\d{2}\/\d{4})/i);
            return {
                ida: idaMatch ? idaMatch[1].trim() : null,
                volta: voltaMatch ? voltaMatch[1].trim() : null
            };
        }

        // Fluxo completo: preenche origem -> destino -> data de ida -> data de volta (se tiver)
        function preencherTudo(info, datas) {
            const origem = separarCidadeUF(info.origem);
            const destino = separarCidadeUF(info.destino);

            abrirEPreencherSelect2(5, origem.cidade, origem.uf, (sucessoOrigem) => {
                // Antes o código seguia para o Destino mesmo se a Origem falhasse (o parâmetro
                // de sucesso era ignorado), o que deixava a Origem vazia sem avisar direito --
                // dava a falsa impressão de que só "sumiu" um campo. Agora, se a Origem falhar,
                // paramos aqui (o alerta de "não encontrei a cidade" já foi mostrado).
                if (sucessoOrigem === false) {
                    console.warn('[Tampermonkey] Preenchimento interrompido: falha ao selecionar a Origem.');
                    return;
                }

                setTimeout(() => {
                    abrirEPreencherSelect2(6, destino.cidade, destino.uf, (sucessoDestino) => {
                        if (sucessoDestino === false) {
                            console.warn('[Tampermonkey] Preenchimento interrompido: falha ao selecionar o Destino.');
                            return;
                        }

                        setTimeout(() => {
                            if (datas.ida) {
                                preencherData(14, datas.ida);
                            }
                            if (datas.volta) {
                                preencherData(16, datas.volta);
                            }
                        }, 80);
                    });
                }, 80);
            });
        }

        // Separa "CIDADE (COMPLEMENTO) - UF" em { cidade, uf }.
        // IMPORTANTE: o complemento entre parênteses é MANTIDO em `cidade` de propósito —
        // é ele que diferencia terminais como "FORTALEZA (TA ANTONIO BEZERRA)" do terminal
        // padrão "FORTALEZA". Removê-lo faz o select2 sempre cair na opção canônica.
        function separarCidadeUF(texto) {
            const match = texto.trim().match(/^(.*)\s-\s([A-Z]{2})$/);

            if (match) {
                return { cidade: match[1].trim().toUpperCase(), uf: match[2] };
            }

            return { cidade: texto.trim().toUpperCase(), uf: null };
        }

        // Preenche um campo de data (.ng-valid pelo índice) e dispara os eventos que o Angular escuta
        function preencherData(indice, dataStr) {
            const campos = document.querySelectorAll('.ng-valid');
            const campo = campos[indice];

            if (!campo) {
                console.warn('[Tampermonkey] .ng-valid índice', indice, 'não encontrado para a data', dataStr);
                alert(`Campo de data (índice ${indice}) não encontrado para "${dataStr}".`);
                return false;
            }

            campo.focus();
            campo.value = dataStr;

            // Dispara os eventos que o Angular/datepicker escutam para reconhecer o valor digitado
            campo.dispatchEvent(new Event('input', { bubbles: true }));
            campo.dispatchEvent(new Event('change', { bubbles: true }));
            campo.blur();

            return true;
        }

        // Clica no .select2-selection do índice informado para abrir o dropdown
        //
        // IMPORTANTE: o Select2 abre/fecha o dropdown ouvindo o evento "mousedown" no
        // elemento .select2-selection (assim ele evita fechar o próprio dropdown por causa
        // do listener de "clique fora" que ouve mousedown no documento).
        // Antes, disparávamos "mousedown" e, na sequência, chamávamos elem.click() -- isso
        // fazia o dropdown alternar de estado DUAS vezes (abre no mousedown, fecha de novo
        // no click), de forma intermitente conforme a velocidade de processamento do
        // navegador. Era esse o motivo do preenchimento "sumir"/desfazer às vezes.
        // Agora disparamos só o mousedown; se por algum motivo o dropdown não abrir, o
        // fallback fica em aguardarCampoBusca(), que tenta um clique real uma única vez.
        function abrirSelect2(indice) {
            const elems = document.querySelectorAll('.select2-selection');
            const elem = elems[indice];

            if (!elem) {
                console.warn('[Tampermonkey] .select2-selection índice', indice, 'não encontrado');
                return null;
            }

            elem.dispatchEvent(new MouseEvent('mousedown', { bubbles: true, cancelable: true }));
            return elem;
        }

        // Abre o select do índice indicado, digita a cidade (com complemento, se houver) e seleciona
        // a opção correspondente
        function abrirEPreencherSelect2(indice, nomeCidade, uf, callback) {
            const elem = abrirSelect2(indice);

            if (!elem) {
                alert(`Select de índice ${indice} não encontrado na página.`);
                return;
            }

            aguardarCampoBusca(nomeCidade, uf, callback, 30, elem);
        }

        // Espera o campo .select2-search__field aparecer (dropdown abrir), digita e dispara os eventos.
        // Digitamos o nome COMPLETO (incluindo o complemento entre parênteses, se houver), pois é assim
        // que o campo de busca filtra corretamente para um terminal específico (ex: "FORTALEZA (TA
        // ANTONIO BEZERRA)"), igual ao comportamento manual.
        function aguardarCampoBusca(nomeCidade, uf, callback, tentativas = 30, elem = null) {
            const campos = document.querySelectorAll('.select2-search__field');
            const campo = Array.from(campos).find(c => c.offsetParent !== null);

            if (campo) {
                campo.focus();
                campo.value = nomeCidade;
                campo.dispatchEvent(new Event('input', { bubbles: true }));
                campo.dispatchEvent(new KeyboardEvent('keyup', { bubbles: true }));
                aguardarESelecionarOpcao(nomeCidade, uf, callback);
                return;
            }

            // Fallback: se na metade das tentativas o dropdown ainda não abriu com o mousedown
            // sozinho, tenta UM clique real (não repetido) como segunda via.
            if (elem && tentativas === 15) {
                elem.click();
            }

            if (tentativas <= 0) {
                console.warn('[Tampermonkey] Campo de busca não apareceu para', nomeCidade);
                alert(`O campo de busca do select não abriu para "${nomeCidade}".`);
                return;
            }

            setTimeout(() => aguardarCampoBusca(nomeCidade, uf, callback, tentativas - 1, elem), 50);
        }

        // Tenta encontrar a opção com o nome da cidade na lista renderizada pelo select2.
        // Como a filtragem é assíncrona (geralmente busca no servidor conforme digita), tenta
        // várias vezes com um pequeno intervalo. Em máquinas/conexões mais lentas essa busca
        // pode demorar bem mais que em outras -- por isso o número de tentativas é generoso
        // (80 tentativas x 100ms = até 8s). Como sai assim que encontra a opção, isso não
        // deixa o preenchimento mais lento em máquinas rápidas.
        function aguardarESelecionarOpcao(nomeCidade, uf, callback, tentativas = 80) {
            const opcoes = Array.from(document.querySelectorAll('.select2-results__option'))
                .filter(op => !op.classList.contains('select2-results__message'));

            const opcao = encontrarOpcao(opcoes, nomeCidade, uf);

            if (opcao) {
                // Simula os eventos de mouse que o select2 escuta para confirmar a seleção
                ['mouseenter', 'mousedown', 'mouseup', 'click'].forEach(tipo => {
                    opcao.dispatchEvent(new MouseEvent(tipo, { bubbles: true, cancelable: true }));
                });
                if (callback) setTimeout(() => callback(true), 50);
                return;
            }

            if (tentativas <= 0) {
                console.warn('[Tampermonkey] Nenhuma opção encontrada para a cidade:', nomeCidade);
                alert(`Não encontrei "${nomeCidade}" na lista de opções do select.`);
                if (callback) callback(false);
                return;
            }

            setTimeout(() => aguardarESelecionarOpcao(nomeCidade, uf, callback, tentativas - 1), 100);
        }

        // Compara pelo nome exato da cidade, extraído de forma robusta do texto da opção.
        // Formatos possíveis: "CÓD - CIDADE - UF" ou "CÓD - CIDADE (COMPLEMENTO) - UF"
        //
        // Estratégia:
        // 1) Se `nomeCidade` já tem um complemento entre parênteses (ex: "FORTALEZA (TA ANTONIO
        //    BEZERRA)"), tenta achar a opção cujo nome COMPLETO (cidade + complemento) bate
        //    exatamente. Isso resolve o caso de terminais alternativos.
        // 2) Se não tiver complemento, cai no comportamento anterior: compara só pela cidade (sem
        //    parênteses) e, se houver ambiguidade, prefere a opção canônica (sem complemento) ou
        //    desempata pela UF.
        function encontrarOpcao(opcoes, nomeCidade, uf) {
            if (nomeCidade.includes('(')) {
                const exatoComComplemento = opcoes.find(
                    op => extrairCidadeCompletaDaOpcao(op.textContent) === nomeCidade
                );
                if (exatoComComplemento) {
                    return exatoComComplemento;
                }
                // Se não achou o complemento exato, continua para o fallback abaixo
                // comparando apenas pela cidade (sem o complemento).
            }

            const nomeSemComplemento = nomeCidade.replace(/\s*\([^)]*\)\s*/g, ' ').trim();

            const candidatosExatos = opcoes.filter(op => extrairCidadeDaOpcao(op.textContent) === nomeSemComplemento);

            if (candidatosExatos.length === 1) {
                return candidatosExatos[0];
            }

            if (candidatosExatos.length > 1) {
                const semParenteses = candidatosExatos.filter(op => !op.textContent.includes('('));

                if (semParenteses.length === 1) {
                    return semParenteses[0];
                }

                if (uf) {
                    const porUF = (semParenteses.length > 0 ? semParenteses : candidatosExatos)
                        .find(op => extrairUFDaOpcao(op.textContent) === uf);
                    if (porUF) return porUF;
                }

                if (semParenteses.length > 0) {
                    return semParenteses[0];
                }

                return candidatosExatos[0];
            }

            // fallback: se não achou nenhuma correspondência exata, tenta por "contém"
            return opcoes.find(op => op.textContent.toUpperCase().includes(nomeSemComplemento));
        }

        // Extrai o nome da cidade do texto de uma opção do select2, SEM o complemento entre
        // parênteses. Remove o "CÓDIGO - " do início, depois corta no primeiro "(" ou " - ".
        function extrairCidadeDaOpcao(texto) {
            const semCodigo = texto.trim().replace(/^.*?-\s*/, '');
            const match = semCodigo.match(/^(.*?)(?:\s\(|\s-\s|$)/);
            return (match ? match[1] : semCodigo).trim().toUpperCase();
        }

        // Extrai o nome da cidade COM o complemento entre parênteses (se existir), mas sem a UF
        // e sem o código do terminal. Ex: "ABEZ - FORTALEZA (TA ANTONIO BEZERRA) - CE"
        // -> "FORTALEZA (TA ANTONIO BEZERRA)"
        function extrairCidadeCompletaDaOpcao(texto) {
            const semCodigo = texto.trim().replace(/^.*?-\s*/, '');
            const semUF = semCodigo.replace(/\s-\s[A-Z]{2}\s*$/, '');
            return semUF.trim().toUpperCase();
        }

        // Extrai a UF do final do texto da opção, se existir (ex: "... - RJ" -> "RJ")
        function extrairUFDaOpcao(texto) {
            const match = texto.trim().match(/-\s*([A-Z]{2})\s*$/);
            return match ? match[1] : null;
        }

        return {
            id: 'colar_trecho_auto',
            name: 'SMART BUS - Preencher Trecho',
            defaultOn: true,
            fixo: true, // módulo embutido no código-fonte, não pode ser excluído pelo painel

            init() {
                const botaoOk = criarBotaoCopiar();
                const textareaOk = criarTextareaEBotaoPreencher();

                if (!botaoOk || !textareaOk) {
                    // Caso alguma div ainda não exista no carregamento, observa mudanças no DOM
                    observerCriacao = new MutationObserver(() => {
                        const a = criarBotaoCopiar();
                        const b = criarTextareaEBotaoPreencher();
                        if (a && b) {
                            observerCriacao.disconnect();
                            observerCriacao = null;
                        }
                    });
                    observerCriacao.observe(document.body, { childList: true, subtree: true });
                }
            },

            destroy() {
                if (observerCriacao) {
                    observerCriacao.disconnect();
                    observerCriacao = null;
                }
                document.querySelector('.tm-copiar-btn')?.remove();
                document.querySelector('.tm-preencher-area')?.remove();
            }
        };
    }

    registrarModulo(criarModuloColarTrecho());

    // =========================================================================
    // MÓDULO 5 — Guanabara: Suporte Print dos Horários
    // =========================================================================
    function criarModuloGuanabara() {
        const FONTE_PADRAO = "'Segoe UI', Roboto, Helvetica, Arial, sans-serif";
        const MAX_ITENS_POR_IMAGEM = 15;

        const DICIONARIO_CIDADES = {
            "THE": "TERESINA", "PHB": "PARNAÍBA", "FOR": "FORTALEZA", "SLZ": "SÃO LUÍS",
            "PIC": "PICOS", "FLR": "FLORIANO", "SOB": "SOBRAL", "CJP": "CAJUEIRO DA PRAIA",
            "LCR": "LUÍS CORREIA", "NAT": "NATAL", "REC": "RECIFE", "JPA": "JOÃO PESSOA",
            "MCZ": "MACEIÓ", "AJU": "ARACAJU", "SSA": "SALVADOR", "BEL": "BELÉM",
            "IMP": "IMPERATRIZ", "PNZ": "PETROLINA", "JDO": "JUAZEIRO DO NORTE",
            "CMP": "CAMPO MAIOR", "PIR": "PIRIPIRI", "MOS": "MOSSORÓ", "TBA": "TIANGUÁ",
            "CCM": "CAMOCIM", "CANGA": "RECIFE (CAXANGA)",
            "VARG": "VARGEM GRANDE", "VGE": "VARGEM GRANDE", "GYN": "GOIÂNIA", "BSB": "BRASÍLIA",
            "TJK": "BELO HORIZONTE (TERMINAL JK)", "RIO": "RIO DE JANEIRO", "BHZ": "BELO HORIZONTE",
            "BCN": "BARBACENA", "BTI": "BETIM - MG (TERM ADICIONAL BH)"
        };

        let filaViagensGlobal = [];
        let metadadosViagemGlobal = null;
        let linkAtual = null;
        let intervalHashId = null;
        let intervalBotoesId = null;

        // ---- Utilitários gerais e desenho ----
        function formatarMoeda(valor) { return "R$ " + valor.toLocaleString('pt-BR', { minimumFractionDigits: 2 }); }

        function extrairNumero(texto) {
            if (!texto) return 0;
            let limpo = texto.replace(/[^\d,]/g, '').replace(',', '.');
            return parseFloat(limpo) || 0;
        }

        function desenharRetanguloArredondado(ctx, x, y, width, height, radius, fillStyle, strokeStyle = null) {
            ctx.fillStyle = fillStyle;
            ctx.beginPath();
            ctx.moveTo(x + radius, y); ctx.lineTo(x + width - radius, y);
            ctx.quadraticCurveTo(x + width, y, x + width, y + radius);
            ctx.lineTo(x + width, y + height - radius);
            ctx.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
            ctx.lineTo(x + radius, y + height);
            ctx.quadraticCurveTo(x, y + height, x, y + height - radius);
            ctx.lineTo(x, y + radius); ctx.quadraticCurveTo(x, y, x + radius, y);
            ctx.closePath();
            ctx.fill();
            if (strokeStyle) {
                ctx.strokeStyle = strokeStyle;
                ctx.lineWidth = 1.5;
                ctx.stroke();
            }
        }

        function limparCidade(nome) {
            if (!nome) return "---";
            let limpo = nome.replace(/\s*\(TERM[^\)]+\)/gi, '').replace(/^[A-Z]+\s*-\s*/i, '').replace(/\s*-\s*[A-Z]{2}(\s|$)/i, '').replace(/\s*\([A-Z]{2}\)/gi, '').trim();
            let partes = limpo.split('(');
            let base = partes[0].trim().toUpperCase();
            let terminal = partes.length > 1 ? " (" + partes[1] : "";
            if (DICIONARIO_CIDADES[base]) base = DICIONARIO_CIDADES[base];
            return (base + terminal).trim();
        }

        // ---- Lógica da tabela de horários e imagem ----
        function capturarTrecho() {
            let origem = document.querySelector('#txt-origem')?.value || "";
            let destino = document.querySelector('#txt-destino')?.value || "";
            if (!origem || !destino) {
                const textoTopo = document.body.innerText.substring(0, 1500);
                const match = textoTopo.match(/de\s+(.*)\s+para\s+(.*?)(?:\n|em |$)/i);
                if (match) { origem = match[1].trim(); destino = match[2].trim(); }
            }

            let isVolta = false;
            let abasAtivas = document.querySelectorAll('.active, .current, .selected');
            for (let i = 0; i < abasAtivas.length; i++) {
                let txtAba = abasAtivas[i].innerText.toUpperCase();
                if (txtAba.includes('VOLTA') && !txtAba.includes('IDA E VOLTA') && !txtAba.includes('IDA E RETORNO')) {
                    isVolta = true; break;
                }
            }

            if (document.body.innerText.toUpperCase().includes('ESCOLHA SUA VOLTA') ||
                document.body.innerText.toUpperCase().includes('TRECHO DE VOLTA') ||
                document.body.innerText.toUpperCase().includes('SELECIONE A VOLTA')) {
                isVolta = true;
            }

            if (origem && destino) {
                origem = limparCidade(origem);
                destino = limparCidade(destino);

                if (isVolta) return `${destino} ➔ ${origem}`.toUpperCase();
                else return `${origem} ➔ ${destino}`.toUpperCase();
            }
            return "";
        }

        function desenharECopiarImagemTabela(dados) {
            const btn = document.getElementById('btn-copy-william');

            const canvas = document.createElement('canvas');
            const ctx = canvas.getContext('2d');
            const largura = 850;
            const margem = 30;
            const alturaCartao = 100;
            const espacoEntreCartoes = 15;

            let temConexao = dados.viagens.some(v => v.isConexao);
            let temDireta = dados.viagens.some(v => !v.isConexao);
            let soConexao = temConexao && !temDireta;

            let altura = 115;
            altura += (dados.viagens.length * (alturaCartao + espacoEntreCartoes));
            if (temConexao && temDireta) altura += 50;
            if (soConexao) altura += 50;
            altura += 30;

            canvas.width = largura; canvas.height = altura;

            ctx.fillStyle = '#F4F6F9';
            ctx.fillRect(0, 0, largura, altura);

            ctx.fillStyle = '#283593';
            ctx.fillRect(0, 0, largura, 95);

            let locOrigem = "ORIGEM", locDestino = "DESTINO";
            if(dados.trecho) {
                let pts = dados.trecho.split('➔');
                if(pts.length === 2) {
                    locOrigem = pts[0].trim(); locDestino = pts[1].trim();
                } else if (dados.trecho.includes('->')) {
                    pts = dados.trecho.split('->'); locOrigem = pts[0].trim(); locDestino = pts[1].trim();
                } else {
                    locOrigem = dados.trecho; locDestino = "";
                }
            }

            let tituloTopo = "Passagem de ônibus";
            if (locDestino !== "") {
                tituloTopo += ` de ${locOrigem} para ${locDestino}`;
            } else {
                tituloTopo += ` ${locOrigem}`;
            }

            let extraAviso = (dados.temMaisRestantes || (!dados.temMaisRestantes && soConexao)) ? " (Continuação)" : "";
            if(dados.isPrimeiroLote && !dados.temMaisRestantes) extraAviso = "";
            if(dados.isPrimeiroLote && dados.temMaisRestantes) extraAviso = " (Parte 1)";
            tituloTopo += extraAviso;

            ctx.fillStyle = '#FFFFFF';
            let fSize = 22;
            let maxWidthTitulo = largura - (margem * 2);
            ctx.font = `bold ${fSize}px ${FONTE_PADRAO}`;

            while(ctx.measureText(tituloTopo).width > maxWidthTitulo && fSize > 14) {
                fSize--;
                ctx.font = `bold ${fSize}px ${FONTE_PADRAO}`;
            }

            if (ctx.measureText(tituloTopo).width > maxWidthTitulo) {
                while (ctx.measureText(tituloTopo + "...").width > maxWidthTitulo && tituloTopo.length > 0) {
                    tituloTopo = tituloTopo.slice(0, -1);
                }
                tituloTopo += "...";
            }

            ctx.fillText(tituloTopo, margem, 45);

            ctx.fillStyle = '#FFC107';
            ctx.font = `bold 16px ${FONTE_PADRAO}`;
            ctx.fillText(`📅 ${dados.dataTexto}`, margem, 75);

            let yAtual = 120;

            let desenhouDivisor = false;

            dados.viagens.forEach((v, index) => {
                if (v.isConexao && !desenhouDivisor && (temDireta || index === 0)) {
                    yAtual += 10;
                    ctx.fillStyle = '#CBD5E1';
                    ctx.fillRect(margem, yAtual, largura - (margem * 2), 1);
                    ctx.fillStyle = '#64748B';
                    ctx.font = `bold 12px ${FONTE_PADRAO}`;
                    ctx.textAlign = 'center';
                    ctx.fillText("🔄 OPÇÕES COM TROCA DE VEÍCULO OU MÚLTIPLAS PARADAS", largura / 2, yAtual + 22);
                    ctx.textAlign = 'left';
                    yAtual += 40;
                    desenhouDivisor = true;
                }

                ctx.shadowColor = 'rgba(0,0,0,0.04)'; ctx.shadowBlur = 6; ctx.shadowOffsetY = 3;
                desenharRetanguloArredondado(ctx, margem, yAtual, largura - (margem * 2), alturaCartao, 8, '#FFFFFF', '#CBD5E1');
                ctx.shadowColor = 'transparent';

                ctx.font = `bold 12px ${FONTE_PADRAO}`;
                let servicoText = v.servico;
                let pillWidth = ctx.measureText(servicoText).width + 24;
                desenharRetanguloArredondado(ctx, margem + 25, yAtual + 23, pillWidth, 24, 12, '#EEF2FF', '#A5B4FC');
                ctx.fillStyle = '#1E3A8A';
                ctx.textAlign = 'center';
                ctx.fillText(servicoText, margem + 25 + (pillWidth/2), yAtual + 40);

                ctx.textAlign = 'left';
                ctx.fillStyle = '#475569';
                ctx.font = `600 13px ${FONTE_PADRAO}`;
                ctx.fillText(`💺 ${v.textoPoltronas}`, margem + 30, yAtual + 75);

                let centerCard = largura / 2;

                ctx.fillStyle = '#0F172A';
                ctx.font = `bold 24px ${FONTE_PADRAO}`;
                ctx.textAlign = 'center';
                ctx.fillText(v.saida, centerCard - 120, yAtual + 45);

                ctx.fillStyle = '#64748B';
                ctx.font = `600 11px ${FONTE_PADRAO}`;
                let displayOrigem = locOrigem.length > 20 ? locOrigem.substring(0,20)+"..." : locOrigem;
                ctx.fillText(displayOrigem, centerCard - 120, yAtual + 65);

                ctx.fillStyle = '#94A3B8'; ctx.font = `bold 18px ${FONTE_PADRAO}`;
                ctx.fillText("➔", centerCard, yAtual + 43);

                ctx.fillStyle = '#0F172A'; ctx.font = `bold 24px ${FONTE_PADRAO}`;
                ctx.fillText(v.chegada, centerCard + 120, yAtual + 45);
                ctx.fillStyle = '#64748B'; ctx.font = `600 11px ${FONTE_PADRAO}`;
                let displayDestino = locDestino.length > 20 ? locDestino.substring(0,20)+"..." : locDestino;
                ctx.fillText(displayDestino, centerCard + 120, yAtual + 65);

                ctx.textAlign = 'right';
                let displayValor = v.displayValor;
                if (displayValor.toUpperCase() === "ISENTO") {
                    let isentoW = 75;
                    desenharRetanguloArredondado(ctx, largura - margem - 30 - isentoW, yAtual + 35, isentoW, 30, 6, '#F1F5F9', '#CBD5E1');
                    ctx.textAlign = 'center';
                    ctx.fillStyle = '#334155';
                    ctx.font = `bold 13px ${FONTE_PADRAO}`;
                    ctx.fillText("ISENTO", largura - margem - 30 - (isentoW/2), yAtual + 55);
                } else {
                    let prefixo = "";
                    let valorStr = displayValor;
                    if (displayValor.includes("R$")) {
                        const parts = displayValor.split("R$");
                        prefixo = parts[0].trim();
                        valorStr = "R$ " + parts[1].trim();
                    }

                    ctx.fillStyle = '#64748B'; ctx.font = `600 12px ${FONTE_PADRAO}`;
                    ctx.fillText(prefixo, largura - margem - 30, yAtual + 35);

                    ctx.fillStyle = '#E65100';
                    if (valorStr.includes(",")) {
                        let valParts = valorStr.split(",");
                        let reais = valParts[0];
                        let cents = "," + valParts[1];

                        ctx.font = `bold 14px ${FONTE_PADRAO}`;
                        let centWidth = ctx.measureText(cents).width;
                        ctx.fillText(cents, largura - margem - 30, yAtual + 65);

                        ctx.font = `bold 24px ${FONTE_PADRAO}`;
                        ctx.fillText(reais, largura - margem - 30 - centWidth, yAtual + 65);
                    } else {
                        ctx.font = `bold 24px ${FONTE_PADRAO}`;
                        ctx.fillText(valorStr, largura - margem - 30, yAtual + 65);
                    }
                }
                ctx.textAlign = 'left';

                yAtual += alturaCartao + espacoEntreCartoes;
            });

            canvas.toBlob(async function(blob) {
                try {
                    if(typeof window.ClipboardItem === "undefined") {
                        throw new Error("NAVEGADOR_INCOMPATIVEL");
                    }
                    const item = new ClipboardItem({ "image/png": blob });
                    await navigator.clipboard.write([item]);

                    // NOTIFICAÇÃO QUANDO TEM MUITOS HORÁRIOS (RESTAURADA)
                    if (dados.temMaisRestantes) {
                        if(btn) {
                            btn.style.background = "#E65100";
                            btn.innerHTML = `⚠️ Copiar Restantes (${dados.restantesCount})`;
                            btn.style.pointerEvents = 'auto';
                        }
                        alert("A lista de horários é muito grande! A primeira parte foi copiada.\n\nCole no WhatsApp e depois clique no botão novamente para copiar o restante.");
                    } else {
                        filaViagensGlobal = [];
                        if(btn) {
                            btn.style.background = "#28a745";
                            btn.innerHTML = `✅ Card Copiado!`;
                            setTimeout(() => {
                                btn.style.background = "#303F9F";
                                btn.innerHTML = dados.textoVolta || "📸 Copiar Tabela (Imagem)";
                                btn.style.pointerEvents = 'auto';
                            }, 3000);
                        }
                    }
                } catch (err) {
                    console.error("ERRO COMPLETO DE CÓPIA:", err);
                    alert("⚠️ Detalhe do Erro para Análise:\n\n" + (err.message || err.toString()) + "\n\n(Tire um print para investigarmos)");
                    if(btn) {
                        btn.innerHTML = "❌ Erro! Tente de novo";
                        btn.style.background = "#dc3545";
                        setTimeout(() => {
                            btn.innerHTML = dados.textoVolta || "📸 Copiar Tabela (Imagem)";
                            btn.style.background = "#303F9F";
                            btn.style.pointerEvents = 'auto';
                        }, 4000);
                    }
                }
            }, "image/png");
        }

        function processarLotePendente(isPrimeiroLote) {
            let lote = filaViagensGlobal.splice(0, MAX_ITENS_POR_IMAGEM);
            let temMais = filaViagensGlobal.length > 0;
            let restantes = filaViagensGlobal.length;

            desenharECopiarImagemTabela({
                dataTexto: metadadosViagemGlobal.dataTexto,
                trecho: metadadosViagemGlobal.trecho,
                viagens: lote,
                temMaisRestantes: temMais,
                restantesCount: restantes,
                isPrimeiroLote: isPrimeiroLote,
                textoVolta: "📸 Copiar Tabela (Imagem)"
            });
        }

        function extrairDadosTabela() {
            const btn = document.getElementById('btn-copy-william');
            const elementoData = document.querySelector('.service-date-title, #txt-data-ida-retorno, .active .date-value');
            let dataTexto = elementoData ? elementoData.innerText.trim().toUpperCase() : "DATA";
            dataTexto = dataTexto.replace('EM ', '').replace('COPIAR', '').trim();
            const trecho = capturarTrecho();

            if (filaViagensGlobal.length > 0 && metadadosViagemGlobal &&
                metadadosViagemGlobal.dataTexto === dataTexto && metadadosViagemGlobal.trecho === trecho) {
                processarLotePendente(false);
                return;
            }

            filaViagensGlobal = [];
            const blocosHorario = document.querySelectorAll('.service-col-3');

            let viagensDiretas = [];
            let viagensConexao = [];

            blocosHorario.forEach(bloco => {
                const linha = bloco.closest('.service-row') || bloco.parentElement.parentElement;
                if (!linha) return;

                const b = bloco.querySelectorAll('b');
                const saida = b[0]?.innerText.trim() || "";
                const chegada = b[1]?.innerText.trim() || "";

                if (!saida) return;

                let servico = linha.querySelector('.spn-class')?.innerText.trim() || "CONVENCIONAL";
                const poltTxt = linha.querySelector('.service-availability, [class*="availability"]')?.innerText.replace(/[^0-9]/g, '') || "0";
                const polt = parseInt(poltTxt);

                if (polt <= 0) return;

                let valorNovo = 0;
                const celulas = linha.querySelectorAll('td, .price-family-container, .service-price-family');
                for (let c of celulas) {
                    let txt = c.innerText.toUpperCase();
                    if ((txt.includes('BRL') || txt.includes('R$')) && !txt.includes('INDISPONÍVEL') && !txt.includes('ESGOTADO')) {
                        valorNovo = extrairNumero(txt);
                        if (valorNovo > 0) break;
                    }
                }

                if (valorNovo === 0) return;

                let displayValor = "A partir de R$ " + valorNovo.toLocaleString('pt-BR', { minimumFractionDigits: 2 });

                let textoLinha = linha.innerText.toUpperCase();
                let isConexao = textoLinha.includes('PARADA') || textoLinha.includes('CONEXÃO') || textoLinha.includes('MULTIPLAS') || servico.includes('MULTIPLAS');

                if (isConexao) {
                    if (!servico.includes("MÚLTIPLAS") && !servico.includes("MULTIPLAS")) {
                        servico += " (Conexão)";
                    } else {
                        servico = "CONEXÃO (Múltiplas)";
                    }
                }

                const textoPoltronas = polt === 1 ? "1 vaga" : `${polt} vagas`;
                const viagemObj = { saida, chegada, servico, displayValor, textoPoltronas, isConexao };

                if (isConexao) {
                    viagensConexao.push(viagemObj);
                } else {
                    viagensDiretas.push(viagemObj);
                }
            });

            let viagensFinais = [...viagensDiretas, ...viagensConexao];

            if (viagensFinais.length > 0) {
                filaViagensGlobal = viagensFinais;
                metadadosViagemGlobal = { dataTexto, trecho };
                processarLotePendente(true);
            } else {
                alert("Nenhum horário com vaga disponível encontrado.");
            }
        }

