        function createUI() {
            if (document.getElementById('tm-alarm-root')) return;

            const root = document.createElement('div');
            root.id = 'tm-alarm-root';

            const fab = document.createElement('button');
            fab.id = 'tm-alarm-fab';
            fab.title = 'Novo alarme';
            fab.setAttribute('aria-label', 'Novo alarme');
            fab.innerHTML = `${ICON_BELL}<span class="tm-fab-dot" id="tm-fab-dot"></span>`;

            const panel = document.createElement('div');
            panel.id = 'tm-alarm-panel';
            panel.innerHTML = `
                <div class="tm-panel-header">
                    <div>
                        <div class="tm-panel-title">Alarmes</div>
                    </div>
                    <button class="tm-panel-close" id="tm-close-panel" title="Fechar" aria-label="Fechar">${ICON_CLOSE}</button>
                </div>
                <label class="tm-field-label">Nome do cliente</label>
                <input id="tm-alarm-name" class="tm-input" type="text" placeholder="Nome:">
                <label class="tm-field-label">Duração</label>
                <input id="tm-alarm-minutes" class="tm-input" type="number" min="1" step="1" placeholder="Minutos:">
                <button id="tm-save-alarm" class="tm-btn-save">Criar alarme</button>
            `;

            const floatingWrap = document.createElement('div');
            floatingWrap.id = 'tm-floating-alarms';

            root.appendChild(floatingWrap);
            root.appendChild(panel);
            root.appendChild(fab);
            document.body.appendChild(root);
            rootEl = root;

            fab.addEventListener('click', () => {
                panel.classList.toggle('tm-show');
            });

            panel.querySelector('#tm-close-panel').addEventListener('click', () => {
                panel.classList.remove('tm-show');
            });

            panel.querySelector('#tm-save-alarm').addEventListener('click', () => {
                const nameEl = panel.querySelector('#tm-alarm-name');
                const minutesEl = panel.querySelector('#tm-alarm-minutes');

                const title = (nameEl.value || '').trim();
                const minutesValue = Number(minutesEl.value);

                if (!title) {
                    alert('Preencha o nome do cliente.');
                    return;
                }

                if (!Number.isFinite(minutesValue) || minutesValue <= 0) {
                    alert('Digite uma quantidade de minutos válida.');
                    return;
                }

                const now = Date.now();
                const durationMs = Math.floor(minutesValue * 60 * 1000);
                const id = 'alarm_' + now + '_' + Math.random().toString(36).slice(2, 8);
                const defaultPos = getDefaultPosition(alarms.length);

                alarms.push({
                    id,
                    title,
                    minutes: minutesValue,
                    createdAt: now,
                    endAt: now + durationMs,
                    finished: false,
                    left: defaultPos.left,
                    top: defaultPos.top
                });

                saveAlarms();
                renderFloatingAlarmBalloons();
                updateFabDot();

                nameEl.value = '';
                minutesEl.value = '';

                panel.classList.remove('tm-show');
            });

            updateFabDot();
        }

        function getDefaultPosition(index = 0) {
            return {
                left: Math.max(20, window.innerWidth - 240),
                top: Math.max(20, window.innerHeight - 160 - (index * 74))
            };
        }

        function updateFabDot() {
            const dot = document.getElementById('tm-fab-dot');
            if (!dot) return;
            const anyFinished = alarms.some(a => a.finished);
            dot.style.display = anyFinished ? 'block' : 'none';
        }

        function renderFloatingAlarmBalloons() {
            const wrap = document.getElementById('tm-floating-alarms');
            if (!wrap) return;

            wrap.innerHTML = '';

            alarms.forEach(alarm => {
                const box = document.createElement('div');
                box.className = 'tm-floating-alarm';
                box.dataset.id = alarm.id;
                box.style.left = (Number.isFinite(alarm.left) ? alarm.left : 20) + 'px';
                box.style.top = (Number.isFinite(alarm.top) ? alarm.top : 20) + 'px';
                box.style.zIndex = String(++zIndexCounter);

                box.innerHTML = `
                    <div class="tm-ring-wrap">
                        <svg class="tm-ring" viewBox="0 0 48 48">
                            <circle class="tm-ring-track" cx="24" cy="24" r="${FLOAT_RING_RADIUS}"></circle>
                            <circle class="tm-ring-progress" cx="24" cy="24" r="${FLOAT_RING_RADIUS}"
                                stroke-dasharray="${FLOAT_RING_CIRC}" stroke-dashoffset="0"></circle>
                        </svg>
                        <div class="tm-ring-label">00:00</div>
                    </div>
                    <div class="tm-floating-body">
                        <div class="tm-floating-title">${escapeHtml(alarm.title)}</div>
                    </div>
                    <button class="tm-floating-delete" title="Excluir" aria-label="Excluir alarme">${ICON_CLOSE}</button>
                `;

                setupDrag(box, alarm.id);

                box.addEventListener('mousedown', () => {
                    box.style.zIndex = String(++zIndexCounter);
                });

                box.querySelector('.tm-floating-delete').addEventListener('click', (e) => {
                    e.stopPropagation();
                    removeAlarm(alarm.id);
                });

                wrap.appendChild(box);
            });

            updateCountdowns();
        }

        function setupDrag(box, alarmId) {
            box.addEventListener('mousedown', (e) => {
                if (e.target.closest('.tm-floating-delete')) return;

                const rect = box.getBoundingClientRect();

                dragState = {
                    alarmId,
                    box,
                    offsetX: e.clientX - rect.left,
                    offsetY: e.clientY - rect.top
                };

                box.classList.add('tm-dragging');
                e.preventDefault();
            });
        }

        function removeAlarm(alarmId) {
            alarms = alarms.filter(a => a.id !== alarmId);
            saveAlarms();
            renderFloatingAlarmBalloons();
            updateFabDot();
        }

        function startWatcher() {
            updateCountdowns();

            intervalId = setInterval(() => {
                updateCountdowns();
            }, 1000);

            handleResize = keepBalloonsInsideScreen;
            window.addEventListener('resize', handleResize);
        }

        function keepBalloonsInsideScreen() {
            let changed = false;

            alarms.forEach(alarm => {
                const width = 188;
                const height = 66;

                if (!Number.isFinite(alarm.left)) {
                    alarm.left = 20;
                    changed = true;
                }

                if (!Number.isFinite(alarm.top)) {
                    alarm.top = 20;
                    changed = true;
                }

                const maxLeft = Math.max(0, window.innerWidth - width);
                const maxTop = Math.max(0, window.innerHeight - height);

                const newLeft = Math.min(Math.max(0, alarm.left), maxLeft);
                const newTop = Math.min(Math.max(0, alarm.top), maxTop);

                if (newLeft !== alarm.left || newTop !== alarm.top) {
                    alarm.left = newLeft;
                    alarm.top = newTop;
                    changed = true;
                }
            });

            if (changed) {
                saveAlarms();
                renderFloatingAlarmBalloons();
            }
        }

        function updateCountdowns() {
            let changed = false;
            const now = Date.now();

            alarms.forEach(alarm => {
                const box = document.querySelector(`.tm-floating-alarm[data-id="${cssEscape(alarm.id)}"]`);
                if (!box) return;

                const labelEl = box.querySelector('.tm-ring-label');
                const progressEl = box.querySelector('.tm-ring-progress');

                const totalMs = Math.max(1, alarm.endAt - alarm.createdAt);
                const remainingMs = alarm.endAt - now;
                const fraction = Math.min(1, Math.max(0, remainingMs / totalMs));

                if (remainingMs <= 0) {
                    progressEl.style.strokeDashoffset = '0';
                    labelEl.innerHTML = ICON_CHECK;
                    box.classList.add('tm-finished');

                    if (!alarm.finished) {
                        alarm.finished = true;
                        changed = true;
                    }
                } else {
                    progressEl.style.strokeDashoffset = String(FLOAT_RING_CIRC * (1 - fraction));
                    labelEl.textContent = formatRemaining(remainingMs);
                    box.classList.remove('tm-finished');

                    if (alarm.finished) {
                        alarm.finished = false;
                        changed = true;
                    }
                }
            });

            if (changed) {
                saveAlarms();
                updateFabDot();
            }
        }

        function formatRemaining(ms) {
            const totalSeconds = Math.max(0, Math.floor(ms / 1000));
            const minutes = Math.floor(totalSeconds / 60);
            const seconds = totalSeconds % 60;

            return (
                String(minutes).padStart(2, '0') +
                ':' +
                String(seconds).padStart(2, '0')
            );
        }

        function escapeHtml(text) {
            return String(text || '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function cssEscape(value) {
            if (window.CSS && typeof window.CSS.escape === 'function') {
                return window.CSS.escape(value);
            }
            return String(value).replace(/"/g, '\\"');
        }

        return {
            id: 'alarme_flutuante',
            name: 'Alarme — Cartões Flutuantes com Cronômetro',
            defaultOn: true,
            fixo: true, // módulo embutido no código-fonte, não pode ser excluído pelo painel

            init() {
                // este widget só faz sentido dentro do Tallos
                if (!location.hostname.includes('tallos.com.br')) return;
                if (document.getElementById('tm-alarm-root')) return;

                alarms = loadAlarms();
                dragState = null;
                zIndexCounter = 2147483600;

                injectStyles();
                createUI();
                normalizeLoadedAlarms();
                renderFloatingAlarmBalloons();

                handleMouseMove = (e) => {
                    if (!dragState) return;

                    const box = dragState.box;
                    const width = box.offsetWidth;
                    const height = box.offsetHeight;

                    let left = e.clientX - dragState.offsetX;
                    let top = e.clientY - dragState.offsetY;

                    left = Math.max(0, Math.min(left, window.innerWidth - width));
                    top = Math.max(0, Math.min(top, window.innerHeight - height));

                    box.style.left = left + 'px';
                    box.style.top = top + 'px';
                };
                document.addEventListener('mousemove', handleMouseMove);

                handleMouseUp = () => {
                    if (!dragState) return;

                    const { alarmId, box } = dragState;
                    box.classList.remove('tm-dragging');

                    const alarm = alarms.find(a => a.id === alarmId);
                    if (alarm) {
                        alarm.left = parseInt(box.style.left, 10) || 0;
                        alarm.top = parseInt(box.style.top, 10) || 0;
                        saveAlarms();
                    }

                    dragState = null;
                };
                document.addEventListener('mouseup', handleMouseUp);

                startWatcher();
            },

            destroy() {
                if (intervalId) clearInterval(intervalId);
                intervalId = null;

                if (handleResize) window.removeEventListener('resize', handleResize);
                handleResize = null;

                if (handleMouseMove) document.removeEventListener('mousemove', handleMouseMove);
                handleMouseMove = null;

                if (handleMouseUp) document.removeEventListener('mouseup', handleMouseUp);
                handleMouseUp = null;

                rootEl?.remove();
                styleEl?.remove();
                rootEl = null;
                styleEl = null;
                dragState = null;
            }
        };
    }

    registrarModulo(criarModuloAlarme());

    // =========================================================================
    // MÓDULOS CUSTOMIZADOS — adicionados pelo próprio usuário via painel
    // =========================================================================
    // Cada item salvo tem o formato: { id, name, code, ativarAuto }
    // "code" é um texto JS que, ao ser avaliado, deve resultar em um objeto
    // com os métodos init() e destroy(), exatamente como os módulos fixos.
    //
    // Exemplo do que a pessoa cola na caixa de código:
    //
    // {
    //     init() {
    //         console.log('meu script ligou');
    //     },
    //     destroy() {
    //         console.log('meu script desligou');
    //     }
    // }

    function criarModuloCustom(item) {
        let instancia = null;

        return {
            id: item.id,
            name: item.name,
            defaultOn: !!item.ativarAuto,
            fixo: false,
            custom: true,

            init() {
                const fabrica = new Function('"use strict"; return (' + item.code + ');');
                instancia = fabrica();

                if (!instancia || typeof instancia.init !== 'function') {
                    throw new Error('O código precisa retornar um objeto com um método init().');
                }
                instancia.init();
            },

            destroy() {
                if (instancia && typeof instancia.destroy === 'function') {
                    instancia.destroy();
                }
                instancia = null;
            }
        };
    }

    function registrarTodosOsScriptsCustom() {
        carregarScriptsCustom().forEach(item => {
            registrarModulo(criarModuloCustom(item));
        });
    }

    registrarTodosOsScriptsCustom();

