// ==UserScript==
// @name         Painel de Scripts (Unificado)
// @namespace    http://tampermonkey.net/
// @version      1.5.0
// @description  Painel central
// @author       Gilmario
// @match        *://*.tallos.com.br/*
// @match        *://*.smarttravelit.com/*
// @grant        GM_setClipboard
// @grant        GM_setValue
// @grant        GM_getValue
// @grant        GM_addValueChangeListener
// @grant        GM_removeValueChangeListener
// @run-at       document-idle
// ==/UserScript==

(function () {
    'use strict';

    // =========================================================================
    // ARMAZENAMENTO DO ESTADO (quais módulos estão ligados/desligados)
    // =========================================================================
    const STORAGE_KEY_STATE = 'tmm_painel_scripts_state_v1';

    // Agora usamos GM_setValue/GM_getValue em vez de localStorage.
    // Diferença importante: localStorage é isolado POR SITE (cada domínio tem o seu).
    // GM_setValue/GM_getValue é isolado POR PERFIL DO NAVEGADOR (Tampermonkey guarda
    // o valor uma única vez, e todos os sites onde o script roda enxergam o mesmo estado).

    function carregarEstado() {
        try {
            const dados = JSON.parse(GM_getValue(STORAGE_KEY_STATE, '{}'));
            return (dados && typeof dados === 'object') ? dados : {};
        } catch {
            return {};
        }
    }

    function salvarEstado(estado) {
        GM_setValue(STORAGE_KEY_STATE, JSON.stringify(estado));
    }

    // Sincronização em tempo real: se o estado for alterado em outra aba/site,
    // essa aba é avisada automaticamente e atualiza o painel + liga/desliga módulos.
    if (typeof GM_addValueChangeListener === 'function') {
        GM_addValueChangeListener(STORAGE_KEY_STATE, (nome, valorAntigo, valorNovo, remoto) => {
            if (!remoto) return; // ignora a própria mudança feita nesta aba

            let novoEstado;
            try {
                novoEstado = JSON.parse(valorNovo || '{}');
            } catch {
                novoEstado = {};
            }

            modulos.forEach(mod => {
                const deveEstarLigado = (novoEstado[mod.id] !== undefined) ? novoEstado[mod.id] : mod.defaultOn;
                if (deveEstarLigado && !mod._ativo) {
                    ligarModulo(mod);
                } else if (!deveEstarLigado && mod._ativo) {
                    desligarModulo(mod);
                }
            });

            if (typeof atualizarCheckboxesDoPainel === 'function') {
                atualizarCheckboxesDoPainel();
            }
        });
    }

    // =========================================================================
    // REGISTRO DE MÓDULOS
    // =========================================================================
    // Cada módulo é um objeto: { id, name, defaultOn, init(), destroy() }
    // init()    -> liga o script (cria elementos, observers, intervals etc.)
    // destroy() -> desliga o script (remove tudo que o init() criou)
    const modulos = [];
    let atualizarCheckboxesDoPainel = null;

function registrarModulo(mod) {
    mod._ativo = false;
    modulos.push(mod);

    modulos.sort((a, b) =>
        a.name.localeCompare(b.name, "pt-BR", {
            sensitivity: "base"
        })
    );
}
    function removerModuloDoRegistro(id) {
        const idx = modulos.findIndex(m => m.id === id);
        if (idx !== -1) modulos.splice(idx, 1);
    }

    function ligarModulo(mod) {
        if (mod._ativo) return;
        try {
            mod.init();
            mod._ativo = true;
        } catch (erro) {
            console.error('[Painel de Scripts] Erro ao ligar "' + mod.name + '":', erro);
            alert('Erro ao ligar "' + mod.name + '":\n' + erro.message);
        }
    }

    function desligarModulo(mod) {
        if (!mod._ativo) return;
        try {
            mod.destroy();
        } catch (erro) {
            console.error('[Painel de Scripts] Erro ao desligar "' + mod.name + '":', erro);
        }
        mod._ativo = false;
    }

    function alternarModulo(id, ligado) {
        const mod = modulos.find(m => m.id === id);
        if (!mod) return;

        const estado = carregarEstado();
        estado[id] = ligado;
        salvarEstado(estado);

        if (ligado) {
            ligarModulo(mod);
        } else {
            desligarModulo(mod);
        }
    }

    function aplicarEstadoInicial() {
        const estado = carregarEstado();

        modulos.forEach(mod => {
            const ligado = (estado[mod.id] !== undefined) ? estado[mod.id] : mod.defaultOn;
            if (ligado) ligarModulo(mod);
        });
    }

    // =========================================================================
    // MÓDULO 1 — Botão Aplicar Desconto Dinâmico
    // =========================================================================
    function criarModuloDesconto() {
        const BOTAO_ID = 'btn-aplicar-desconto-custom';
        const TITULO_MODAL = 'Incluir códigos promocionais';
        const CODIGO = 'idaevolta10';

        let observer = null;

        function preencherCodigos() {
            let total = 0;

            document.querySelectorAll('label').forEach(label => {
                if (!label.textContent.toLowerCase().includes('código promocional')) return;

                // Procura o input dentro do mesmo bloco do label
                let bloco = label.parentElement;
                while (bloco && !bloco.querySelector('input')) {
                    bloco = bloco.parentElement;
                }
                if (!bloco) return;

                const input = bloco.querySelector('input');
                if (!input) return;

                try {
                    const setter = Object.getOwnPropertyDescriptor(
                        HTMLInputElement.prototype,
                        'value'
                    ).set;
                    setter.call(input, CODIGO);
                } catch {
                    input.value = CODIGO;
                }

                input.dispatchEvent(new Event('input', { bubbles: true }));
                input.dispatchEvent(new Event('change', { bubbles: true }));
                input.dispatchEvent(new KeyboardEvent('keyup', { bubbles: true }));
                total++;
            });

            console.log(`[Desconto] Preenchidos ${total} códigos promocionais.`);
        }

        function criarBotaoDesconto(container) {
            if (document.getElementById(BOTAO_ID)) return;

            const btn = document.createElement('button');
            btn.id = BOTAO_ID;
            btn.textContent = 'Aplicar Desconto';
            btn.style.marginTop = '10px';
            btn.style.padding = '8px 18px';
            btn.style.background = '#28a745';
            btn.style.color = '#fff';
            btn.style.border = 'none';
            btn.style.borderRadius = '5px';
            btn.style.cursor = 'pointer';
            btn.style.fontWeight = 'bold';
            btn.style.fontSize = '14px';
            btn.addEventListener('click', preencherCodigos);
            container.appendChild(btn);
        }

        function verificarEAtualizar() {
            const titulo = [...document.querySelectorAll('.h3-lightbox-title')]
                .find(el => el.textContent.trim().includes(TITULO_MODAL));

            if (titulo) {
                criarBotaoDesconto(titulo.parentElement);
            } else {
                document.getElementById(BOTAO_ID)?.remove();
            }
        }

        return {
            id: 'desconto',
            name: 'SMART BUS - Botão Aplicar Desconto Dinâmico',
            defaultOn: true,
            fixo: true, // módulo embutido no código-fonte, não pode ser excluído pelo painel

            init() {
                observer = new MutationObserver(verificarEAtualizar);
                observer.observe(document.body, { childList: true, subtree: true });
                verificarEAtualizar();
            },

            destroy() {
                if (observer) {
                    observer.disconnect();
                    observer = null;
                }
                document.getElementById(BOTAO_ID)?.remove();
            }
        };
    }

    registrarModulo(criarModuloDesconto());

    // =========================================================================
    // MÓDULO 2 — Alerta de Atraso na Fila (30 min / Tallos)
    // =========================================================================
    function criarModuloTallos() {
        // ⚙️ CONFIGURAÇÕES (EDITÁVEL PELO USUÁRIO)
        const CONFIG = {
            TEMPO_LIMITE_MINUTOS: 30, // Tempo em minutos para o alerta

            // Se quiser usar imagens próprias, cole o link abaixo (ex: "https://site.com/foto.png").
            // Deixado em branco: o script usa apenas a cor da bolinha (verde = ok, vermelho = atraso).
            URL_IMAGEM_NORMAL: "",
            URL_IMAGEM_ALERTA: ""
        };

        const TEMPO_LIMITE_MS = CONFIG.TEMPO_LIMITE_MINUTOS * 60 * 1000;

        // Lista de termos de interface a ignorar na busca por nome de cliente.
        // Antes era recriada a cada elemento candidato dentro do loop; agora existe
        // uma única vez por módulo.
        const TERMOS_IGNORAR_NOME = [
            'DASHBOARD', 'CONTATOS', 'RELATÓRIOS', 'CONFIGURAÇÕES', 'MENSAGENS',
            'SETOR', 'SETORES', 'CANAIS', 'MEUS ATENDIMENTOS', 'MAIS RECENTE',
            'BUSCAR', 'TRANSFERIR', 'ENCERRAR', 'PERFIL', 'ETIQUETAS', 'ATIVIDADES',
            'FUNIL', 'FUNIS', 'CARTEIRAS', 'HISTÓRICO', 'BUSCAR POR CONTATO',
            'INÍCIO', 'CHAT', 'AUTOMAÇÃO', 'ANALISAR', 'INVISÍVEL',
            'OPERADORES', 'FILA DE ESPERA', 'CHATBOT', 'TODOS', 'NÃO LIDAS'
        ];

        let quantidadeAtrasadosAnterior = 0;
        let styleEl = null;
        let wrapperUI = null;
        let bubbleUI = null;
        let popupUI = null;
        let listaUI = null;
        let badgeUI = null;
        let intervalId = null;
        let timeoutId = null;
        let handleBubbleClick = null;
        let handleDocumentClick = null;

        function varrerFilaLateral() {
            const todosElementos = document.querySelectorAll('*');
            const horariosEncontrados = [];
            // Pré-filtra, numa única passagem pelo DOM, os elementos que podem ser
            // "nome de cliente" (mesma faixa de posição usada depois). Antes, para
            // CADA horário encontrado, o código reescaneava todos os elementos da
            // página de novo (O(n²)) — agora esse conjunto é calculado uma vez só
            // e reaproveitado para todos os horários da mesma varredura.
            const candidatosNome = [];
            const clientesAtrasados = [];
            const agora = Date.now();

            for (let el of todosElementos) {
                if (el.children.length !== 0 || !el.offsetParent) continue;

                const rect = el.getBoundingClientRect();

                if (rect.left >= 230 && rect.left < 400 && rect.top > 80 && rect.width > 0) {
                    const txt = el.textContent.trim();
                    if (txt.length > 10) continue;
                    const match = txt.match(/^([0-2]?[0-9]):([0-5][0-9])\s*(AM|PM)?$/i);

                    if (match) {
                        horariosEncontrados.push({ el, txt, match, rect });
                    }
                } else if (rect.left > 75 && rect.left < 260) {
                    candidatosNome.push({ el, rect, txt: el.textContent.trim() });
                }
            }

            horariosEncontrados.forEach(item => {
                let hora = parseInt(item.match[1], 10);
                const min = parseInt(item.match[2], 10);
                const ampm = item.match[3] ? item.match[3].toUpperCase() : null;

                if (ampm) {
                    if (ampm === 'PM' && hora < 12) hora += 12;
                    if (ampm === 'AM' && hora === 12) hora = 0;
                }

                const dataReal = new Date();
                dataReal.setHours(hora, min, 0, 0);

                if (dataReal.getTime() > agora) {
                    dataReal.setDate(dataReal.getDate() - 1);
                }

                const tempoDecorrido = agora - dataReal.getTime();

                if (tempoDecorrido >= TEMPO_LIMITE_MS) {
                    let nomeDoCliente = "Cliente Oculto";
                    let elementoFisicoOriginal = null;
                    let menorDistanciaX = 999;

                    for (let cand of candidatosNome) {
                        if (cand.el === item.el) continue;
                        if (Math.abs(cand.rect.top - item.rect.top) >= 25) continue;

                        const txtNome = cand.txt;
                        const txtNomeUpper = txtNome.toUpperCase();

                        const isTermoProibido = TERMOS_IGNORAR_NOME.some(
                            termo => txtNomeUpper === termo || txtNomeUpper.includes(termo)
                        );

                        if (txtNome.length > 2 && !txtNome.match(/\d{2}:\d{2}/) && !isTermoProibido) {
                            if (cand.rect.left < menorDistanciaX) {
                                menorDistanciaX = cand.rect.left;
                                nomeDoCliente = txtNome;
                                elementoFisicoOriginal = cand.el;
                            }
                        }
                    }

                    const tempoAbsoluto = Math.abs(tempoDecorrido);
                    const horas = Math.floor(tempoAbsoluto / 3600000);
                    const minutos = Math.floor((tempoAbsoluto % 3600000) / 60000);
                    let tempoTexto = horas > 0 ? `${horas}h ${minutos}m` : `${minutos} min`;

                    if (nomeDoCliente !== "Cliente Oculto") {
                        clientesAtrasados.push({
                            nome: nomeDoCliente,
                            atraso: tempoTexto,
                            elementoAlvo: elementoFisicoOriginal
                        });
                    }
                }
            });

            listaUI.innerHTML = '';

            if (clientesAtrasados.length > 0) {
                const clientesUnicos = [...new Map(clientesAtrasados.map(c => [c.nome, c])).values()];
                const quantidadeAtual = clientesUnicos.length;

                quantidadeAtrasadosAnterior = quantidadeAtual;

                clientesUnicos.forEach(cliente => {
                    const li = document.createElement('li');
                    li.className = 'tallos-client-item';
                    li.innerHTML = `
                        <span class="tallos-client-name" title="${cliente.nome}">${cliente.nome}</span>
                        <span class="tallos-client-time">${cliente.atraso}</span>
                    `;

                    li.addEventListener('click', () => {
                        if (cliente.elementoAlvo) {
                            cliente.elementoAlvo.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            cliente.elementoAlvo.click();
                            popupUI.classList.remove('show');
                        }
                    });

                    listaUI.appendChild(li);
                });

                bubbleUI.classList.add('has-alerts');
                badgeUI.innerText = quantidadeAtual;

            } else {
                bubbleUI.classList.remove('has-alerts');
                popupUI.classList.remove('show');
                quantidadeAtrasadosAnterior = 0;
            }
        }

        return {
            id: 'tallos_30min',
            name: 'TALLOS - Alerta de 30 min',
            defaultOn: true,
            fixo: true, // módulo embutido no código-fonte, não pode ser excluído pelo painel

            init() {
                // este widget só faz sentido dentro do Tallos — em qualquer outro
                // site o toggle liga "no papel", mas não desenha nada na tela
                if (!location.hostname.includes('tallos.com.br')) return;

                styleEl = document.createElement('style');
                styleEl.innerHTML = `
                    #tallos-widget-wrapper {
                        position: fixed;
                        right: 464px;
                        top: 8px;
                        z-index: 1;
                        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                    }

                    .tallos-bubble {
                        width: 45px;
                        height: 45px;
                        background: linear-gradient(150deg, #2ee69a, #10b981);
                        border-radius: 50%;
                        display: flex;
                        justify-content: center;
                        align-items: center;
                        color: #14211b;
                        cursor: pointer;
                        user-select: none;
                        position: relative;
                    }
                    .tallos-bubble:hover {
                        transform: translateY(-2px) scale(1.05);
                    }
                    .tallos-bubble:active { transform: scale(0.95); }

                    .tallos-bubble.has-alerts {
                        background: linear-gradient(150deg, #ff6b6b, #ef4444);
                        color: #241414;
                        animation: tallosPulseBubble 2s infinite;
                    }

                    @keyframes tallosPulseBubble {
                        0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.5); }
                        70% { box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
                        100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
                    }

                    .tallos-custom-img {
                        width: 100%;
                        height: 100%;
                        object-fit: cover;
                        border-radius: 50%;
                        pointer-events: none;
                    }

                    .tallos-badge {
                        position: absolute;
                        top: -2px;
                        right: -2px;
                        background: #232025;
                        color: #ff6a1f;
                        font-size: 12px;
                        font-weight: 800;
                        width: 22px;
                        height: 22px;
                        border-radius: 50%;
                        display: flex;
                        justify-content: center;
                        align-items: center;
                        border: 1.5px solid rgba(255, 106, 31, 0.4);
                        opacity: 0;
                        transform: scale(0);
                        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
                        z-index: 2;
                    }
                    .tallos-bubble.has-alerts .tallos-badge {
                        opacity: 1;
                        transform: scale(1);
                    }

                    .tallos-popup-menu {
                        position: absolute;
