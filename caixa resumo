    function tornarArrastavel(elemento, handle) {
        let movendo = false;
        let offsetX = 0;
        let offsetY = 0;

        handle.style.cursor = "move";

        handle.addEventListener("mousedown", function (e) {
            // Não arrasta quando clicar nos botões
            if (e.target.tagName === "BUTTON") return;

            movendo = true;

            const rect = elemento.getBoundingClientRect();

            offsetX = e.clientX - rect.left;
            offsetY = e.clientY - rect.top;

            elemento.style.left = rect.left + "px";
            elemento.style.top = rect.top + "px";
            elemento.style.right = "auto";

            document.body.style.userSelect = "none";
        });

        document.addEventListener("mousemove", function (e) {
            if (!movendo) return;

            elemento.style.left = (e.clientX - offsetX) + "px";
            elemento.style.top = (e.clientY - offsetY) + "px";
        });

        document.addEventListener("mouseup", function () {
            movendo = false;
            document.body.style.userSelect = "";
        });
    }

