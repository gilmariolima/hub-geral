// ==UserScript==
// @name         Somar Venda Líquida por Funcionário
// @namespace    http://tampermonkey.net/
// @version      1.0.1
// @description  Soma venda líquida por funcionário, separa por turno manhã/noite e mostra diferença
// @author       Gilvan
// @match        *://*/*
// @grant        none
// @run-at       document-idle
// ==/UserScript==

(function () {
    'use strict';

    const noite = [
        "Gilmario lima",
        "Nicole Silveira",
        "Guilherme Moura",
        "Marcelo Santos",
        "Aline Simplicio",
        "Marcus Luan",
        "Cayo Mendes",
        "Felipe Honorato",
        "Aline Silva"
    ];

    const manha = [
        "Pedro Santos",
        "Lucas Sombra",
        "Bruno Amancio",
        "Andre Lucas",
        "Daniel Lima",
        "Kaio Leão",
        "Uelisson Torres",
        "Joao Pedro",
        "Manoel William"
    ];

    const ID_PAINEL = "painel-venda-liquida-funcionarios";

    function normalizarTexto(txt) {
        return String(txt || "")
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/\s+/g, " ")
            .trim()
            .toLowerCase();
    }

    function formatarMoeda(valor) {
        return valor.toLocaleString("pt-BR", {
            style: "currency",
            currency: "BRL"
        });
    }

    function parseMoedaBR(texto) {
        if (!texto) return 0;

        let limpo = String(texto)
            .replace(/BRL/gi, "")
            .replace(/R\$/gi, "")
            .replace(/\s+/g, "")
            .trim();

        const negativo = limpo.includes("-");

        limpo = limpo
            .replace(/-/g, "")
            .replace(/\./g, "")
            .replace(",", ".");

        const numero = parseFloat(limpo);

        if (isNaN(numero)) return 0;

        return negativo ? -numero : numero;
    }

    function encontrarTabela() {
        const tabelas = [...document.querySelectorAll("table")];

        for (const tabela of tabelas) {
            const texto = normalizarTexto(tabela.innerText);

            if (
                texto.includes("usuario") &&
                texto.includes("venda liquida")
            ) {
                return tabela;
            }
        }

        return null;
    }

    function encontrarIndiceColuna(tabela, nomesPossiveis) {
        const ths = [...tabela.querySelectorAll("thead th")];

        for (let i = 0; i < ths.length; i++) {
            const texto = normalizarTexto(ths[i].innerText);

            if (nomesPossiveis.some(nome => texto.includes(normalizarTexto(nome)))) {
                return i;
            }
        }

        const primeiraLinha = tabela.querySelector("tr");
        if (!primeiraLinha) return -1;

        const celulas = [...primeiraLinha.children];

        for (let i = 0; i < celulas.length; i++) {
            const texto = normalizarTexto(celulas[i].innerText);

            if (nomesPossiveis.some(nome => texto.includes(normalizarTexto(nome)))) {
                return i;
            }
        }

        return -1;
    }

    function obterLinhasTabela(tabela) {
        let linhas = [...tabela.querySelectorAll("tbody tr")];

        if (!linhas.length) {
            linhas = [...tabela.querySelectorAll("tr")].slice(1);
        }

        return linhas.filter(linha => {
            const texto = normalizarTexto(linha.innerText);
            return texto && !texto.includes("usuario venda liquida");
        });
    }

    function criarMapaTurno(lista) {
        const mapa = new Map();

        lista.forEach(nome => {
            mapa.set(normalizarTexto(nome), nome);
        });

        return mapa;
    }

    function calcular() {
        const tabela = encontrarTabela();

        if (!tabela) {
            alert("Não encontrei uma tabela com as colunas USUÁRIO e VENDA LÍQUIDA.");
            return;
        }

        const indiceUsuario = encontrarIndiceColuna(tabela, ["Usuário", "Usuario"]);
        const indiceVendaLiquida = encontrarIndiceColuna(tabela, ["Venda Líquida", "Venda Liquida"]);

        if (indiceUsuario === -1 || indiceVendaLiquida === -1) {
            alert("Não consegui identificar as colunas USUÁRIO e VENDA LÍQUIDA.");
            return;
        }

        const mapaManha = criarMapaTurno(manha);
        const mapaNoite = criarMapaTurno(noite);

        const totais = {};
        const linhas = obterLinhasTabela(tabela);

        linhas.forEach(linha => {
            const celulas = [...linha.children];

            if (!celulas[indiceUsuario] || !celulas[indiceVendaLiquida]) return;

            const usuarioOriginal = celulas[indiceUsuario].innerText.trim();
            const usuarioKey = normalizarTexto(usuarioOriginal);

            const vendaLiquidaTexto = celulas[indiceVendaLiquida].innerText.trim();
            const valor = parseMoedaBR(vendaLiquidaTexto);

            if (!totais[usuarioKey]) {
                totais[usuarioKey] = {
                    nome: usuarioOriginal,
                    total: 0,
                    turno: "Sem turno"
                };
            }

            totais[usuarioKey].total += valor;

            if (mapaManha.has(usuarioKey)) {
                totais[usuarioKey].turno = "Manhã";
                totais[usuarioKey].nome = mapaManha.get(usuarioKey);
            } else if (mapaNoite.has(usuarioKey)) {
                totais[usuarioKey].turno = "Noite";
                totais[usuarioKey].nome = mapaNoite.get(usuarioKey);
            }
        });

        renderizarPainel(totais);
    }

    function ordenarPorValor(lista) {
        return lista.sort((a, b) => b.total - a.total);
    }

    function montarBlocoTitulo(titulo, total, quantidade) {
        return `
            <div class="vl-turno-titulo">
                <div>
                    <strong>${titulo}</strong>
                    <span>${quantidade} funcionário(s)</span>
                </div>
                <b>${formatarMoeda(total)}</b>
            </div>
        `;
    }

    function montarTabelaFuncionarios(lista) {
        if (!lista.length) {
            return `<div class="vl-vazio">Nenhum funcionário encontrado.</div>`;
        }

        return `
            <table class="vl-tabela">
                <thead>
                    <tr>
                        <th>Funcionário</th>
                        <th>Venda Líquida</th>
                    </tr>
                </thead>
                <tbody>
                    ${lista.map(item => `
                        <tr>
                            <td>${item.nome}</td>
                            <td>${formatarMoeda(item.total)}</td>
                        </tr>
                    `).join("")}
                </tbody>
            </table>
        `;
    }

    function renderizarPainel(totais) {
        const antigo = document.getElementById(ID_PAINEL);
        if (antigo) antigo.remove();

        const lista = Object.values(totais);

        const listaManha = ordenarPorValor(lista.filter(item => item.turno === "Manhã"));
        const listaNoite = ordenarPorValor(lista.filter(item => item.turno === "Noite"));
        const listaSemTurno = ordenarPorValor(lista.filter(item => item.turno === "Sem turno"));

        const totalManha = listaManha.reduce((acc, item) => acc + item.total, 0);
        const totalNoite = listaNoite.reduce((acc, item) => acc + item.total, 0);
        const totalSemTurno = listaSemTurno.reduce((acc, item) => acc + item.total, 0);
        const totalGeral = totalManha + totalNoite + totalSemTurno;

        const diferencaNoiteManha = totalNoite - totalManha;

        let textoDiferenca = "";

        if (diferencaNoiteManha > 0) {
            textoDiferenca = `Noite está ${formatarMoeda(diferencaNoiteManha)} acima da Manhã`;
        } else if (diferencaNoiteManha < 0) {
            textoDiferenca = `Manhã está ${formatarMoeda(Math.abs(diferencaNoiteManha))} acima da Noite`;
        } else {
            textoDiferenca = "Manhã e Noite estão empatadas";
        }

        const painel = document.createElement("div");
        painel.id = ID_PAINEL;

        painel.innerHTML = `
            <div class="vl-header">
                <div>
                    <strong>Venda Líquida</strong>
                    <span>Resumo por funcionário</span>
                </div>

                <div class="vl-acoes">
                    <button id="vl-atualizar">Atualizar</button>
                    <button id="vl-fechar">×</button>
                </div>
            </div>

            <div class="vl-total-geral">
                <span>Total geral</span>
                <strong>${formatarMoeda(totalGeral)}</strong>
            </div>

            <div class="vl-diferenca ${diferencaNoiteManha >= 0 ? "positivo" : "negativo"}">
                <div>
                    <span>Diferença Noite - Manhã</span>
                    <small>${textoDiferenca}</small>
                </div>
                <strong>${formatarMoeda(diferencaNoiteManha)}</strong>
            </div>

            <div class="vl-bloco">
                ${montarBlocoTitulo("Manhã", totalManha, listaManha.length)}
                ${montarTabelaFuncionarios(listaManha)}
            </div>

            <div class="vl-bloco">
                ${montarBlocoTitulo("Noite", totalNoite, listaNoite.length)}
                ${montarTabelaFuncionarios(listaNoite)}
            </div>

            ${listaSemTurno.length ? `
                <div class="vl-bloco">
                    ${montarBlocoTitulo("Sem turno", totalSemTurno, listaSemTurno.length)}
                    ${montarTabelaFuncionarios(listaSemTurno)}
                </div>
            ` : ""}
        `;

        document.body.appendChild(painel);

        tornarArrastavel(
            painel,
            painel.querySelector(".vl-header")
        );

        document.getElementById("vl-fechar").onclick = () => painel.remove();
        document.getElementById("vl-atualizar").onclick = calcular;
    }

    function criarBotaoFlutuante() {
        if (document.getElementById("btn-somar-venda-liquida")) return;

        const botao = document.createElement("button");
        botao.id = "btn-somar-venda-liquida";
        botao.textContent = "Somar Venda Líquida";

        botao.onclick = calcular;

        document.body.appendChild(botao);
    }

